=\"#m067_g10-60\" y=\"-59.987571\"></use><use x=\"120.988003\" xlink:href=\"#m067_g4-14\" y=\"-59.987571\"></use><use x=\"128.40236\" xlink:href=\"#m067_g10-113\" y=\"-59.987571\"></use><use x=\"134.771983\" xlink:href=\"#m067_g7-92\" y=\"-58.49319\"></use><use x=\"139.55011\" xlink:href=\"#m067_g4-186\" y=\"-60.002514\"></use><use x=\"145.579605\" xlink:href=\"#m067_g4-184\" y=\"-59.987571\"></use><use x=\"154.000197\" xlink:href=\"#m067_g10-95\" y=\"-59.987571\"></use><use x=\"160.012644\" xlink:href=\"#m067_g4-107\" y=\"-59.987571\"></use><use x=\"164.595459\" xlink:href=\"#m067_g4-114\" y=\"-59.987571\"></use><use x=\"171.280375\" xlink:href=\"#m067_g10-68\" y=\"-59.987571\"></use><use x=\"177.29134\" xlink:href=\"#m067_g7-92\" y=\"-58.49319\"></use><use x=\"182.567601\" xlink:href=\"#m067_g4-107\" y=\"-59.987571\"></use><use x=\"187.050787\" xlink:href=\"#m067_g14-50\" y=\"-64.102131\"></use><use x=\"187.050787\" xlink:href=\"#m067_g14-50\" y=\"-56.961428\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">经典 deformable registration 每对病例都需迭代优化，速度慢</p><p class=\"cell-val cell-val-en lang-en\">Classical iterative deformable registration (ANTs/SyN, Elastix) optimized every image pair from scratch, taking minutes to hours on CPU.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">3D U-Net 接收固定/移动图像并一次 forward 预测 dense displacement</p><p class=\"cell-val cell-val-en lang-en\">Train a 3D convolutional U-Net over a population of scans to predict the dense deformation field in sub-second GPU inference without ground-truth warps.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">以图像相似度加平滑正则做无监督 amortized registration</p><p class=\"cell-val cell-val-en lang-en\">Amortized U-Net displacement/velocity prediction + Spatial Transformer warping + unsupervised LNCC/MSE + anatomical segmentation Dice auxiliary loss.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">成为 CT/MRI 快速配准最常用的学习式基线</p><p class=\"cell-val cell-val-en lang-en\">Foundational fast learning-based baseline for brain MRI, chest CT inspiration–expiration, and longitudinal registration.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">基础设施级 baseline；跨域、相似度选择和 folding 仍是问题</p><p class=\"cell-val cell-val-en lang-en\">Core registration infrastructure; simple gradient smoothing does not strictly prevent topological folding (|J_φ| ≤ 0) under large deformations.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">用训练集学习从图像对到形变场的映射，把逐病例优化摊销为一次网络前向。</li><li class=\"lang-zh\">相似度损失提供无配准标签监督，可微 warper 把误差传回位移预测。</li><li class=\"lang-zh\">平滑正则只鼓励局部平滑；基础版本不严格保证微分同胚或逆一致。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Train a 3D convolutional U-Net over a population of scans to predict the dense deformation field in sub-second GPU inference without ground-truth warps.</li><li class=\"lang-en bullet-en\">Architectural Delta: Amortized U-Net displacement/velocity prediction + Spatial Transformer warping + unsupervised LNCC/MSE + anatomical segmentation Dice auxiliary loss.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Unsupervised Amortized Deformation Prediction: L_sim(f, m ∘ φ) + λ ||∇u||².</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合 CT/MRI 大批量快速 deformable registration，并作为学习式配准的通用基线。</li><li class=\"lang-zh\">跨模态强度不对应、切除/肿瘤变化和域移位会误导相似度；需报告 folding/Jacobian 与病理保持。</li><li class=\"lang-en bullet-en\">Clinical Translation: Foundational fast learning-based baseline for brain MRI, chest CT inspiration–expiration, and longitudinal registration.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Core registration infrastructure; simple gradient smoothing does not strictly prevent topological folding (|J_φ| ≤ 0) under large deformations.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://pubmed.ncbi.nlm.nih.gov/30716034/\" rel=\"noreferrer\" target=\"_blank\">\n<span>VoxelMorph: A Learning Framework for Deformable Medical Image Registration</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/voxelmorph/voxelmorph\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
