\"-30.229597\" xlink:href=\"#m087_g7-62\" y=\"-64.973862\"></use><use x=\"-24.035225\" xlink:href=\"#m087_g16-100\" y=\"-60.859302\"></use><use x=\"-18.117427\" xlink:href=\"#m087_g10-185\" y=\"-60.859302\"></use><use x=\"-14.660396\" xlink:href=\"#m087_g16-44\" y=\"-60.859302\"></use><use x=\"-5.925148\" xlink:href=\"#m087_g13-71\" y=\"-59.364921\"></use><use x=\"-1.372487\" xlink:href=\"#m087_g16-71\" y=\"-60.859302\"></use><use x=\"3.349804\" xlink:href=\"#m087_g13-56\" y=\"-59.364921\"></use><use x=\"8.683608\" xlink:href=\"#m087_g10-184\" y=\"-60.859302\"></use><use x=\"16.974681\" xlink:href=\"#m087_g16-44\" y=\"-60.859302\"></use><use x=\"25.346291\" xlink:href=\"#m087_g13-54\" y=\"-59.364921\"></use><use x=\"30.220539\" xlink:href=\"#m087_g16-54\" y=\"-60.859302\"></use><use x=\"35.301488\" xlink:href=\"#m087_g13-56\" y=\"-59.364921\"></use><use x=\"40.635292\" xlink:href=\"#m087_g10-184\" y=\"-60.859302\"></use><use x=\"49.424499\" xlink:href=\"#m087_g16-49\" y=\"-60.859302\"></use><use x=\"54.774433\" xlink:href=\"#m087_g10-186\" y=\"-60.859302\"></use><use x=\"60.803975\" xlink:href=\"#m087_g10-184\" y=\"-60.859302\"></use><use x=\"69.593182\" xlink:href=\"#m087_g16-49\" y=\"-60.859302\"></use><use x=\"75.452206\" xlink:href=\"#m087_g13-107\" y=\"-59.364921\"></use><use x=\"81.3423\" xlink:href=\"#m087_g4-1\" y=\"-68.453307\"></use><use x=\"86.718606\" xlink:href=\"#m087_g16-150\" y=\"-60.859302\"></use><use x=\"102.144857\" xlink:href=\"#m087_g20-94\" y=\"-60.859302\"></use><use x=\"100.94188\" xlink:href=\"#m087_g16-71\" y=\"-60.859302\"></use><use x=\"105.664171\" xlink:href=\"#m087_g13-56\" y=\"-59.364921\"></use><use x=\"111.551432\" xlink:href=\"#m087_g1-61\" y=\"-60.859302\"></use><use x=\"120.724738\" xlink:href=\"#m087_g16-85\" y=\"-60.859302\"></use><use x=\"126.632588\" xlink:href=\"#m087_g13-56\" y=\"-59.364921\"></use><use x=\"131.412925\" xlink:href=\"#m087_g16-71\" y=\"-60.859302\"></use><use x=\"136.135216\" xlink:href=\"#m087_g13-56\" y=\"-59.364921\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">U-Net 跳连把大量背景细节无差别传给 decoder，小器官易被淹没</p><p class=\"cell-val cell-val-en lang-en\">Unfiltered U-Net skip connections pass cluttered background activations to the decoder, degrading small-organ false-positive rates.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">用 decoder gating 信号对 skip 特征做空间注意力筛选</p><p class=\"cell-val cell-val-en lang-en\">Gate high-resolution encoder skip features spatially using contextual gating signals from the coarser decoder stage.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">在不额外裁剪 ROI 的情况下突出与目标相关的局部区域</p><p class=\"cell-val cell-val-en lang-en\">Lightweight additive attention gates suppress irrelevant background regions without requiring explicit two-stage ROI localization.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">广泛用于小器官和病灶分割以及级联定位</p><p class=\"cell-val cell-val-en lang-en\">Frequently integrated into pancreas, small-lesion, and multi-organ segmentation networks.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">注意力门控仍实用；提升通常依赖数据、损失和基线配置</p><p class=\"cell-val cell-val-en lang-en\">Practical and lightweight spatial gating module, though improvements depend heavily on loss and pipeline setup.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">用深层 decoder 语义作为 gating signal，决定浅层 skip 中哪些空间位置值得传递。</li><li class=\"lang-zh\">attention gate 位于 skip connection 上，不替代 encoder-decoder 主干或全局 self-attention。</li><li class=\"lang-zh\">软门可端到端学习，无需额外 ROI 裁剪标签，但注意力图仍由分割损失间接监督。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Gate high-resolution encoder skip features spatially using contextual gating signals from the coarser decoder stage.</li><li class=\"lang-en bullet-en\">Architectural Delta: Lightweight additive attention gates suppress irrelevant background regions without requiring explicit two-stage ROI localization.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Additive Decoder-Conditioned Spatial Attention Gate.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合小器官和小病灶场景，可减少背景 skip feature 对 decoder 的干扰。</li><li class=\"lang-zh\">提升高度依赖数据、损失和基线；若 gate 过早抑制弱病灶，decoder 无法从被删除的细节恢复。</li><li class=\"lang-en bullet-en\">Clinical Translation: Frequently integrated into pancreas, small-lesion, and multi-organ segmentation networks.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Practical and lightweight spatial gating module, though improvements depend heavily on loss and pipeline setup.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openreview.net/pdf?id=Skft7cijM\" rel=\"noreferrer\" target=\"_blank\">\n<span>Attention U-Net: Learning Where to Look for the Pancreas</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/ozan-oktay/Attention-Gated-Networks\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
