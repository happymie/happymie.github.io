1994\" xlink:href=\"#m118_g19-71\" y=\"-59.987571\"></use><use x=\"-35.549047\" xlink:href=\"#m118_g16-67\" y=\"-64.102131\"></use><use x=\"-29.891614\" xlink:href=\"#m118_g10-0\" y=\"-59.987571\"></use><use x=\"-20.444873\" xlink:href=\"#m118_g4-2\" y=\"-68.107101\"></use><use x=\"-17.05758\" xlink:href=\"#m118_g19-95\" y=\"-59.987571\"></use><use x=\"-11.442142\" xlink:href=\"#m118_g16-67\" y=\"-58.49319\"></use><use x=\"-7.251379\" xlink:href=\"#m118_g19-22\" y=\"-59.987571\"></use><use x=\"-1.034704\" xlink:href=\"#m118_g7-62\" y=\"-64.102131\"></use><use x=\"5.139745\" xlink:href=\"#m118_g10-185\" y=\"-59.987571\"></use><use x=\"9.603002\" xlink:href=\"#m118_g19-22\" y=\"-59.987571\"></use><use x=\"15.819678\" xlink:href=\"#m118_g19-71\" y=\"-59.987571\"></use><use x=\"20.762625\" xlink:href=\"#m118_g16-67\" y=\"-64.102131\"></use><use x=\"26.420057\" xlink:href=\"#m118_g10-0\" y=\"-59.987571\"></use><use x=\"35.368665\" xlink:href=\"#m118_g19-72\" y=\"-59.987571\"></use><use x=\"40.170655\" xlink:href=\"#m118_g10-186\" y=\"-59.987571\"></use><use x=\"46.200197\" xlink:href=\"#m118_g10-184\" y=\"-59.987571\"></use><use x=\"55.178694\" xlink:href=\"#m118_g19-39\" y=\"-59.987571\"></use><use x=\"62.056399\" xlink:href=\"#m118_g16-92\" y=\"-58.49319\"></use><use x=\"65.654708\" xlink:href=\"#m118_g13-67\" y=\"-57.402295\"></use><use x=\"69.576489\" xlink:href=\"#m118_g10-185\" y=\"-59.987571\"></use><use x=\"73.292549\" xlink:href=\"#m118_g19-71\" y=\"-59.987571\"></use><use x=\"78.235496\" xlink:href=\"#m118_g16-67\" y=\"-64.102131\"></use><use x=\"81.679063\" xlink:href=\"#m118_g10-186\" y=\"-59.987571\"></use><use x=\"85.693996\" xlink:href=\"#m118_g4-3\" y=\"-68.107101\"></use><use x=\"91.568434\" xlink:href=\"#m118_g19-150\" y=\"-59.987571\"></use><use x=\"105.75186\" xlink:href=\"#m118_g19-67\" y=\"-59.987571\"></use><use x=\"111.866635\" xlink:href=\"#m118_g1-61\" y=\"-59.987571\"></use><use x=\"120.970203\" xlink:href=\"#m118_g26-48\" y=\"-59.987571\"></use><use x=\"125.951523\" xlink:href=\"#m118_g19-150\" y=\"-59.987571\"></use><use x=\"130.371557\" xlink:href=\"#m118_g19-149\" y=\"-59.987571\"></use><use x=\"134.851384\" xlink:href=\"#m118_g19-149\" y=\"-59.987571\"></use><use x=\"139.331211\" xlink:href=\"#m118_g19-149\" y=\"-59.987571\"></use><use x=\"143.651597\" xlink:href=\"#m118_g19-150\" y=\"-59.987571\"></use><use x=\"147.56354\" xlink:href=\"#m118_g19-41\" y=\"-59.987571\"></use><use x=\"156.273042\" xlink:href=\"#m118_g10-0\" y=\"-59.987571\"></use><use x=\"164.823144\" xlink:href=\"#m118_g26-49\" y=\"-59.987571\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">FBP 后处理忽略投影域一致性，传统迭代正则设计耗时且手工</p><p class=\"cell-val cell-val-en lang-en\">Post-processing FBP ignored sinogram data consistency, while classical Fields-of-Experts required slow iterative convergence.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">把 CT 数据保真梯度和学习到的正则梯度交替展开为固定阶段网络</p><p class=\"cell-val cell-val-en lang-en\">Unfold a fixed number of gradient descent steps on a variational CT objective, replacing hand-crafted regularizer gradients with stage-specific 3-layer CNNs.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">显式嵌入系统矩阵并学习每阶段正则更新，实现端到端 sparse-view CT</p><p class=\"cell-val cell-val-en lang-en\">Direct integration of CT projection/backprojection operators into an end-to-end trainable unrolled residual cascade.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">是 CT model-based deep learning 和 unrolling 的早期代表</p><p class=\"cell-val cell-val-en lang-en\">Early foundational milestone for model-based deep learning in sparse-view and low-dose CT reconstruction.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">仍具方法论价值；固定几何和训练分布限制跨扫描器泛化</p><p class=\"cell-val cell-val-en lang-en\">Methodologically important unrolled CT baseline; fixed system matrices and stage-specific parameters require significant memory.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">把 fields-of-experts 迭代固定展开为有限深度网络。</li><li class=\"lang-zh\">每阶段显式包含 Aᵀ(Ax−y)，保留 CT 系统矩阵的数据保真梯度。</li><li class=\"lang-zh\">正则梯度由阶段特异 CNN 学习，而非整条迭代共享一组固定先验参数。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Unfold a fixed number of gradient descent steps on a variational CT objective, replacing hand-crafted regularizer gradients with stage-specific 3-layer CNNs.</li><li class=\"lang-en bullet-en\">Architectural Delta: Direct integration of CT projection/backprojection operators into an end-to-end trainable unrolled residual cascade.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Unrolled Iterative CT Gradient Descent with Stage-Specific Learned Expert Regularizers.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">是 sparse-view CT 中 model-based deep learning 与 algorithm unrolling 的早期代表。</li><li class=\"lang-zh\">若几何、标定或噪声与训练 A 不一致，显式算子也会把错误物理约束反复注入重建。</li><li class=\"lang-en bullet-en\">Clinical Translation: Early foundational milestone for model-based deep learning in sparse-view and low-dose CT reconstruction.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Methodologically important unrolled CT baseline; fixed system matrices and stage-specific parameters require significant memory.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://pmc.ncbi.nlm.nih.gov/articles/PMC6019143/\" rel=\"noreferrer\" target=\"_blank\">\n<span>LEARN: Learned Experts' Assessment-Based Reconstruction Network for Sparse-Data CT</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<span class=\"spec-muted-val\"><span class=\"lang-zh\">未提供官方实现</span><span class=\"lang-en\">No Official Repository</span></span>\n</div>\n</footer>\n</div>"}