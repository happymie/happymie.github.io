59302\"></use><use x=\"3.593688\" xlink:href=\"#m086_g13-56\" y=\"-59.364921\"></use><use x=\"6.360955\" xlink:href=\"#m086_g13-150\" y=\"-59.364921\"></use><use x=\"8.666406\" xlink:href=\"#m086_g20-49\" y=\"-59.364921\"></use><use x=\"12.800891\" xlink:href=\"#m086_g16-150\" y=\"-60.859302\"></use><use x=\"17.220925\" xlink:href=\"#m086_g16-149\" y=\"-60.859302\"></use><use x=\"21.700751\" xlink:href=\"#m086_g16-149\" y=\"-60.859302\"></use><use x=\"26.180578\" xlink:href=\"#m086_g16-149\" y=\"-60.859302\"></use><use x=\"30.500964\" xlink:href=\"#m086_g16-150\" y=\"-60.859302\"></use><use x=\"35.309547\" xlink:href=\"#m086_g16-45\" y=\"-60.859302\"></use><use x=\"41.39672\" xlink:href=\"#m086_g13-56\" y=\"-59.364921\"></use><use x=\"44.163988\" xlink:href=\"#m086_g13-150\" y=\"-59.364921\"></use><use x=\"47.560345\" xlink:href=\"#m086_g13-57\" y=\"-59.364921\"></use><use x=\"50.607615\" xlink:href=\"#m086_g7-0\" y=\"-59.364921\"></use><use x=\"55.52397\" xlink:href=\"#m086_g20-49\" y=\"-59.364921\"></use><use x=\"59.658454\" xlink:href=\"#m086_g16-150\" y=\"-60.859302\"></use><use x=\"63.919088\" xlink:href=\"#m086_g23-85\" y=\"-60.859302\"></use><use x=\"70.813233\" xlink:href=\"#m086_g23-112\" y=\"-60.859302\"></use><use x=\"76.292687\" xlink:href=\"#m086_g10-185\" y=\"-60.859302\"></use><use x=\"80.556696\" xlink:href=\"#m086_g16-45\" y=\"-60.859302\"></use><use x=\"86.64387\" xlink:href=\"#m086_g13-56\" y=\"-59.364921\"></use><use x=\"89.265679\" xlink:href=\"#m086_g7-184\" y=\"-59.364921\"></use><use x=\"93.891133\" xlink:href=\"#m086_g20-49\" y=\"-59.364921\"></use><use x=\"97.672956\" xlink:href=\"#m086_g13-150\" y=\"-59.364921\"></use><use x=\"101.069314\" xlink:href=\"#m086_g13-57\" y=\"-59.364921\"></use><use x=\"104.116583\" xlink:href=\"#m086_g7-0\" y=\"-59.364921\"></use><use x=\"109.032939\" xlink:href=\"#m086_g20-49\" y=\"-59.364921\"></use><use x=\"113.167408\" xlink:href=\"#m086_g10-186\" y=\"-60.859302\"></use><use x=\"116.983084\" xlink:href=\"#m086_g10-188\" y=\"-60.859302\"></use><use x=\"121.097655\" xlink:href=\"#m086_g4-1\" y=\"-68.453307\"></use><use x=\"126.474069\" xlink:href=\"#m086_g16-150\" y=\"-60.859302\"></use><use x=\"142.002445\" xlink:href=\"#m086_g16-57\" y=\"-60.859302\"></use><use x=\"148.475869\" xlink:href=\"#m086_g10-21\" y=\"-60.859302\"></use><use x=\"157.579438\" xlink:href=\"#m086_g23-49\" y=\"-60.859302\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">原始 U-Net 直接拼接低层与高层特征，语义不匹配且多尺度融合粗糙</p><p class=\"cell-val cell-val-en lang-en\">Standard U-Net directly concatenates raw shallow encoder features with high-level decoder features across a large semantic gap.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">以嵌套稠密跳连和深监督逐步缩小 encoder 与 decoder 特征语义差距</p><p class=\"cell-val cell-val-en lang-en\">Bridge the encoder–decoder semantic gap via dense intermediate convolutional skip pathways and multi-scale deep supervision.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">在跳连路径中引入中间卷积节点并支持可剪枝的多深度输出</p><p class=\"cell-val cell-val-en lang-en\">Nested dense skip nodes X_{i,j} progressively fuse multi-scale features and support inference-time model pruning.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">常用于器官、息肉、细胞和小病灶分割</p><p class=\"cell-val cell-val-en lang-en\">Widely used in polyp, nuclei, liver, and small-lesion medical segmentation studies.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">医学分割经典变体；复杂跳连的增益需与 nnU-Net 等强基线公平比较</p><p class=\"cell-val cell-val-en lang-en\">Classic U-Net skip variant; practical gains must always be verified against a properly configured nnU-Net baseline.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">不是只在 encoder 与 decoder 之间接一条长跳连，而是在跳连路径上加入逐级卷积节点。</li><li class=\"lang-zh\">同尺度 dense concatenation 让浅特征逐步被深语义加工后再进入 decoder。</li><li class=\"lang-zh\">深监督训练多个有效深度，可在推理时做多头平均或按速度要求剪枝。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Bridge the encoder–decoder semantic gap via dense intermediate convolutional skip pathways and multi-scale deep supervision.</li><li class=\"lang-en bullet-en\">Architectural Delta: Nested dense skip nodes X_{i,j} progressively fuse multi-scale features and support inference-time model pruning.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: U-Net++ Nested Dense Skip Node Update Equation.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">常用于器官、息肉、细胞和小病灶分割，尤其适合需要多尺度边界融合的任务。</li><li class=\"lang-zh\">嵌套节点显著增加 activation memory；收益应与 nnU-Net 等强配置在同数据划分和训练预算下比较。</li><li class=\"lang-en bullet-en\">Clinical Translation: Widely used in polyp, nuclei, liver, and small-lesion medical segmentation studies.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Classic U-Net skip variant; practical gains must always be verified against a properly configured nnU-Net baseline.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://doi.org/10.1109/TMI.2019.2959609\" rel=\"noreferrer\" target=\"_blank\">\n<span>UNet++: Redesigning Skip Connections to Exploit Multiscale Features in Image Segmentation</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/MrGiovanni/UNetPlusPlus\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}