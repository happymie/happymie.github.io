128_g13-185\" y=\"-57.444602\"></use><use x=\"48.715294\" xlink:href=\"#m128_g22-45\" y=\"-57.444602\"></use><use x=\"55.584523\" xlink:href=\"#m128_g13-186\" y=\"-57.444602\"></use><use x=\"59.400199\" xlink:href=\"#m128_g13-186\" y=\"-57.444602\"></use><use x=\"63.464937\" xlink:href=\"#m128_g13-103\" y=\"-57.444602\"></use><use x=\"67.808656\" xlink:href=\"#m128_g19-43\" y=\"-61.559162\"></use><use x=\"67.808656\" xlink:href=\"#m128_g19-56\" y=\"-54.294838\"></use><use x=\"70.430466\" xlink:href=\"#m128_g1-61\" y=\"-54.294838\"></use><use x=\"75.05592\" xlink:href=\"#m128_g26-49\" y=\"-54.294838\"></use><use x=\"79.389655\" xlink:href=\"#m128_g7-17\" y=\"-68.453307\"></use><use x=\"85.393662\" xlink:href=\"#m128_g22-150\" y=\"-57.444602\"></use><use x=\"99.457536\" xlink:href=\"#m128_g22-24\" y=\"-57.444602\"></use><use x=\"107.208455\" xlink:href=\"#m128_g13-185\" y=\"-57.444602\"></use><use x=\"110.765116\" xlink:href=\"#m128_g22-65\" y=\"-57.444602\"></use><use x=\"115.38777\" xlink:href=\"#m128_g13-186\" y=\"-57.444602\"></use><use x=\"121.970779\" xlink:href=\"#m128_g4-61\" y=\"-57.444602\"></use><use x=\"131.074347\" xlink:href=\"#m128_g7-213\" y=\"-67.638856\"></use><use x=\"135.830097\" xlink:href=\"#m128_g19-58\" y=\"-45.798288\"></use><use x=\"145.566624\" xlink:href=\"#m128_g22-41\" y=\"-57.444602\"></use><use x=\"151.004728\" xlink:href=\"#m128_g19-58\" y=\"-55.950221\"></use><use x=\"156.296212\" xlink:href=\"#m128_g7-16\" y=\"-68.453307\"></use><use x=\"160.042147\" xlink:href=\"#m128_g29-49\" y=\"-57.444602\"></use><use x=\"167.237333\" xlink:href=\"#m128_g13-0\" y=\"-57.444602\"></use><use x=\"175.936878\" xlink:href=\"#m128_g22-52\" y=\"-57.444602\"></use><use x=\"180.989926\" xlink:href=\"#m128_g10-0\" y=\"-61.559162\"></use><use x=\"186.560828\" xlink:href=\"#m128_g19-102\" y=\"-61.559162\"></use><use x=\"192.094681\" xlink:href=\"#m128_g16-58\" y=\"-60.426355\"></use><use x=\"196.724309\" xlink:href=\"#m128_g19-88\" y=\"-61.559162\"></use><use x=\"200.861801\" xlink:href=\"#m128_g16-58\" y=\"-60.426355\"></use><use x=\"205.388802\" xlink:href=\"#m128_g7-17\" y=\"-68.453307\"></use><use x=\"211.502457\" xlink:href=\"#m128_g22-50\" y=\"-57.444602\"></use><use x=\"216.611803\" xlink:href=\"#m128_g19-58\" y=\"-55.950221\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">原始 NeRF 每个场景都需多视图和长时间优化</p><p class=\"cell-val cell-val-en lang-en\">Original NeRF had no cross-scene prior and collapsed completely when given only 1–3 input views.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">从输入图像提取像素对齐特征并条件化 NeRF，使其跨场景推断新对象</p><p class=\"cell-val cell-val-en lang-en\">Extract a spatial CNN feature pyramid from each input view, project any 3D query point x onto the 2D image planes via camera intrinsics/extrinsics, and feed the bilinearly sampled features into the NeRF MLP.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">学习跨场景先验，实现单张或少量视图的前馈条件化重建</p><p class=\"cell-val cell-val-en lang-en\">Preserves explicit projective geometry via pixel-aligned local features rather than compressing the input into a single global latent vector.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">启发 sparse-view X-ray、内镜和解剖场的患者先验建模</p><p class=\"cell-val cell-val-en lang-en\">Directly inspires sparse-view dual/single X-ray to 3D CT neural field priors (e.g., PerX2CT, DIF-Net).</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">少视图 NeRF 基础；自然图像辐射假设不能直接替代医学投影物理</p><p class=\"cell-val cell-val-en lang-en\">Foundational few-view conditional neural field; projective feature occlusion must be adapted for transmission X-ray imaging.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">3D query 点先投影回参考图，读取与该点对齐的局部图像特征。</li><li class=\"lang-zh\">NeRF MLP 不再只记忆单场景参数，而被 CNN 特征条件化以学习跨场景先验。</li><li class=\"lang-zh\">一张或少量参考图经前馈编码后即可对新对象推断和渲染。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Extract a spatial CNN feature pyramid from each input view, project any 3D query point x onto the 2D image planes via camera intrinsics/extrinsics, and feed the bilinearly sampled features into the NeRF MLP.</li><li class=\"lang-en bullet-en\">Architectural Delta: Preserves explicit projective geometry via pixel-aligned local features rather than compressing the input into a single global latent vector.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Pixel-Aligned View-Space CNN Feature Conditioning of Continuous Radiance Fields.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">启发 sparse-view X-ray、内镜和患者特异解剖场中的图像条件神经场。</li><li class=\"lang-zh\">少视图未观测区域仍由训练先验补全；医学应用必须区分可见证据与先验生成部分。</li><li class=\"lang-en bullet-en\">Clinical Translation: Directly inspires sparse-view dual/single X-ray to 3D CT neural field priors (e.g., PerX2CT, DIF-Net).</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Foundational few-view conditional neural field; projective feature occlusion must be adapted for transmission X-ray imaging.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openaccess.thecvf.com/content/CVPR2021/html/Yu_pixelNeRF_Neural_Radiance_Fields_From_One_or_Few_Images_CVPR_2021_paper.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>pixelNeRF: Neural Radiance Fields from One or Few Images</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/sxyu/pixel-nerf\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
