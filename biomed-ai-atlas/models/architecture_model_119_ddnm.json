2.898224 .39126-2.876487 .405751-2.85475H1.021624L.427488-.724556C.347787-.485452 .304313-.246349 .304313-.173893C.311559-.021737 .478207 .094192 .702819 .094192C1.079588 .094192 1.347674-.108683 1.854863-.797012Z\" id=\"m119_g10-67\"></path><path d=\"M5.697191-3.275389V-3.831212H.615376V-3.275389H5.697191ZM5.697191-1.260528V-1.816352H.615376V-1.260528H5.697191Z\" id=\"m119_g1-61\"></path><use id=\"m119_g7-0\" transform=\"scale(1.369862)\" xlink:href=\"#m119_g4-0\"></use><use id=\"m119_g7-184\" transform=\"scale(1.369862)\" xlink:href=\"#m119_g4-184\"></use><use id=\"m119_g7-185\" transform=\"scale(1.369862)\" xlink:href=\"#m119_g4-185\"></use><use id=\"m119_g7-186\" transform=\"scale(1.369862)\" xlink:href=\"#m119_g4-186\"></use></defs><g id=\"m119_page1\"><use x=\"-67.808234\" xlink:href=\"#m119_g20-94\" y=\"-58.910966\"></use><use x=\"-69.011212\" xlink:href=\"#m119_g13-71\" y=\"-58.910966\"></use><use x=\"-64.288921\" xlink:href=\"#m119_g17-48\" y=\"-57.280331\"></use><use x=\"-60.143467\" xlink:href=\"#m119_g4-106\" y=\"-57.280331\"></use><use x=\"-58.143466\" xlink:href=\"#m119_g10-67\" y=\"-57.280331\"></use><use x=\"-51.932587\" xlink:href=\"#m119_g1-61\" y=\"-58.910966\"></use><use x=\"-42.081823\" xlink:href=\"#m119_g13-22\" y=\"-58.910966\"></use><use x=\"-35.865147\" xlink:href=\"#m119_g4-121\" y=\"-63.025526\"></use><use x=\"-31.332152\" xlink:href=\"#m119_g13-72\" y=\"-58.910966\"></use><use x=\"-24.316296\" xlink:href=\"#m119_g7-184\" y=\"-58.910966\"></use><use x=\"-15.26806\" xlink:href=\"#m119_g7-185\" y=\"-58.910966\"></use><use x=\"-11.143528\" xlink:href=\"#m119_g13-30\" y=\"-58.910966\"></use><use x=\"-4.884848\" xlink:href=\"#m119_g7-0\" y=\"-58.910966\"></use><use x=\"4.41245\" xlink:href=\"#m119_g13-22\" y=\"-58.910966\"></use><use x=\"10.629126\" xlink:href=\"#m119_g4-121\" y=\"-63.025526\"></use><use x=\"15.510812\" xlink:href=\"#m119_g13-22\" y=\"-58.910966\"></use><use x=\"21.727488\" xlink:href=\"#m119_g7-186\" y=\"-58.910966\"></use><use x=\"25.543163\" xlink:href=\"#m119_g13-71\" y=\"-58.910966\"></use><use x=\"30.449746\" xlink:href=\"#m119_g17-112\" y=\"-64.003943\"></use><use x=\"34.086111\" xlink:href=\"#m119_g17-114\" y=\"-64.003943\"></use><use x=\"36.507932\" xlink:href=\"#m119_g17-101\" y=\"-64.003943\"></use><use x=\"39.737026\" xlink:href=\"#m119_g17-100\" y=\"-64.003943\"></use><use x=\"30.265455\" xlink:href=\"#m119_g17-48\" y=\"-55.04871\"></use><use x=\"34.410909\" xlink:href=\"#m119_g4-106\" y=\"-55.04871\"></use><use x=\"36.41091\" xlink:href=\"#m119_g10-67\" y=\"-55.04871\"></use><use x=\"43.871491\" xlink:href=\"#m119_g13-150\" y=\"-58.910966\"></use><use x=\"58.841961\" xlink:href=\"#m119_g13-22\" y=\"-58.910966\"></use><use x=\"66.261615\" xlink:href=\"#m119_g20-94\" y=\"-58.910966\"></use><use x=\"65.058637\" xlink:href=\"#m119_g13-71\" y=\"-58.910966\"></use><use x=\"69.780928\" xlink:href=\"#m119_g17-48\" y=\"-57.280331\"></use><use x=\"73.926382\" xlink:href=\"#m119_g4-106\" y=\"-57.280331\"></use><use x=\"75.926383\" xlink:href=\"#m119_g10-67\" y=\"-57.280331\"></use><use x=\"82.137262\" xlink:href=\"#m119_g1-61\" y=\"-58.910966\"></use><use x=\"91.639335\" xlink:href=\"#m119_g13-72\" y=\"-58.910966\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">通用扩散先验直接采样不满足观测，任务专用训练成本高</p><p class=\"cell-val cell-val-en lang-en\">Unconditional diffusion samples violate measurement constraints, whereas backpropagating likelihood gradients through U-Nets (DPS) is memory-heavy.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">把扩散采样分解为满足线性测量的范围空间部分与可生成的零空间部分</p><p class=\"cell-val cell-val-en lang-en\">Directly replace the range-space component of each step's denoised estimate x̂_{0|t} with A†y, leaving the diffusion model to synthesize only the null-space component.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">利用伪逆投影在每步注入数据一致性，实现零样本多退化恢复</p><p class=\"cell-val cell-val-en lang-en\">Backpropagation-free zero-shot linear inverse solver with a noise-aware extension (DDNM+) handling additive measurement noise.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">可用于 MRI、CT、去模糊和缺失数据的扩散逆问题研究</p><p class=\"cell-val cell-val-en lang-en\">Used in zero-shot MRI reconstruction, sparse CT restoration, super-resolution, and inpainting.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">零样本基线重要；依赖已知线性算子与准确噪声模型</p><p class=\"cell-val cell-val-en lang-en\">Clean mathematical decomposition of range vs. null space; highlights directly that null-space anatomy is synthesized purely by the prior.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">测量确定的范围空间分量由 A†y 直接替换。</li><li class=\"lang-zh\">扩散模型只负责填充 (I−A†A) 所描述的零空间自由度。</li><li class=\"lang-zh\">数据一致校正在每个逆扩散步插入，因此不需为每个退化算子重新训练网络。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Directly replace the range-space component of each step's denoised estimate x̂_{0|t} with A†y, leaving the diffusion model to synthesize only the null-space component.</li><li class=\"lang-en bullet-en\">Architectural Delta: Backpropagation-free zero-shot linear inverse solver with a noise-aware extension (DDNM+) handling additive measurement noise.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Range–Null Space Decomposition: x̄_{0|t} = A†y + (I − A†A)x̂_{0|t}.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">可研究 MRI 欠采样、CT 缺失投影和去模糊等线性逆问题的零样本扩散先验。</li><li class=\"lang-zh\">医学算子往往含噪、非线性或无精确伪逆；预训练自然图像先验也可能在 null space 生成错误解剖。</li><li class=\"lang-en bullet-en\">Clinical Translation: Used in zero-shot MRI reconstruction, sparse CT restoration, super-resolution, and inpainting.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Clean mathematical decomposition of range vs. null space; highlights directly that null-space anatomy is synthesized purely by the prior.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://arxiv.org/abs/2212.00490\" rel=\"noreferrer\" target=\"_blank\">\n<span>Zero-Shot Image Restoration Using Denoising Diffusion Null-Space Model</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/wyhuai/DDNM\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
