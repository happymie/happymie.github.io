use x=\"-66.879223\" xlink:href=\"#m070_g23-94\" y=\"-61.519318\"></use><use x=\"-69.359903\" xlink:href=\"#m070_g16-41\" y=\"-59.491917\"></use><use x=\"-60.096948\" xlink:href=\"#m070_g1-61\" y=\"-59.491917\"></use><use x=\"-50.993379\" xlink:href=\"#m070_g23-97\" y=\"-59.491917\"></use><use x=\"-46.569965\" xlink:href=\"#m070_g23-114\" y=\"-59.491917\"></use><use x=\"-43.401853\" xlink:href=\"#m070_g23-103\" y=\"-59.491917\"></use><use x=\"-30.054368\" xlink:href=\"#m070_g23-109\" y=\"-59.491917\"></use><use x=\"-22.303436\" xlink:href=\"#m070_g23-97\" y=\"-59.491917\"></use><use x=\"-17.880021\" xlink:href=\"#m070_g23-120\" y=\"-59.491917\"></use><use x=\"-36.832862\" xlink:href=\"#m070_g13-41\" y=\"-52.573145\"></use><use x=\"-31.298321\" xlink:href=\"#m070_g7-50\" y=\"-52.573145\"></use><use x=\"-26.854697\" xlink:href=\"#m070_g13-40\" y=\"-52.573145\"></use><use x=\"-22.123796\" xlink:href=\"#m070_g13-26\" y=\"-52.573145\"></use><use x=\"-15.981986\" xlink:href=\"#m070_g7-185\" y=\"-52.573145\"></use><use x=\"-13.196538\" xlink:href=\"#m070_g20-51\" y=\"-52.573145\"></use><use x=\"-9.196535\" xlink:href=\"#m070_g7-186\" y=\"-52.573145\"></use><use x=\"-4.532552\" xlink:href=\"#m070_g23-76\" y=\"-59.491917\"></use><use x=\"1.554622\" xlink:href=\"#m070_g23-78\" y=\"-59.491917\"></use><use x=\"8.5982\" xlink:href=\"#m070_g23-67\" y=\"-59.491917\"></use><use x=\"15.243279\" xlink:href=\"#m070_g23-67\" y=\"-59.491917\"></use><use x=\"21.888359\" xlink:href=\"#m070_g20-109\" y=\"-57.997536\"></use><use x=\"27.546542\" xlink:href=\"#m070_g20-115\" y=\"-57.997536\"></use><use x=\"31.670763\" xlink:href=\"#m070_g4-0\" y=\"-67.085922\"></use><use x=\"35.187568\" xlink:href=\"#m070_g16-72\" y=\"-59.491917\"></use><use x=\"39.989558\" xlink:href=\"#m070_g16-150\" y=\"-59.491917\"></use><use x=\"44.349821\" xlink:href=\"#m070_g10-82\" y=\"-59.491917\"></use><use x=\"51.47311\" xlink:href=\"#m070_g20-88\" y=\"-57.997536\"></use><use x=\"56.724022\" xlink:href=\"#m070_g20-114\" y=\"-57.997536\"></use><use x=\"59.145842\" xlink:href=\"#m070_g20-97\" y=\"-57.997536\"></use><use x=\"62.156745\" xlink:href=\"#m070_g20-121\" y=\"-57.997536\"></use><use x=\"66.789348\" xlink:href=\"#m070_g10-185\" y=\"-59.491917\"></use><use x=\"70.106903\" xlink:href=\"#m070_g16-43\" y=\"-59.491917\"></use><use x=\"77.120601\" xlink:href=\"#m070_g23-59\" y=\"-59.491917\"></use><use x=\"81.201922\" xlink:href=\"#m070_g16-41\" y=\"-59.491917\"></use><use x=\"87.697559\" xlink:href=\"#m070_g10-186\" y=\"-59.491917\"></use><use x=\"91.712492\" xlink:href=\"#m070_g4-1\" y=\"-67.085922\"></use><use x=\"97.088885\" xlink:href=\"#m070_g16-150\" y=\"-59.491917\"></use><use x=\"110.963468\" xlink:href=\"#m070_g16-41\" y=\"-59.491917\"></use><use x=\"117.165205\" xlink:href=\"#m070_g13-57\" y=\"-57.997536\"></use><use x=\"119.921565\" xlink:href=\"#m070_g7-184\" y=\"-57.997536\"></use><use x=\"124.547019\" xlink:href=\"#m070_g20-49\" y=\"-57.997536\"></use><use x=\"131.448834\" xlink:href=\"#m070_g1-61\" y=\"-59.491917\"></use><use x=\"140.552402\" xlink:href=\"#m070_g23-101\" y=\"-59.491917\"></use><use x=\"144.627118\" xlink:href=\"#m070_g23-120\" y=\"-59.491917\"></use><use x=\"149.608438\" xlink:href=\"#m070_g23-112\" y=\"-59.491917\"></use><use x=\"155.087892\" xlink:href=\"#m070_g10-185\" y=\"-59.491917\"></use><use x=\"160.847133\" xlink:href=\"#m070_g4-99\" y=\"-61.519318\"></use><use x=\"158.943429\" xlink:href=\"#m070_g16-88\" y=\"-59.491917\"></use><use x=\"163.954622\" xlink:href=\"#m070_g16-98\" y=\"-59.491917\"></use><use x=\"169.598454\" xlink:href=\"#m070_g13-57\" y=\"-57.997536\"></use><use x=\"172.852938\" xlink:href=\"#m070_g10-186\" y=\"-59.491917\"></use><use x=\"176.319923\" xlink:href=\"#m070_g16-41\" y=\"-59.491917\"></use><use x=\"182.52166\" xlink:href=\"#m070_g13-57\" y=\"-57.997536\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">直接 pose regression 跨病人/视角泛化差，纯优化捕获范围有限</p><p class=\"cell-val cell-val-en lang-en\">Direct CNN pose regression generalized poorly outside training poses, while pure gradient-based DRR optimization had a narrow capture range.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">用合成 DRR 自监督 pose regressor 初始化，再以可微 X-ray renderer 和 SE(3) 几何测试时优化</p><p class=\"cell-val cell-val-en lang-en\">Generate synthetic DRRs across SE(3) for a patient's preoperative CT to train a rapid pose regressor, then refine the estimate at test time via differentiable DRR gradients.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">学习初始化、真实投影 forward model、geodesic pose 与 sparse multiscale LNCC 闭环</p><p class=\"cell-val cell-val-en lang-en\">Double-geodesic SE(3) loss + sparse patch-based differentiable rendering accelerating test-time optimization to sub-second latency.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">用于术中 X-ray 到术前 CT 的 2D/3D 配准</p><p class=\"cell-val cell-val-en lang-en\">Enables accurate intraoperative 2D X-ray to 3D CT registration for orthopedic, spinal, and endovascular image-guided surgery.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">几何融合范式价值高；标定、散射、金属和外部设备仍会致败</p><p class=\"cell-val cell-val-en lang-en\">Exemplary hybrid learning + projective physics loop; requires accurate C-arm calibration and robustness to surgical tool occlusion.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">学习回归器扩大捕获范围，可微物理渲染在测试时用真实目标图像闭环精修。</li><li class=\"lang-zh\">SE(3) 几何把旋转和平移更新限制在合法刚体变换上，而非回归任意 6 个独立数。</li><li class=\"lang-zh\">多尺度局部相似度提高弱重叠下的优化可用性，但仍依赖正确投影标定和成像外观。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Generate synthetic DRRs across SE(3) for a patient's preoperative CT to train a rapid pose regressor, then refine the estimate at test time via differentiable DRR gradients.</li><li class=\"lang-en bullet-en\">Architectural Delta: Double-geodesic SE(3) loss + sparse patch-based differentiable rendering accelerating test-time optimization to sub-second latency.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Geodesic SE(3) Pose Initialization + Differentiable DRR Multiscale LNCC Refinement.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适用于术中 X-ray 与术前 CT 对齐，可服务导航、植入物定位和解剖覆盖确认。</li><li class=\"lang-zh\">散射、金属、器械遮挡、错误标定和真实软组织变形会破坏 DRR–X-ray 对应并形成错误局部极值。</li><li class=\"lang-en bullet-en\">Clinical Translation: Enables accurate intraoperative 2D X-ray to 3D CT registration for orthopedic, spinal, and endovascular image-guided surgery.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Exemplary hybrid learning + projective physics loop; requires accurate C-arm calibration and robustness to surgical tool occlusion.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openaccess.thecvf.com/content/CVPR2024/papers/Gopalakrishnan_Intraoperative_2D3D_Image_Registration_via_Differentiable_X-ray_Rendering_CVPR_2024_paper.pdf\" rel=\"noreferrer\" target=\"_blank\">\n<span>Intraoperative 2D/3D Image Registration via Differentiable X-ray Rendering</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/eigenvivek/DiffPose\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}