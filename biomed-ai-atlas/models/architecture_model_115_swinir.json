=\"-30.01043\" xlink:href=\"#m115_g20-66\" y=\"-61.962663\"></use><use x=\"-23.36535\" xlink:href=\"#m115_g10-56\" y=\"-60.468282\"></use><use x=\"-19.747279\" xlink:href=\"#m115_g7-185\" y=\"-61.962663\"></use><use x=\"-15.742299\" xlink:href=\"#m115_g13-27\" y=\"-61.962663\"></use><use x=\"-10.093488\" xlink:href=\"#m115_g10-56\" y=\"-60.468282\"></use><use x=\"-7.180769\" xlink:href=\"#m115_g4-0\" y=\"-60.468282\"></use><use x=\"-2.264414\" xlink:href=\"#m115_g17-49\" y=\"-60.468282\"></use><use x=\"1.870072\" xlink:href=\"#m115_g7-186\" y=\"-61.962663\"></use><use x=\"7.899614\" xlink:href=\"#m115_g7-184\" y=\"-61.962663\"></use><use x=\"16.738635\" xlink:href=\"#m115_g13-27\" y=\"-61.962663\"></use><use x=\"22.387446\" xlink:href=\"#m115_g10-56\" y=\"-60.468282\"></use><use x=\"25.300165\" xlink:href=\"#m115_g4-0\" y=\"-60.468282\"></use><use x=\"30.21652\" xlink:href=\"#m115_g17-49\" y=\"-60.468282\"></use><use x=\"34.351006\" xlink:href=\"#m115_g13-150\" y=\"-61.962663\"></use><use x=\"49.777258\" xlink:href=\"#m115_g20-94\" y=\"-61.962663\"></use><use x=\"48.57428\" xlink:href=\"#m115_g13-71\" y=\"-61.962663\"></use><use x=\"56.248185\" xlink:href=\"#m115_g1-61\" y=\"-61.962663\"></use><use x=\"65.610783\" xlink:href=\"#m115_g13-29\" y=\"-61.962663\"></use><use x=\"72.903439\" xlink:href=\"#m115_g17-114\" y=\"-60.468282\"></use><use x=\"75.325259\" xlink:href=\"#m115_g17-101\" y=\"-60.468282\"></use><use x=\"78.554353\" xlink:href=\"#m115_g17-99\" y=\"-60.468282\"></use><use x=\"82.779689\" xlink:href=\"#m115_g7-185\" y=\"-61.962663\"></use><use x=\"86.784669\" xlink:href=\"#m115_g13-27\" y=\"-61.962663\"></use><use x=\"92.43348\" xlink:href=\"#m115_g17-100\" y=\"-60.468282\"></use><use x=\"96.069845\" xlink:href=\"#m115_g17-101\" y=\"-60.468282\"></use><use x=\"99.298939\" xlink:href=\"#m115_g17-101\" y=\"-60.468282\"></use><use x=\"102.528033\" xlink:href=\"#m115_g17-112\" y=\"-60.468282\"></use><use x=\"108.876366\" xlink:href=\"#m115_g7-184\" y=\"-61.962663\"></use><use x=\"117.715388\" xlink:href=\"#m115_g13-27\" y=\"-61.962663\"></use><use x=\"123.364199\" xlink:href=\"#m115_g17-115\" y=\"-60.468282\"></use><use x=\"126.193291\" xlink:href=\"#m115_g17-104\" y=\"-60.468282\"></use><use x=\"129.829656\" xlink:href=\"#m115_g17-97\" y=\"-60.468282\"></use><use x=\"133.05875\" xlink:href=\"#m115_g17-108\" y=\"-60.468282\"></use><use x=\"135.080568\" xlink:href=\"#m115_g17-108\" y=\"-60.468282\"></use><use x=\"137.102386\" xlink:href=\"#m115_g17-111\" y=\"-60.468282\"></use><use x=\"140.484197\" xlink:href=\"#m115_g17-119\" y=\"-60.468282\"></use><use x=\"146.233183\" xlink:href=\"#m115_g7-186\" y=\"-61.962663\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">CNN 恢复网络局部感受野限制长程依赖，全局 attention 成本过高</p><p class=\"cell-val cell-val-en lang-en\">Pure CNN restoration networks had content-independent local kernels, while naive ViTs lost fine pixel boundaries and translation equivariance.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">以浅层卷积、深层残差 Swin blocks 和重建 head 统一多类图像恢复</p><p class=\"cell-val cell-val-en lang-en\">Combine local shifted-window self-attention (for content-adaptive long-range self-similarity) with residual convolutional layers for translational stability.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">用 shifted-window attention 在高分辨率下高效建模非局部结构</p><p class=\"cell-val cell-val-en lang-en\">Shallow feature CNN + deep RSTB cascade + long global skip connection achieving state-of-the-art PSNR across restoration benchmarks.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">常用于低剂量 CT、MRI、显微图像去噪与超分辨率迁移</p><p class=\"cell-val cell-val-en lang-en\">Widely adopted backbone for MRI super-resolution, low-dose CT/PET denoising, and microscopy image restoration.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">强恢复 backbone；未显式保证数据一致性或病灶保真</p><p class=\"cell-val cell-val-en lang-en\">Strong modern restoration backbone; remains an image-space mapping unless embedded inside an unrolled physics data-consistency loop.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">浅层卷积保留低频基底，深层 Transformer 只需学习复杂残差。</li><li class=\"lang-zh\">shifted-window attention 以局部窗口成本获得跨窗口非局部建模。</li><li class=\"lang-zh\">统一 RSTB 主干，按超分、去噪或去伪影切换重建 head。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Combine local shifted-window self-attention (for content-adaptive long-range self-similarity) with residual convolutional layers for translational stability.</li><li class=\"lang-en bullet-en\">Architectural Delta: Shallow feature CNN + deep RSTB cascade + long global skip connection achieving state-of-the-art PSNR across restoration benchmarks.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Residual Swin Transformer Block (RSTB) Combining Shifted-Window Attention &amp; Conv Inductive Bias.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合高分辨率病理、低剂量 CT、MRI 和显微图像恢复迁移。</li><li class=\"lang-zh\">自然图像感知指标提升不保证 HU、ADC 或病灶边界保真，需配测量一致性和下游任务评价。</li><li class=\"lang-en bullet-en\">Clinical Translation: Widely adopted backbone for MRI super-resolution, low-dose CT/PET denoising, and microscopy image restoration.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Strong modern restoration backbone; remains an image-space mapping unless embedded inside an unrolled physics data-consistency loop.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openaccess.thecvf.com/content/ICCV2021W/AIM/html/Liang_SwinIR_Image_Restoration_Using_Swin_Transformer_ICCVW_2021_paper.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>SwinIR: Image Restoration Using Swin Transformer</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/JingyunLiang/SwinIR\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}