=\"#m065_g13-86\" y=\"-61.587574\"></use><use x=\"108.663494\" xlink:href=\"#m065_g17-97\" y=\"-60.093193\"></use><use x=\"111.892588\" xlink:href=\"#m065_g17-116\" y=\"-60.093193\"></use><use x=\"113.914406\" xlink:href=\"#m065_g17-116\" y=\"-60.093193\"></use><use x=\"115.936224\" xlink:href=\"#m065_g17-110\" y=\"-60.093193\"></use><use x=\"120.568817\" xlink:href=\"#m065_g7-185\" y=\"-61.587574\"></use><use x=\"124.394464\" xlink:href=\"#m065_g13-50\" y=\"-61.587574\"></use><use x=\"129.111776\" xlink:href=\"#m065_g7-186\" y=\"-61.587574\"></use><use x=\"132.927452\" xlink:href=\"#m065_g7-186\" y=\"-61.602517\"></use><use x=\"138.403427\" xlink:href=\"#m065_g13-150\" y=\"-61.587574\"></use><use x=\"152.656591\" xlink:href=\"#m065_g13-110\" y=\"-61.587574\"></use><use x=\"157.531812\" xlink:href=\"#m065_g10-92\" y=\"-60.093193\"></use><use x=\"162.808074\" xlink:href=\"#m065_g7-185\" y=\"-61.587574\"></use><use x=\"166.763239\" xlink:href=\"#m065_g13-73\" y=\"-61.587574\"></use><use x=\"170.973947\" xlink:href=\"#m065_g10-67\" y=\"-60.093193\"></use><use x=\"174.417513\" xlink:href=\"#m065_g13-150\" y=\"-61.587574\"></use><use x=\"178.6383\" xlink:href=\"#m065_g13-67\" y=\"-61.587574\"></use><use x=\"181.985742\" xlink:href=\"#m065_g13-150\" y=\"-61.587574\"></use><use x=\"186.355961\" xlink:href=\"#m065_g13-50\" y=\"-61.587574\"></use><use x=\"191.073274\" xlink:href=\"#m065_g7-186\" y=\"-61.587574\"></use><use x=\"197.656282\" xlink:href=\"#m065_g1-61\" y=\"-61.587574\"></use><use x=\"206.759851\" xlink:href=\"#m065_g20-85\" y=\"-61.587574\"></use><use x=\"213.653996\" xlink:href=\"#m065_g20-110\" y=\"-61.587574\"></use><use x=\"218.485867\" xlink:href=\"#m065_g20-112\" y=\"-61.587574\"></use><use x=\"223.467187\" xlink:href=\"#m065_g20-97\" y=\"-61.587574\"></use><use x=\"227.890602\" xlink:href=\"#m065_g20-116\" y=\"-61.587574\"></use><use x=\"230.660215\" xlink:href=\"#m065_g20-99\" y=\"-61.587574\"></use><use x=\"234.93418\" xlink:href=\"#m065_g20-104\" y=\"-61.587574\"></use><use x=\"240.413634\" xlink:href=\"#m065_g7-185\" y=\"-61.587574\"></use><use x=\"243.870666\" xlink:href=\"#m065_g13-44\" y=\"-61.587574\"></use><use x=\"253.414864\" xlink:href=\"#m065_g13-17\" y=\"-61.587574\"></use><use x=\"258.95907\" xlink:href=\"#m065_g10-33\" y=\"-60.093193\"></use><use x=\"264.326276\" xlink:href=\"#m065_g7-186\" y=\"-61.587574\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">U-Net diffusion 的扩展规律和多模态 token 接口有限</p><p class=\"cell-val cell-val-en lang-en\">Convolutional U-Net inductive biases plateaued under massive compute scaling and lacked a uniform token interface across modalities.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">将 latent image patch 化，用 Transformer blocks 与 adaptive LayerNorm 做 diffusion backbone</p><p class=\"cell-val cell-val-en lang-en\">Tokenize latent feature maps into patches and process them through standard Transformer blocks modulated by scale/shift/gate parameters regressed from (t, c).</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">以模型规模和计算量系统提升生成质量，条件以 adaLN 注入</p><p class=\"cell-val cell-val-en lang-en\">adaLN-Zero initialization (initializing each residual block as exact identity) + predictable Gflops scaling laws improving FID monotonically with compute.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">适合医学多模态、3D patch 和 report/image cross-attention 研究</p><p class=\"cell-val cell-val-en lang-en\">Backbone of choice for scalable 3D volumetric latent diffusion, spatio-temporal video generation, and multimodal medical synthesis.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">生成 backbone 重要演化；3D token、数据规模和微小结构仍是风险</p><p class=\"cell-val cell-val-en lang-en\">Major generative backbone shift; requires well-trained 3D/2D VAEs and large training cohorts to justify Transformer compute.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">用标准 Transformer token pipeline 替代 U-Net 多尺度卷积主干，把扩散建模转化为可扩展的 patch 序列计算。</li><li class=\"lang-zh\">adaLN-Zero 将时间和类别条件注入每个 block，并以零门控稳定深网络初始训练。</li><li class=\"lang-zh\">DiT 是 denoiser/score backbone，不定义独立的前向噪声或 ODE；采样动力学仍由外部 diffusion solver 决定。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Tokenize latent feature maps into patches and process them through standard Transformer blocks modulated by scale/shift/gate parameters regressed from (t, c).</li><li class=\"lang-en bullet-en\">Architectural Delta: adaLN-Zero initialization (initializing each residual block as exact identity) + predictable Gflops scaling laws improving FID monotonically with compute.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Patchified Latent Diffusion Transformer Conditioned via Zero-Initialized Adaptive LayerNorm.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合多模态 token 条件和 3D patch 研究，可与文本、报告或解剖标签统一接口。</li><li class=\"lang-zh\">3D token 数量和训练数据规模增长快；全局生成指标也可能掩盖微小结构和定量信号损失。</li><li class=\"lang-en bullet-en\">Clinical Translation: Backbone of choice for scalable 3D volumetric latent diffusion, spatio-temporal video generation, and multimodal medical synthesis.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Major generative backbone shift; requires well-trained 3D/2D VAEs and large training cohorts to justify Transformer compute.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openaccess.thecvf.com/content/ICCV2023/html/Peebles_Scalable_Diffusion_Models_with_Transformers_ICCV_2023_paper.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Scalable Diffusion Models with Transformers</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/facebookresearch/DiT\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
