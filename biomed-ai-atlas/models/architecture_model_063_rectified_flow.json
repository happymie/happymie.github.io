9.987571\"></use><use x=\"109.564502\" xlink:href=\"#m063_g14-71\" y=\"-59.987571\"></use><use x=\"116.68495\" xlink:href=\"#m063_g8-0\" y=\"-59.987571\"></use><use x=\"125.474157\" xlink:href=\"#m063_g14-73\" y=\"-59.987571\"></use><use x=\"129.6485\" xlink:href=\"#m063_g8-186\" y=\"-59.987571\"></use><use x=\"133.96231\" xlink:href=\"#m063_g8-107\" y=\"-59.987571\"></use><use x=\"138.445496\" xlink:href=\"#m063_g18-50\" y=\"-64.102131\"></use><use x=\"138.445496\" xlink:href=\"#m063_g18-50\" y=\"-56.961428\"></use><use x=\"142.779243\" xlink:href=\"#m063_g5-3\" y=\"-68.107101\"></use><use x=\"148.653717\" xlink:href=\"#m063_g14-150\" y=\"-59.987571\"></use><use x=\"162.876991\" xlink:href=\"#m063_g21-82\" y=\"-59.987571\"></use><use x=\"169.273004\" xlink:href=\"#m063_g21-101\" y=\"-59.987571\"></use><use x=\"173.696419\" xlink:href=\"#m063_g21-13\" y=\"-59.987571\"></use><use x=\"179.235644\" xlink:href=\"#m063_g21-111\" y=\"-59.987571\"></use><use x=\"183.868266\" xlink:href=\"#m063_g21-119\" y=\"-59.987571\"></use><use x=\"193.828626\" xlink:href=\"#m063_g21-58\" y=\"-59.987571\"></use><use x=\"199.863705\" xlink:href=\"#m063_g8-185\" y=\"-59.987571\"></use><use x=\"203.81887\" xlink:href=\"#m063_g14-73\" y=\"-59.987571\"></use><use x=\"207.993213\" xlink:href=\"#m063_g14-150\" y=\"-59.987571\"></use><use x=\"212.253847\" xlink:href=\"#m063_g14-71\" y=\"-59.987571\"></use><use x=\"217.160429\" xlink:href=\"#m063_g8-186\" y=\"-59.987571\"></use><use x=\"223.743438\" xlink:href=\"#m063_g8-32\" y=\"-59.987571\"></use><use x=\"237.210649\" xlink:href=\"#m063_g8-185\" y=\"-59.987571\"></use><use x=\"241.165815\" xlink:href=\"#m063_g14-73\" y=\"-59.987571\"></use><use x=\"245.340158\" xlink:href=\"#m063_g14-150\" y=\"-59.987571\"></use><use x=\"249.600792\" xlink:href=\"#m063_g2-8\" y=\"-59.987571\"></use><use x=\"257.893193\" xlink:href=\"#m063_g11-92\" y=\"-64.102131\"></use><use x=\"257.202281\" xlink:href=\"#m063_g18-49\" y=\"-56.906899\"></use><use x=\"263.169454\" xlink:href=\"#m063_g8-185\" y=\"-59.987571\"></use><use x=\"267.12462\" xlink:href=\"#m063_g14-73\" y=\"-59.987571\"></use><use x=\"271.298963\" xlink:href=\"#m063_g8-186\" y=\"-59.987571\"></use><use x=\"275.114639\" xlink:href=\"#m063_g8-186\" y=\"-59.987571\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">弯曲生成轨迹需要更多 ODE steps 才能准确积分</p><p class=\"cell-val cell-val-en lang-en\">Curved ODE transport trajectories accumulate high discretization error under large Euler step sizes.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">从 source-target coupling 学直线速度场，并用 reflow 进一步拉直轨迹</p><p class=\"cell-val cell-val-en lang-en\">Drive transport paths as close to straight lines as possible by regressing the constant displacement (x_1 − x_0) and iteratively re-pairing (z_0, ẑ_1) via reflow.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">优化 trajectory straightness，降低 coarse-step integration error</p><p class=\"cell-val cell-val-en lang-en\">Simple ODE velocity formulation + Reflow procedure that provably reduces transport cost and straightens trajectories for 1-step distillation.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">为少步医学生成与 translation 提供速度路线</p><p class=\"cell-val cell-val-en lang-en\">Provides a principled mathematical route for real-time few-step medical domain translation and generative modeling.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">少步潜力真实；高频和病灶 fidelity、uncertainty 仍需专门验证</p><p class=\"cell-val cell-val-en lang-en\">Genuine algorithmic speed advantage; reflow distillation can subtly smooth high-frequency diagnostic textures if not audited.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">用端点线性插值监督 velocity，使学习到的流尽量沿短而直的运输轨迹。</li><li class=\"lang-zh\">reflow 以模型自身生成的端点重新配对并重训，逐轮降低轨迹弯曲和交叉。</li><li class=\"lang-zh\">训练不需要 score；速度场的直线性直接关系到粗步长 ODE 的离散误差。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Drive transport paths as close to straight lines as possible by regressing the constant displacement (x_1 − x_0) and iteratively re-pairing (z_0, ẑ_1) via reflow.</li><li class=\"lang-en bullet-en\">Architectural Delta: Simple ODE velocity formulation + Reflow procedure that provably reduces transport cost and straightens trajectories for 1-step distillation.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Linear Interpolation Velocity Matching &amp; Iterative Reflow Trajectory Straightening.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">对需要交互速度的医学图像生成、translation 或条件重建具有少步潜力。</li><li class=\"lang-zh\">轨迹更直只保证数值积分更容易，不保证微小病灶、定量强度或患者身份信息保持。</li><li class=\"lang-en bullet-en\">Clinical Translation: Provides a principled mathematical route for real-time few-step medical domain translation and generative modeling.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Genuine algorithmic speed advantage; reflow distillation can subtly smooth high-frequency diagnostic textures if not audited.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://mlanthology.org/iclr/2023/liu2023iclr-flow/\" rel=\"noreferrer\" target=\"_blank\">\n<span>Flow Straight and Fast: Learning to Generate and Transfer Data with Rectified Flow</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/gnobitab/RectifiedFlow\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
