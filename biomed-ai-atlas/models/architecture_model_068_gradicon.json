"#m068_g4-76\" y=\"-59.845906\"></use><use x=\"-61.150694\" xlink:href=\"#m068_g14-71\" y=\"-58.351525\"></use><use x=\"-55.899781\" xlink:href=\"#m068_g14-73\" y=\"-58.351525\"></use><use x=\"-53.477961\" xlink:href=\"#m068_g14-67\" y=\"-58.351525\"></use><use x=\"-45.361606\" xlink:href=\"#m068_g1-61\" y=\"-59.845906\"></use><use x=\"-35.759903\" xlink:href=\"#m068_g4-107\" y=\"-59.860849\"></use><use x=\"-31.177088\" xlink:href=\"#m068_g4-114\" y=\"-59.845906\"></use><use x=\"-23.964149\" xlink:href=\"#m068_g4-185\" y=\"-59.845906\"></use><use x=\"-20.248088\" xlink:href=\"#m068_g1-8\" y=\"-59.845906\"></use><use x=\"-11.992052\" xlink:href=\"#m068_g7-22\" y=\"-58.351525\"></use><use x=\"-6.944783\" xlink:href=\"#m068_g7-23\" y=\"-58.351525\"></use><use x=\".909013\" xlink:href=\"#m068_g4-14\" y=\"-59.845906\"></use><use x=\"8.074309\" xlink:href=\"#m068_g1-8\" y=\"-59.845906\"></use><use x=\"16.039437\" xlink:href=\"#m068_g7-23\" y=\"-58.351525\"></use><use x=\"21.835798\" xlink:href=\"#m068_g7-22\" y=\"-58.351525\"></use><use x=\"27.017544\" xlink:href=\"#m068_g4-186\" y=\"-59.845906\"></use><use x=\"33.047086\" xlink:href=\"#m068_g4-0\" y=\"-59.845906\"></use><use x=\"42.00566\" xlink:href=\"#m068_g10-30\" y=\"-59.845906\"></use><use x=\"46.548608\" xlink:href=\"#m068_g4-107\" y=\"-59.860849\"></use><use x=\"51.031737\" xlink:href=\"#m068_g14-50\" y=\"-64.102131\"></use><use x=\"51.213553\" xlink:href=\"#m068_g7-27\" y=\"-57.117794\"></use><use x=\"59.423714\" xlink:href=\"#m068_g4-184\" y=\"-59.845906\"></use><use x=\"68.47195\" xlink:href=\"#m068_g4-107\" y=\"-59.860849\"></use><use x=\"73.054765\" xlink:href=\"#m068_g4-114\" y=\"-59.845906\"></use><use x=\"80.267705\" xlink:href=\"#m068_g4-185\" y=\"-59.845906\"></use><use x=\"83.983765\" xlink:href=\"#m068_g1-8\" y=\"-59.845906\"></use><use x=\"91.948893\" xlink:href=\"#m068_g7-23\" y=\"-58.351525\"></use><use x=\"97.745255\" xlink:href=\"#m068_g7-22\" y=\"-58.351525\"></use><use x=\"105.140867\" xlink:href=\"#m068_g4-14\" y=\"-59.845906\"></use><use x=\"112.306162\" xlink:href=\"#m068_g1-8\" y=\"-59.845906\"></use><use x=\"120.562199\" xlink:href=\"#m068_g7-22\" y=\"-58.351525\"></use><use x=\"125.609468\" xlink:href=\"#m068_g7-23\" y=\"-58.351525\"></use><use x=\"131.249398\" xlink:href=\"#m068_g4-186\" y=\"-59.845906\"></use><use x=\"137.278939\" xlink:href=\"#m068_g4-0\" y=\"-59.845906\"></use><use x=\"146.237513\" xlink:href=\"#m068_g10-30\" y=\"-59.845906\"></use><use x=\"150.780461\" xlink:href=\"#m068_g4-107\" y=\"-59.860849\"></use><use x=\"155.263591\" xlink:href=\"#m068_g14-50\" y=\"-64.102131\"></use><use x=\"155.445406\" xlink:href=\"#m068_g7-27\" y=\"-57.117794\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">单纯平滑位移会过度平滑，直接 inverse-consistency 优化不稳</p><p class=\"cell-val cell-val-en lang-en\">Penalizing displacement norm ||Φ^AB(Φ^BA(x)) − x||² required tedious hyperparameter schedules and still permitted local Jacobian folding.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">同时预测正反变换并惩罚复合映射 Jacobian 偏离单位阵</p><p class=\"cell-val cell-val-en lang-en\">Penalize the spatial gradient (Jacobian) of the composed forward–backward transformation relative to the identity matrix I via first-order Taylor expansion.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">用逆一致性的梯度结构获得规则、近似微分同胚的变换</p><p class=\"cell-val cell-val-en lang-en\">First-order Gradient Inverse Consistency (GradICON) loss yielding near-zero folding and fast convergence across multi-step cascades.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">在多数据集统一 protocol 上提供强通用配准基线</p><p class=\"cell-val cell-val-en lang-en\">Provides a highly regular, topology-preserving 3D registration baseline across brain MRI, lung CT, and abdominal scans.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">比单纯换 encoder 更具长期价值；仍需病理保持和极端域移位验证</p><p class=\"cell-val cell-val-en lang-en\">Superior theoretical and empirical regularity over raw smoothness penalties; space-occupying tumors without topological correspondence still require special handling.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">同时预测正反变换，并要求两者复合的局部导数接近单位变换。</li><li class=\"lang-zh\">对 inverse-consistency 误差的空间梯度进行约束，比只最小化复合位移更关注局部形变结构。</li><li class=\"lang-zh\">近似 inverse consistency 改善规则性，但不等同于数学上处处保证正 Jacobian 的严格微分同胚。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Penalize the spatial gradient (Jacobian) of the composed forward–backward transformation relative to the identity matrix I via first-order Taylor expansion.</li><li class=\"lang-en bullet-en\">Architectural Delta: First-order Gradient Inverse Consistency (GradICON) loss yielding near-zero folding and fast convergence across multi-step cascades.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Gradient Inverse Consistency Regularizer: ||∇(Φ^AB ∘ Φ^BA)(x) − I||_F².</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合跨数据集的器官 CT/MRI 配准，并提供比单纯平滑位移更直接的折叠控制信号。</li><li class=\"lang-zh\">切除、病灶出现/消失和强模态差异没有真实一一对应，强制可逆仍可能产生不合理拉伸。</li><li class=\"lang-en bullet-en\">Clinical Translation: Provides a highly regular, topology-preserving 3D registration baseline across brain MRI, lung CT, and abdominal scans.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Superior theoretical and empirical regularity over raw smoothness penalties; space-occupying tumors without topological correspondence still require special handling.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openaccess.thecvf.com/content/CVPR2023/html/Tian_GradICON_Approximate_Diffeomorphisms_via_Gradient_Inverse_Consistency_CVPR_2023_paper.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>GradICON: Approximate Diffeomorphisms via Gradient Inverse Consistency</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/uncbiag/ICON\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
