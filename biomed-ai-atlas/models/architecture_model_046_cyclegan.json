" xlink:href=\"#m046_g15-65\" y=\"-60.468282\"></use><use x=\"-30.790439\" xlink:href=\"#m046_g15-78\" y=\"-60.468282\"></use><use x=\"-24.543272\" xlink:href=\"#m046_g5-185\" y=\"-61.962663\"></use><use x=\"-20.847135\" xlink:href=\"#m046_g11-28\" y=\"-61.962663\"></use><use x=\"-12.996574\" xlink:href=\"#m046_g11-150\" y=\"-61.962663\"></use><use x=\"-8.367325\" xlink:href=\"#m046_g11-25\" y=\"-61.962663\"></use><use x=\"-.976538\" xlink:href=\"#m046_g8-46\" y=\"-60.468282\"></use><use x=\"4.9325\" xlink:href=\"#m046_g5-186\" y=\"-61.962663\"></use><use x=\"10.962041\" xlink:href=\"#m046_g5-184\" y=\"-61.962663\"></use><use x=\"19.711401\" xlink:href=\"#m046_g5-76\" y=\"-61.962663\"></use><use x=\"27.372662\" xlink:href=\"#m046_g15-71\" y=\"-60.468282\"></use><use x=\"32.441746\" xlink:href=\"#m046_g15-65\" y=\"-60.468282\"></use><use x=\"37.692658\" xlink:href=\"#m046_g15-78\" y=\"-60.468282\"></use><use x=\"43.939825\" xlink:href=\"#m046_g5-185\" y=\"-61.962663\"></use><use x=\"47.944805\" xlink:href=\"#m046_g11-27\" y=\"-61.962663\"></use><use x=\"54.67954\" xlink:href=\"#m046_g11-150\" y=\"-61.962663\"></use><use x=\"59.308789\" xlink:href=\"#m046_g11-25\" y=\"-61.962663\"></use><use x=\"67.354123\" xlink:href=\"#m046_g8-45\" y=\"-60.468282\"></use><use x=\"73.15042\" xlink:href=\"#m046_g5-186\" y=\"-61.962663\"></use><use x=\"79.179962\" xlink:href=\"#m046_g5-184\" y=\"-61.962663\"></use><use x=\"87.600554\" xlink:href=\"#m046_g11-95\" y=\"-61.962663\"></use><use x=\"94.775267\" xlink:href=\"#m046_g0-69\" y=\"-61.962663\"></use><use x=\"101.298808\" xlink:href=\"#m046_g8-71\" y=\"-60.468282\"></use><use x=\"106.349602\" xlink:href=\"#m046_g5-107\" y=\"-61.962663\"></use><use x=\"111.121708\" xlink:href=\"#m046_g11-27\" y=\"-61.962663\"></use><use x=\"118.354577\" xlink:href=\"#m046_g5-185\" y=\"-61.962663\"></use><use x=\"122.050714\" xlink:href=\"#m046_g11-28\" y=\"-61.962663\"></use><use x=\"130.399409\" xlink:href=\"#m046_g5-185\" y=\"-61.962663\"></use><use x=\"134.115469\" xlink:href=\"#m046_g11-71\" y=\"-61.962663\"></use><use x=\"139.022052\" xlink:href=\"#m046_g5-186\" y=\"-61.962663\"></use><use x=\"142.837728\" xlink:href=\"#m046_g5-186\" y=\"-61.962663\"></use><use x=\"148.86727\" xlink:href=\"#m046_g5-0\" y=\"-61.962663\"></use><use x=\"157.417371\" xlink:href=\"#m046_g11-71\" y=\"-61.962663\"></use><use x=\"162.822088\" xlink:href=\"#m046_g5-107\" y=\"-61.962663\"></use><use x=\"167.305274\" xlink:href=\"#m046_g15-49\" y=\"-60.468282\"></use><use x=\"173.653629\" xlink:href=\"#m046_g5-184\" y=\"-61.962663\"></use><use x=\"182.074222\" xlink:href=\"#m046_g11-95\" y=\"-61.962663\"></use><use x=\"189.248935\" xlink:href=\"#m046_g0-69\" y=\"-61.962663\"></use><use x=\"195.736111\" xlink:href=\"#m046_g8-72\" y=\"-60.468282\"></use><use x=\"200.754178\" xlink:href=\"#m046_g5-107\" y=\"-61.962663\"></use><use x=\"205.21744\" xlink:href=\"#m046_g11-28\" y=\"-61.962663\"></use><use x=\"213.566135\" xlink:href=\"#m046_g5-185\" y=\"-61.962663\"></use><use x=\"217.571115\" xlink:href=\"#m046_g11-27\" y=\"-61.962663\"></use><use x=\"224.803984\" xlink:href=\"#m046_g5-185\" y=\"-61.962663\"></use><use x=\"228.91855\" xlink:href=\"#m046_g11-72\" y=\"-61.962663\"></use><use x=\"233.72054\" xlink:href=\"#m046_g5-186\" y=\"-61.962663\"></use><use x=\"237.536216\" xlink:href=\"#m046_g5-186\" y=\"-61.962663\"></use><use x=\"243.565758\" xlink:href=\"#m046_g5-0\" y=\"-61.962663\"></use><use x=\"252.514365\" xlink:href=\"#m046_g11-72\" y=\"-61.962663\"></use><use x=\"257.81449\" xlink:href=\"#m046_g5-107\" y=\"-61.962663\"></use><use x=\"262.297676\" xlink:href=\"#m046_g15-49\" y=\"-60.468282\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">医学跨模态病例常不成对，pix2pix 无法直接训练</p><p class=\"cell-val cell-val-en lang-en\">Acquiring perfectly co-registered paired multi-modality scans (e.g., same-patient paired MR and CT) is often clinically infeasible.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">用双向生成器、两个判别器和 cycle consistency 学无配对域转换</p><p class=\"cell-val cell-val-en lang-en\">Constrain unpaired cross-domain mapping by requiring that translating X→Y and back Y→X recovers the original input image.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">cycle loss 缩小任意 domain mapping 的解空间</p><p class=\"cell-val cell-val-en lang-en\">Dual adversarial critics + forward/backward cycle-consistency L1 loss + identity mapping regularizer.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">用于 MR-CT、MRI contrast 和 scanner harmonization</p><p class=\"cell-val cell-val-en lang-en\">Widely used for unpaired MR-to-CT synthesis, stain normalization in pathology, and cross-vendor scanner style harmonization.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">探索与 style transfer 仍有用；cycle 不保证解剖或定量值保持</p><p class=\"cell-val cell-val-en lang-en\">Useful for exploratory domain adaptation, but cycle consistency is under-constrained and can hallucinate or erase lesions when pathology prevalence differs across domains.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">两个 adversarial losses 只匹配 X 与 Y 的边缘分布，并不需要病例级配对。</li><li class=\"lang-zh\">双向 cycle consistency 要求映射后仍能恢复原样本，从大量可能的域映射中缩小解空间。</li><li class=\"lang-zh\">两个生成器与两个判别器形成闭环：目标域真实感和往返可恢复性共同约束转换。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Constrain unpaired cross-domain mapping by requiring that translating X→Y and back Y→X recovers the original input image.</li><li class=\"lang-en bullet-en\">Architectural Delta: Dual adversarial critics + forward/backward cycle-consistency L1 loss + identity mapping regularizer.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Bidirectional Adversarial Losses + Forward/Backward Cycle Consistency (X→Y→X &amp; Y→X→Y).</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">可在缺乏配对扫描时探索 MR↔CT、对比度转换或 scanner harmonization。</li><li class=\"lang-zh\">cycle 可逆不等于解剖、病灶或 HU 等定量值守恒；医学使用必须增加结构/物理约束和逐病例审计。</li><li class=\"lang-en bullet-en\">Clinical Translation: Widely used for unpaired MR-to-CT synthesis, stain normalization in pathology, and cross-vendor scanner style harmonization.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Useful for exploratory domain adaptation, but cycle consistency is under-constrained and can hallucinate or erase lesions when pathology prevalence differs across domains.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openaccess.thecvf.com/content_ICCV_2017/papers/Zhu_Unpaired_Image-To-Image_Translation_ICCV_2017_paper.pdf\" rel=\"noreferrer\" target=\"_blank\">\n<span>Unpaired Image-to-Image Translation using Cycle-Consistent Adversarial Networks</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/junyanz/CycleGAN\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
