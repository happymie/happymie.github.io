ref=\"#m077_g13-49\" y=\"-61.962663\"></use><use x=\"73.533146\" xlink:href=\"#m077_g7-186\" y=\"-61.962663\"></use><use x=\"77.348822\" xlink:href=\"#m077_g13-150\" y=\"-61.962663\"></use><use x=\"91.681682\" xlink:href=\"#m077_g13-50\" y=\"-61.962663\"></use><use x=\"96.500118\" xlink:href=\"#m077_g10-67\" y=\"-60.468282\"></use><use x=\"102.711017\" xlink:href=\"#m077_g1-61\" y=\"-61.962663\"></use><use x=\"113.548083\" xlink:href=\"#m077_g13-53\" y=\"-61.962663\"></use><use x=\"116.453689\" xlink:href=\"#m077_g10-67\" y=\"-60.468282\"></use><use x=\"122.409998\" xlink:href=\"#m077_g7-12\" y=\"-61.962663\"></use><use x=\"131.368563\" xlink:href=\"#m077_g13-50\" y=\"-61.962663\"></use><use x=\"136.186999\" xlink:href=\"#m077_g10-67\" y=\"-60.468282\"></use><use x=\"139.423356\" xlink:href=\"#m077_g4-0\" y=\"-60.468282\"></use><use x=\"144.339711\" xlink:href=\"#m077_g17-49\" y=\"-60.468282\"></use><use x=\"150.688054\" xlink:href=\"#m077_g7-184\" y=\"-61.962663\"></use><use x=\"159.038898\" xlink:href=\"#m077_g13-56\" y=\"-61.962663\"></use><use x=\"162.143761\" xlink:href=\"#m077_g10-67\" y=\"-60.468282\"></use><use x=\"168.100071\" xlink:href=\"#m077_g7-12\" y=\"-61.962663\"></use><use x=\"178.600343\" xlink:href=\"#m077_g20-126\" y=\"-61.962663\"></use><use x=\"177.058635\" xlink:href=\"#m077_g13-50\" y=\"-61.962663\"></use><use x=\"181.877072\" xlink:href=\"#m077_g10-67\" y=\"-60.468282\"></use><use x=\"185.320625\" xlink:href=\"#m077_g13-150\" y=\"-61.962663\"></use><use x=\"199.902557\" xlink:href=\"#m077_g13-17\" y=\"-61.962663\"></use><use x=\"205.119489\" xlink:href=\"#m077_g10-67\" y=\"-60.468282\"></use><use x=\"211.330388\" xlink:href=\"#m077_g1-61\" y=\"-61.962663\"></use><use x=\"220.573433\" xlink:href=\"#m077_g13-62\" y=\"-61.962663\"></use><use x=\"225.889994\" xlink:href=\"#m077_g10-67\" y=\"-60.468282\"></use><use x=\"231.846303\" xlink:href=\"#m077_g7-12\" y=\"-61.962663\"></use><use x=\"240.695282\" xlink:href=\"#m077_g20-116\" y=\"-61.962663\"></use><use x=\"243.464894\" xlink:href=\"#m077_g20-97\" y=\"-61.962663\"></use><use x=\"247.888309\" xlink:href=\"#m077_g20-110\" y=\"-61.962663\"></use><use x=\"252.869629\" xlink:href=\"#m077_g20-104\" y=\"-61.962663\"></use><use x=\"258.349083\" xlink:href=\"#m077_g7-185\" y=\"-61.962663\"></use><use x=\"262.174729\" xlink:href=\"#m077_g13-50\" y=\"-61.962663\"></use><use x=\"266.993166\" xlink:href=\"#m077_g10-67\" y=\"-60.468282\"></use><use x=\"270.436733\" xlink:href=\"#m077_g7-186\" y=\"-61.962663\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">vanilla RNN 长依赖中梯度消失或爆炸</p><p class=\"cell-val cell-val-en lang-en\">Vanilla RNNs multiplied recurrent weight matrices repeatedly across time, causing gradients to vanish or explode over &gt;20 steps.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">用 cell state 和 input/forget/output gates 保留长期信息</p><p class=\"cell-val cell-val-en lang-en\">Introduce a linear self-connected memory cell c_t regulated by multiplicative sigmoid input, forget, and output gates.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">带近恒等记忆通路的门控循环更新</p><p class=\"cell-val cell-val-en lang-en\">Additive cell-state highway enabling gradient propagation across hundreds of time steps.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">长期用于小中型 ECG、EEG、EMG 与纵向临床序列</p><p class=\"cell-val cell-val-en lang-en\">Long-standing workhorse for 12-lead ECG arrhythmia classification, ICU vitals early-warning scores, and irregular EHR trajectories.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">仍是低数据序列基线；串行训练慢且长窗口扩展有限</p><p class=\"cell-val cell-val-en lang-en\">Reliable low-data sequential baseline; sequential step-by-step recurrence prevents parallel training across ultra-long multi-thousand-sample waveforms.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">加性 cell-state 通路让误差信号跨较长时间传播，缓解普通 RNN 的梯度消失。</li><li class=\"lang-zh\">输入、遗忘与输出门按当前输入和历史状态选择写入、保留和读出内容。</li><li class=\"lang-zh\">1997 原始 LSTM 强调 constant-error memory 与 input/output gates；现代标准 forget gate 是后续扩展，不应混作同年原始细节。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Introduce a linear self-connected memory cell c_t regulated by multiplicative sigmoid input, forget, and output gates.</li><li class=\"lang-en bullet-en\">Architectural Delta: Additive cell-state highway enabling gradient propagation across hundreds of time steps.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Gated Additive Constant Error Carousel Cell Update: c_t = f_t ⊙ c_{t-1} + i_t ⊙ c̃_t.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">在中小数据的 ECG、EEG、EMG 和纵向表格序列上仍是可靠、易解释的基线。</li><li class=\"lang-zh\">串行递归限制长记录吞吐，缺失模式、采样不规则和跨患者状态初始化需显式处理。</li><li class=\"lang-en bullet-en\">Clinical Translation: Long-standing workhorse for 12-lead ECG arrhythmia classification, ICU vitals early-warning scores, and irregular EHR trajectories.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Reliable low-data sequential baseline; sequential step-by-step recurrence prevents parallel training across ultra-long multi-thousand-sample waveforms.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://doi.org/10.1162/neco.1997.9.8.1735\" rel=\"noreferrer\" target=\"_blank\">\n<span>Long Short-Term Memory</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<span class=\"spec-muted-val\"><span class=\"lang-zh\">未提供官方实现</span><span class=\"lang-en\">No Official Repository</span></span>\n</div>\n</footer>\n</div>"}
