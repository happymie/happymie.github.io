\"#m088_g14-97\" y=\"-60.259044\"></use><use x=\"164.26133\" xlink:href=\"#m088_g14-120\" y=\"-60.259044\"></use><use x=\"169.740784\" xlink:href=\"#m088_g4-185\" y=\"-60.273988\"></use><use x=\"173.197813\" xlink:href=\"#m088_g7-44\" y=\"-60.259044\"></use><use x=\"182.981116\" xlink:href=\"#m088_g4-187\" y=\"-60.259044\"></use><use x=\"186.597535\" xlink:href=\"#m088_g14-83\" y=\"-60.259044\"></use><use x=\"191.937495\" xlink:href=\"#m088_g14-116\" y=\"-60.259044\"></use><use x=\"194.707108\" xlink:href=\"#m088_g14-97\" y=\"-60.259044\"></use><use x=\"199.130523\" xlink:href=\"#m088_g14-99\" y=\"-60.259044\"></use><use x=\"203.354672\" xlink:href=\"#m088_g14-107\" y=\"-60.259044\"></use><use x=\"208.883927\" xlink:href=\"#m088_g4-185\" y=\"-60.259044\"></use><use x=\"212.888907\" xlink:href=\"#m088_g7-27\" y=\"-60.259044\"></use><use x=\"218.537719\" xlink:href=\"#m088_g11-50\" y=\"-58.764664\"></use><use x=\"222.174084\" xlink:href=\"#m088_g11-68\" y=\"-58.764664\"></use><use x=\"227.923117\" xlink:href=\"#m088_g4-186\" y=\"-60.259044\"></use><use x=\"231.738792\" xlink:href=\"#m088_g14-59\" y=\"-60.259044\"></use><use x=\"236.457724\" xlink:href=\"#m088_g7-27\" y=\"-60.259044\"></use><use x=\"242.106535\" xlink:href=\"#m088_g11-51\" y=\"-58.764664\"></use><use x=\"245.7429\" xlink:href=\"#m088_g11-68\" y=\"-58.764664\"></use><use x=\"251.491933\" xlink:href=\"#m088_g4-188\" y=\"-60.259044\"></use><use x=\"255.407247\" xlink:href=\"#m088_g4-186\" y=\"-60.273988\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">纯 2D 缺跨切片信息，纯 3D 在高分辨率 CT 上显存和数据需求过高</p><p class=\"cell-val cell-val-en lang-en\">Pure 2D networks miss z-axis continuity, whereas pure 3D networks cannot fit deep high-resolution encoders in GPU memory.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">先以 2D DenseUNet 提取丰富切片内特征，再用 3D DenseUNet 融合体上下文</p><p class=\"cell-val cell-val-en lang-en\">Cascade a deep 2D DenseUNet for high-resolution in-plane representation with a 3D DenseUNet for volumetric context.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">混合 2D/3D 稠密连接在计算可控下同时建模纹理与体结构</p><p class=\"cell-val cell-val-en lang-en\">End-to-end joint Hybrid Feature Fusion (HFF) reconciling 2D transferability with 3D volumetric continuity.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">是 Dense U-Net 系列在肝脏与肿瘤 3D 分割中的代表</p><p class=\"cell-val cell-val-en lang-en\">Landmark hybrid 2.5D/3D architecture for volumetric CT liver and tumor segmentation.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">历史强基线；现代 patch-based 3D 与自动配置框架通常更易复现</p><p class=\"cell-val cell-val-en lang-en\">Historically strong hybrid design; modern patch-based 3D nnU-Net and MedNeXt pipelines offer simpler reproducibility.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">2D DenseUNet 以较低显存学习高分辨率切片纹理，3D DenseUNet 补充跨切片解剖连续性。</li><li class=\"lang-zh\">2D-to-3D 重排与 hybrid fusion 让两种上下文在统一体坐标中联合使用。</li><li class=\"lang-zh\">dense connections 强化特征复用和梯度流，但会增加 activation memory，尤其在 3D 分支。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Cascade a deep 2D DenseUNet for high-resolution in-plane representation with a 3D DenseUNet for volumetric context.</li><li class=\"lang-en bullet-en\">Architectural Delta: End-to-end joint Hybrid Feature Fusion (HFF) reconciling 2D transferability with 3D volumetric continuity.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Hybrid 2D Intra-Slice and 3D Inter-Slice Dense Feature Fusion.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">针对肝脏与肿瘤 CT 分割设计，是高分辨体数据中平衡 2D 细节和 3D 上下文的代表。</li><li class=\"lang-zh\">对非轴向各向异性、其他器官和现代 patch-based 3D 配置的优势需重新验证，不能直接外推。</li><li class=\"lang-en bullet-en\">Clinical Translation: Landmark hybrid 2.5D/3D architecture for volumetric CT liver and tumor segmentation.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Historically strong hybrid design; modern patch-based 3D nnU-Net and MedNeXt pipelines offer simpler reproducibility.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://doi.org/10.1109/TMI.2018.2845918\" rel=\"noreferrer\" target=\"_blank\">\n<span>H-DenseUNet: Hybrid Densely Connected UNet for Liver and Tumor Segmentation From CT Volumes</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/xmengli/H-DenseUNet\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}