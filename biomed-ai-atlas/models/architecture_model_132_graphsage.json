508\" xlink:href=\"#m132_g16-17\" y=\"-57.444602\"></use><use x=\"2.578878\" xlink:href=\"#m132_g7-185\" y=\"-62.388495\"></use><use x=\"5.691599\" xlink:href=\"#m132_g13-58\" y=\"-62.388495\"></use><use x=\"9.97886\" xlink:href=\"#m132_g7-0\" y=\"-62.388495\"></use><use x=\"14.895216\" xlink:href=\"#m132_g20-49\" y=\"-62.388495\"></use><use x=\"18.895219\" xlink:href=\"#m132_g7-186\" y=\"-62.388495\"></use><use x=\"2.178876\" xlink:href=\"#m132_g13-69\" y=\"-55.578704\"></use><use x=\"22.895074\" xlink:href=\"#m132_g10-107\" y=\"-57.444602\"></use><use x=\"29.038659\" xlink:href=\"#m132_g23-65\" y=\"-57.444602\"></use><use x=\"35.683739\" xlink:href=\"#m132_g23-71\" y=\"-57.444602\"></use><use x=\"42.876766\" xlink:href=\"#m132_g23-71\" y=\"-57.444602\"></use><use x=\"50.397067\" xlink:href=\"#m132_g13-58\" y=\"-55.950221\"></use><use x=\"55.389674\" xlink:href=\"#m132_g10-185\" y=\"-57.444602\"></use><use x=\"59.354797\" xlink:href=\"#m132_g10-102\" y=\"-57.444602\"></use><use x=\"64.057153\" xlink:href=\"#m132_g16-17\" y=\"-57.444602\"></use><use x=\"69.819539\" xlink:href=\"#m132_g7-185\" y=\"-62.388495\"></use><use x=\"72.932259\" xlink:href=\"#m132_g13-58\" y=\"-62.388495\"></use><use x=\"77.219521\" xlink:href=\"#m132_g7-0\" y=\"-62.388495\"></use><use x=\"82.135877\" xlink:href=\"#m132_g20-49\" y=\"-62.388495\"></use><use x=\"86.13588\" xlink:href=\"#m132_g7-186\" y=\"-62.388495\"></use><use x=\"69.237721\" xlink:href=\"#m132_g13-68\" y=\"-55.578704\"></use><use x=\"92.404933\" xlink:href=\"#m132_g23-58\" y=\"-57.444602\"></use><use x=\"97.911988\" xlink:href=\"#m132_g16-68\" y=\"-57.444602\"></use><use x=\"106.198631\" xlink:href=\"#m132_g10-50\" y=\"-57.444602\"></use><use x=\"114.505182\" xlink:href=\"#m132_g10-83\" y=\"-57.444602\"></use><use x=\"121.348024\" xlink:href=\"#m132_g13-58\" y=\"-55.950221\"></use><use x=\"126.340632\" xlink:href=\"#m132_g10-185\" y=\"-57.444602\"></use><use x=\"130.136397\" xlink:href=\"#m132_g16-69\" y=\"-57.444602\"></use><use x=\"135.008122\" xlink:href=\"#m132_g10-186\" y=\"-57.444602\"></use><use x=\"139.07286\" xlink:href=\"#m132_g10-103\" y=\"-57.444602\"></use><use x=\"143.416579\" xlink:href=\"#m132_g10-186\" y=\"-57.444602\"></use><use x=\"147.232255\" xlink:href=\"#m132_g10-188\" y=\"-57.444602\"></use><use x=\"151.346827\" xlink:href=\"#m132_g4-17\" y=\"-68.453307\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">谱 GCN 偏传导式且全邻居计算难扩展到新节点和大图</p><p class=\"cell-val cell-val-en lang-en\">Full-batch transductive GCNs required holding the entire graph Laplacian in memory and could not embed unseen test nodes without retraining.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">通过采样固定数量邻居并聚合其特征生成节点嵌入</p><p class=\"cell-val cell-val-en lang-en\">Learn aggregator functions over uniformly sampled fixed-size k-hop neighborhoods while explicitly concatenating a node's own previous state with its aggregated neighborhood.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">可学习聚合器支持 mini-batch、归纳迁移与未见节点</p><p class=\"cell-val cell-val-en lang-en\">Mini-batch neighborhood sampling bounding memory footprint + explicit self-feature concatenation preserving node identity against over-smoothing.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">用于患者相似图、细胞图、血管树和大规模病理图</p><p class=\"cell-val cell-val-en lang-en\">Enables scalable inductive training on million-cell whole-slide pathology graphs and dynamic clinical EHR cohorts.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">归纳 GNN 基础；邻居采样和构图偏差会直接影响医学结论</p><p class=\"cell-val cell-val-en lang-en\">Essential scalable inductive GNN; uniform random neighbor sampling can miss rare diagnostic hub cells if degree distributions are skewed.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">学习邻居聚合函数，而不是为训练图中的每个节点单独记 embedding。</li><li class=\"lang-zh\">固定 fan-out 采样把大图训练转为可控 mini-batch 计算。</li><li class=\"lang-zh\">自身与邻居表示显式拼接，使中心信息与局部上下文分工。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Learn aggregator functions over uniformly sampled fixed-size k-hop neighborhoods while explicitly concatenating a node's own previous state with its aggregated neighborhood.</li><li class=\"lang-en bullet-en\">Architectural Delta: Mini-batch neighborhood sampling bounding memory footprint + explicit self-feature concatenation preserving node identity against over-smoothing.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Fixed-Size Neighborhood Sampling &amp; Concatenated Self-vs-Neighbor Inductive Aggregation.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适用于患者相似图、病理细胞图、血管树和大规模生物网络。</li><li class=\"lang-zh\">采样会丢失稀有关键邻居，且临床图边的构造误差与群体偏差会被多层传播。</li><li class=\"lang-en bullet-en\">Clinical Translation: Enables scalable inductive training on million-cell whole-slide pathology graphs and dynamic clinical EHR cohorts.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Essential scalable inductive GNN; uniform random neighbor sampling can miss rare diagnostic hub cells if degree distributions are skewed.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://proceedings.neurips.cc/paper/2017/hash/5dd9db5e033da9c6fb5ba83c7a7ebea9-Abstract.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Inductive Representation Learning on Large Graphs</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/williamleif/GraphSAGE\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
