y=\"-58.816958\"></use><use x=\"138.325229\" xlink:href=\"#m094_g26-111\" y=\"-58.816958\"></use><use x=\"143.306549\" xlink:href=\"#m094_g26-103\" y=\"-58.816958\"></use><use x=\"149.948268\" xlink:href=\"#m094_g26-115\" y=\"-58.816958\"></use><use x=\"153.823735\" xlink:href=\"#m094_g26-111\" y=\"-58.816958\"></use><use x=\"158.805055\" xlink:href=\"#m094_g26-102\" y=\"-58.816958\"></use><use x=\"162.122616\" xlink:href=\"#m094_g26-116\" y=\"-58.816958\"></use><use x=\"164.892228\" xlink:href=\"#m094_g26-109\" y=\"-58.816958\"></use><use x=\"172.643161\" xlink:href=\"#m094_g26-97\" y=\"-58.816958\"></use><use x=\"177.066576\" xlink:href=\"#m094_g26-120\" y=\"-58.816958\"></use><use x=\"182.54603\" xlink:href=\"#m094_g13-185\" y=\"-58.816958\"></use><use x=\"186.10269\" xlink:href=\"#m094_g19-24\" y=\"-58.816958\"></use><use x=\"193.355476\" xlink:href=\"#m094_g10-62\" y=\"-62.931518\"></use><use x=\"199.270896\" xlink:href=\"#m094_g19-73\" y=\"-58.816958\"></use><use x=\"203.590697\" xlink:href=\"#m094_g16-66\" y=\"-57.322577\"></use><use x=\"207.568814\" xlink:href=\"#m094_g13-157\" y=\"-58.816958\"></use><use x=\"212.281138\" xlink:href=\"#m094_g19-103\" y=\"-58.816958\"></use><use x=\"217.362085\" xlink:href=\"#m094_g13-186\" y=\"-58.816958\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">实例级对比需要大量负样本且把语义相近图像当作负例</p><p class=\"cell-val cell-val-en lang-en\">Instance discrimination treated every distinct image as a negative, ignoring shared semantic clusters and scaling poorly.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">让不同增强视图预测彼此的在线 prototype 聚类分配</p><p class=\"cell-val cell-val-en lang-en\">Compute online soft cluster assignments over learnable prototypes using Sinkhorn-Knopp equipartition and predict view A's code from view B.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">用 balanced online clustering 与 multi-crop 训练学习可扩展表征</p><p class=\"cell-val cell-val-en lang-en\">Online balanced clustering + multi-crop augmentation strategy enabling memory-efficient small-batch SSL training.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">可用于大规模病理 patch 和放射影像无标签预训练</p><p class=\"cell-val cell-val-en lang-en\">Applied to large-scale unlabeled histopathology patch clustering and radiographic representation learning.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">聚类式 SSL 重要路线；prototype 数量与采样偏差需谨慎控制</p><p class=\"cell-val cell-val-en lang-en\">Foundational clustering-based SSL method; multi-crop strategy became standard in DINO and DINOv2.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">不同视图不直接做实例对比，而是互相预测在线聚类分配。</li><li class=\"lang-zh\">Sinkhorn 约束批内原型使用近似均衡，降低全部样本落入单一原型的坍塌。</li><li class=\"lang-zh\">多裁剪让局部区域与全局图像共享语义，同时控制计算量。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Compute online soft cluster assignments over learnable prototypes using Sinkhorn-Knopp equipartition and predict view A's code from view B.</li><li class=\"lang-en bullet-en\">Architectural Delta: Online balanced clustering + multi-crop augmentation strategy enabling memory-efficient small-batch SSL training.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Swapped Cross-View Prediction of Sinkhorn-Balanced Prototype Codes.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">可把病理局部 patch、放射图像局部视野与整图放进统一自监督训练。</li><li class=\"lang-zh\">均衡 prototype 是优化约束而非真实病种患病率，不能把原型直接解释为临床类别。</li><li class=\"lang-en bullet-en\">Clinical Translation: Applied to large-scale unlabeled histopathology patch clustering and radiographic representation learning.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Foundational clustering-based SSL method; multi-crop strategy became standard in DINO and DINOv2.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://proceedings.neurips.cc/paper/2020/hash/70feb62b69f16e0238f741fab228fec2-Abstract.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Unsupervised Learning of Visual Features by Contrasting Cluster Assignments</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/facebookresearch/swav\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
