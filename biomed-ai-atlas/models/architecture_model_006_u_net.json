{"html": "<header class=\"spec-title-strip\">\n<div class=\"spec-title-col\">\n<div class=\"spec-family-crumb\">\n            FAMILY 02 · <span class=\"lang-zh\">稠密预测与医学分割：从像素输出到自配置系统</span><span class=\"lang-en\">Dense Segmentation</span>\n</div>\n<h3 class=\"spec-model-title\" id=\"model_006_u_net-title\">U-Net</h3>\n<p class=\"spec-thesis-text lang-zh\">对称 U 形多尺度解码器与 encoder–decoder 同尺度 concat long skips。</p>\n<p class=\"spec-thesis-en lang-en\">Symmetric U-shaped multi-scale decoder coupled with same-scale encoder–decoder channel concatenation long skips.</p>\n</div>\n<div class=\"spec-tensor-col\">\n<div class=\"tensor-row\">\n<span class=\"tensor-kicker\">INPUT DOMAIN // 输入域</span>\n<span class=\"tensor-val lang-zh\">2D 生物医学图像</span>\n<span class=\"tensor-val tensor-val-en lang-en\">2D biomedical microscopy or radiological image</span>\n</div>\n<div class=\"tensor-row\">\n<span class=\"tensor-kicker\">OUTPUT TARGET // 输出目标</span>\n<span class=\"tensor-val lang-zh\">逐像素前景/多类别分割图</span>\n<span class=\"tensor-val tensor-val-en lang-en\">Pixel-accurate foreground or multi-class segmentation map</span>\n</div>\n</div>\n</header><div class=\"model-full-body\">\n<!-- Main Split: Original Figure Plate (Left) + Forward Computation Graph (Right) -->\n<div class=\"spec-blueprint-grid\">\n<section class=\"spec-figure-plate\">\n<div class=\"plate-header\">\n<div class=\"plate-header-left\">\n<span class=\"mono-kicker\">PRIMARY FIGURE // Figure 1 · PDF p.2</span>\n<h4 class=\"plate-title\">\n<span class=\"lang-zh\">论文原始架构图</span>\n<span class=\"lang-en\">Original Paper Architecture Diagram</span>\n</h4>\n</div>\n<div class=\"plate-header-right\">\n<a class=\"plate-source-link\" href=\"https://doi.org/10.1007/978-3-319-24574-4_28\" rel=\"noreferrer\" target=\"_blank\"><span>SOURCE PDF</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n<button class=\"plate-zoom-btn\" onclick=\"openLightbox('architecture_model_006_u_net')\" type=\"button\"><svg class=\"ui-icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\"><path d=\"M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7\"></path></svg><span>FULLSCREEN LIGHTBOX</span></button>\n</div>\n</div>\n<figure class=\"arch-figure-box\" onclick=\"openLightbox('architecture_model_006_u_net')\" title=\"Click to open interactive pan &amp; zoom viewer\">\n<img alt=\"U-Net original paper architecture figure, Figure 1\" class=\"arch-figure-img\" decoding=\"async\" loading=\"lazy\" src=\"assets/6416c4c4d626d329ec7e.avif\"/>\n<figcaption class=\"plate-caption\">CLICK FIGURE TO OPEN INTERACTIVE PAN &amp; ZOOM VIEWER · Figure 1 · PDF p.2</figcaption>\n</figure>\n</section>\n<aside class=\"spec-circuit-panel\">\n<div class=\"circuit-header\">\n<div>\n<span class=\"mono-kicker\">COMPUTATION GRAPH // 8 STAGES</span>\n<h4 class=\"plate-title\">\n<span class=\"lang-zh\">架构前向计算节点拆解</span>\n<span class=\"lang-en\">Forward Pass Computation Nodes</span>\n</h4>\n</div>\n<div class=\"circuit-controls\">\n<button class=\"circuit-btn\" onclick=\"stepArchNode('architecture_model_006_u_net', -1)\" title=\"Previous Stage\" type=\"button\">◁</button>\n<button class=\"circuit-btn circuit-play-btn\" data-play-id=\"architecture_model_006_u_net\" onclick=\"toggleAutoPlayNodes('architecture_model_006_u_net')\" title=\"Auto-Trace Computation Graph\" type=\"button\">AUTO</button>\n<button class=\"circuit-btn\" onclick=\"stepArchNode('architecture_model_006_u_net', 1)\" title=\"Next Stage\" type=\"button\">▷</button>\n</div>\n</div>\n<div class=\"active-node-spotlight\" id=\"spotlight-architecture_model_006_u_net\">\n<span class=\"spotlight-badge\">\n                STAGE 01 / 08 · <span class=\"lang-zh\">输入图像</span><span class=\"lang-en\">Input Image</span>\n</span>\n<span class=\"spotlight-text lang-zh\">原始实现结合强弹性形变增强以扩充少标注数据。</span>\n<span class=\"spotlight-text spotlight-text-en lang-en\">Ingests 2d biomedical microscopy or radiological image and prepares initial tensor representations (Input Image).</span>\n</div>\n<ol class=\"circuit-timeline\">\n<li class=\"circuit-node active\" data-node-desc=\"原始实现结合强弹性形变增强以扩充少标注数据。\" data-node-desc-en=\"Ingests 2d biomedical microscopy or radiological image and prepares initial tensor representations (Input Image).\" data-node-idx=\"0\" data-node-name=\"输入图像\" data-node-name-en=\"Input Image\" onclick=\"selectArchNode('architecture_model_006_u_net', 0)\"><span class=\"circuit-idx\">01</span><div class=\"circuit-body\"><strong class=\"circuit-title\"><span class=\"lang-zh\">输入图像</span><span class=\"lang-en\">Input Image</span></strong><span class=\"circuit-desc lang-zh\">原始实现结合强弹性形变增强以扩充少标注数据。</span><span class=\"circuit-desc circuit-desc-en lang-en\">Ingests 2d biomedical microscopy or radiological image and prepares initial tensor representations (Input Image).</span></div></li><li class=\"circuit-node\" data-node-desc=\"重复 3×3 Conv 提取边缘、纹理与小结构位置。\" data-node-desc-en=\"Executes Encoder to extract primary structural features and establish spatial/sequence encoding.\" data-node-idx=\"1\" data-node-name=\"高分辨率 Encoder\" data-node-name-en=\"Encoder\" onclick=\"selectArchNode('architecture_model_006_u_net', 1)\"><span class=\"circuit-idx\">02</span><div class=\"circuit-body\"><strong class=\"circuit-title\"><span class=\"lang-zh\">高分辨率 Encoder</span><span class=\"lang-en\">Encoder</span></strong><span class=\"circuit-desc lang-zh\">重复 3×3 Conv 提取边缘、纹理与小结构位置。</span><span class=\"circuit-desc circuit-desc-en lang-en\">Executes Encoder to extract primary structural features and establish spatial/sequence encoding.</span></div></li><li class=\"circuit-node\" data-node-desc=\"max pooling 逐级扩大视野并增加通道。\" data-node-desc-en=\"Performs downsampling within the core u shaped encoder decoder computation pathway.\" data-node-idx=\"2\" data-node-name=\"下采样金字塔\" data-node-name-en=\"downsampling\" onclick=\"selectArchNode('architecture_model_006_u_net', 2)\"><span class=\"circuit-idx\">03</span><div class=\"circuit-body\"><strong class=\"circuit-title\"><span class=\"lang-zh\">下采样金字塔</span><span class=\"lang-en\">downsampling</span></strong><span class=\"circuit-desc lang-zh\">max pooling 逐级扩大视野并增加通道。</span><span class=\"circuit-desc circuit-desc-en lang-en\">Performs downsampling within the core u shaped encoder decoder computation pathway.</span></div></li><li class=\"circuit-node\" data-node-desc=\"最低分辨率层编码大范围上下文与任务语义。\" data-node-desc-en=\"Performs Stage 04 within the core u shaped encoder decoder computation pathway.\" data-node-idx=\"3\" data-node-name=\"语义瓶颈\" data-node-name-en=\"Stage 04\" onclick=\"selectArchNode('architecture_model_006_u_net', 3)\"><span class=\"circuit-idx\">04</span><div class=\"circuit-body\"><strong class=\"circuit-title\"><span class=\"lang-zh\">语义瓶颈</span><span class=\"lang-en\">Stage 04</span></strong><span class=\"circuit-desc lang-zh\">最低分辨率层编码大范围上下文与任务语义。</span><span class=\"circuit-desc circuit-desc-en lang-en\">Performs Stage 04 within the core u shaped encoder decoder computation pathway.</span></div></li><li class=\"circuit-node\" data-node-desc=\"转置卷积提升空间分辨率并降低通道。\" data-node-desc-en=\"Performs Up-conv within the core u shaped encoder decoder computation pathway.\" data-node-idx=\"4\" data-node-name=\"Up-conv\" data-node-name-en=\"Up-conv\" onclick=\"selectArchNode('architecture_model_006_u_net', 4)\"><span class=\"circuit-idx\">05</span><div class=\"circuit-body\"><strong class=\"circuit-title\"><span>Up-conv</span></strong><span class=\"circuit-desc lang-zh\">转置卷积提升空间分辨率并降低通道。</span><span class=\"circuit-desc circuit-desc-en lang-en\">Performs Up-conv within the core u shaped encoder decoder computation pathway.</span></div></li><li class=\"circuit-node\" data-node-desc=\"裁剪/对齐 encoder 特征后与 decoder 特征按通道拼接。\" data-node-desc-en=\"Performs Concat within the core u shaped encoder decoder computation pathway.\" data-node-idx=\"5\" data-node-name=\"同尺度 Concat\" data-node-name-en=\"Concat\" onclick=\"selectArchNode('architecture_model_006_u_net', 5)\"><span class=\"circuit-idx\">06</span><div class=\"circuit-body\"><strong class=\"circuit-title\"><span class=\"lang-zh\">同尺度 Concat</span><span class=\"lang-en\">Concat</span></strong><span class=\"circuit-desc lang-zh\">裁剪/对齐 encoder 特征后与 decoder 特征按通道拼接。</span><span class=\"circuit-desc circuit-desc-en lang-en\">Performs Concat within the core u shaped encoder decoder computation pathway.</span></div></li><li class=\"circuit-node\" data-node-desc=\"融合定位与语义后逐级细化边界。\" data-node-desc-en=\"Applies Decoder Conv to project aggregated representations toward the target task head.\" data-node-idx=\"6\" data-node-name=\"Decoder Conv\" data-node-name-en=\"Decoder Conv\" onclick=\"selectArchNode('architecture_model_006_u_net', 6)\"><span class=\"circuit-idx\">07</span><div class=\"circuit-body\"><strong class=\"circuit-title\"><span>Decoder Conv</span></strong><span class=\"circuit-desc lang-zh\">融合定位与语义后逐级细化边界。</span><span class=\"circuit-desc circuit-desc-en lang-en\">Applies Decoder Conv to project aggregated representations toward the target task head.</span></div></li><li class=\"circuit-node\" data-node-desc=\"将最终特征映射为每像素类别 logits。\" data-node-desc-en=\"Produces pixel-accurate foreground or multi-class segmentation map via 1×1.\" data-node-idx=\"7\" data-node-name=\"1×1 分割头\" data-node-name-en=\"1×1\" onclick=\"selectArchNode('architecture_model_006_u_net', 7)\"><span class=\"circuit-idx\">08</span><div class=\"circuit-body\"><strong class=\"circuit-title\"><span class=\"lang-zh\">1×1 分割头</span><span class=\"lang-en\">1×1</span></strong><span class=\"circuit-desc lang-zh\">将最终特征映射为每像素类别 logits。</span><span class=\"circuit-desc circuit-desc-en lang-en\">Produces pixel-accurate foreground or multi-class segmentation map via 1×1.</span></div></li>\n</ol>\n</aside>\n</div>\n<!-- Mathematical Formalism Band -->\n<section aria-label=\"U-Net Mathematical Formalism\" class=\"spec-math-band\">\n<div class=\"math-meta-col\">\n<span class=\"mono-kicker\">MATHEMATICAL FORMALISM</span>\n<div class=\"math-title-text lang-zh\">核心公式 · U-Net 同尺度编码特征拼接到解码器</div>\n<div class=\"math-title-en lang-en\">Core Formalism · U-Net Same-Scale Feature Concatenation Across Contraction and Expansion Paths</div>\n</div>\n<div aria-label=\"U-Net：核心公式 · U-Net 同尺度编码特征拼接到解码器\" class=\"tex-formula-vector\" role=\"img\">\n<svg aria-hidden=\"true\" data-formula-index=\"6\" focusable=\"false\" height=\"9.285285pt\" preserveaspectratio=\"xMidYMid meet\" style=\"display:block;width:auto;max-width:100%;height:auto;max-height:96px;margin:0 auto\" version=\"1.1\" viewbox=\"-68.613269 -69.079189 114.154883 9.285285\" width=\"114.154883pt\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><defs><use id=\"m006_g7-185\" transform=\"scale(1.369862)\" xlink:href=\"#m006_g4-185\"></use><use id=\"m006_g7-186\" transform=\"scale(1.369862)\" xlink:href=\"#m006_g4-186\"></use><use id=\"m006_g7-187\" transform=\"scale(1.369862)\" xlink:href=\"#m006_g4-187\"></use><use id=\"m006_g7-188\" transform=\"scale(1.369862)\" xlink:href=\"#m006_g4-188\"></use><path d=\"M5.697191-3.275389V-3.831212H.615376V-3.275389H5.697191ZM5.697191-1.260528V-1.816352H.615376V-1.260528H5.697191Z\" id=\"m006_g1-61\"></path><path d=\"M4.714574-1.002467L4.595469-1.101722C4.049571-.47642 3.950317-.397017 3.781585-.397017C3.682331-.397017 3.602927-.47642 3.602927-.595525C3.602927-.754332 3.910615-1.915606 4.24808-3.037178L5.230696-6.729435L5.181069-6.779062C4.655022-6.669882 4.297707-6.61033 3.66248-6.550777V-6.382045C4.208378-6.362194 4.277856-6.332418 4.277856-6.123984C4.277856-5.985028 4.267931-5.955252 4.128975-5.429205L3.692256-3.801436C3.612853-4.218303 3.434195-4.37711 3.047104-4.37711C1.756799-4.37711 .148881-2.511131 .148881-1.022318C.148881-.317613 .545898 .10918 1.19105 .10918C1.865979