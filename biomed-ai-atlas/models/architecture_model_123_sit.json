6614\" xlink:href=\"#m123_g2-61\" y=\"-59.987571\"></use><use x=\"122.210182\" xlink:href=\"#m123_g0-69\" y=\"-59.987571\"></use><use x=\"128.79549\" xlink:href=\"#m123_g5-107\" y=\"-59.987571\"></use><use x=\"133.358381\" xlink:href=\"#m123_g11-69\" y=\"-59.987571\"></use><use x=\"138.921017\" xlink:href=\"#m123_g8-92\" y=\"-58.49319\"></use><use x=\"144.197278\" xlink:href=\"#m123_g5-185\" y=\"-59.987571\"></use><use x=\"147.913339\" xlink:href=\"#m123_g11-71\" y=\"-59.987571\"></use><use x=\"152.671994\" xlink:href=\"#m123_g8-67\" y=\"-58.49319\"></use><use x=\"156.115561\" xlink:href=\"#m123_g11-150\" y=\"-59.987571\"></use><use x=\"160.336347\" xlink:href=\"#m123_g11-67\" y=\"-59.987571\"></use><use x=\"163.683789\" xlink:href=\"#m123_g5-186\" y=\"-59.987571\"></use><use x=\"169.713331\" xlink:href=\"#m123_g5-0\" y=\"-59.987571\"></use><use x=\"178.343138\" xlink:href=\"#m123_g11-69\" y=\"-59.987571\"></use><use x=\"182.931229\" xlink:href=\"#m123_g8-162\" y=\"-64.102131\"></use><use x=\"183.251227\" xlink:href=\"#m123_g8-67\" y=\"-57.526813\"></use><use x=\"188.865671\" xlink:href=\"#m123_g5-107\" y=\"-59.987571\"></use><use x=\"193.348857\" xlink:href=\"#m123_g15-50\" y=\"-64.102131\"></use><use x=\"193.348857\" xlink:href=\"#m123_g15-50\" y=\"-56.961428\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">扩散与流匹配实现分散，目标和采样路径的关系难系统比较</p><p class=\"cell-val cell-val-en lang-en\">Comparisons between diffusion and flow matching conflated backbone architecture (U-Net vs. DiT), noise schedules, and ODE vs. SDE sampling.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">以 stochastic interpolants 统一 diffusion 与 flow objectives，并用 Transformer 扩展生成</p><p class=\"cell-val cell-val-en lang-en\">Use the Scalable Interpolant Transformer (SiT) to modularly ablate path interpolants (linear vs. trig), prediction targets (velocity vs. score), and diffusion coefficients.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">在统一连续时间框架中选择插值、预测参数化和损失权重</p><p class=\"cell-val cell-val-en lang-en\">Demonstrates that linear stochastic interpolants with velocity prediction and tunable SDE diffusion coefficients consistently outperform rigid DDPM schedules.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">适合比较医学 latent/3D diffusion 与 flow matching 的训练设计</p><p class=\"cell-val cell-val-en lang-en\">Provides a clean modern recipe for training 2D/3D medical latent transformers across both ODE flow and SDE diffusion regimes.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">生成建模重要统一视角；医学保真和逆问题证据仍早期</p><p class=\"cell-val cell-val-en lang-en\">Important unifying generative framework; medical inverse-problem conditioning and quantitative audits remain active extensions.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">stochastic interpolants 用一套连续时间公式容纳 diffusion 与 flow。</li><li class=\"lang-zh\">插值路径、预测量和损失权重可分别选择，而不是被单一 DDPM 参数化绑定。</li><li class=\"lang-zh\">采用 DiT 式 Transformer 扩展模型容量，再用 ODE 或 SDE 求解。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Use the Scalable Interpolant Transformer (SiT) to modularly ablate path interpolants (linear vs. trig), prediction targets (velocity vs. score), and diffusion coefficients.</li><li class=\"lang-en bullet-en\">Architectural Delta: Demonstrates that linear stochastic interpolants with velocity prediction and tunable SDE diffusion coefficients consistently outperform rigid DDPM schedules.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Stochastic Interpolant x_t = α_t x_0 + σ_t ε Unifying Velocity &amp; Score Parameterizations.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">便于在相同 Transformer 骨架下公平比较医学 diffusion 与 flow matching 设计。</li><li class=\"lang-zh\">采样步数、guidance、3D 显存和条件泄漏都会影响临床可用性，生成质量不能替代病例级真实性验证。</li><li class=\"lang-en bullet-en\">Clinical Translation: Provides a clean modern recipe for training 2D/3D medical latent transformers across both ODE flow and SDE diffusion regimes.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Important unifying generative framework; medical inverse-problem conditioning and quantitative audits remain active extensions.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://www.ecva.net/papers/eccv_2024/papers_ECCV/papers/09828.pdf\" rel=\"noreferrer\" target=\"_blank\">\n<span>SiT: Exploring Flow and Diffusion-Based Generative Models with Scalable Interpolant Transformers</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/willisma/SiT\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}