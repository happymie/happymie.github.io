 width=\"9.457515\" x=\"18.331759\" y=\"-68.164397\"></rect><use x=\"19.880942\" xlink:href=\"#m058_g21-22\" y=\"-58.675779\"></use><use x=\"18.401497\" xlink:href=\"#m058_g14-85\" y=\"-58.675779\"></use><use x=\"24.345711\" xlink:href=\"#m058_g11-67\" y=\"-57.181398\"></use><use x=\"28.028379\" xlink:href=\"#m058_g14-73\" y=\"-58.675779\"></use><use x=\"32.202722\" xlink:href=\"#m058_g18-48\" y=\"-57.181398\"></use><use x=\"38.551078\" xlink:href=\"#m058_g8-184\" y=\"-58.675779\"></use><use x=\"47.10118\" xlink:href=\"#m058_g5-112\" y=\"-67.895401\"></use><rect height=\".557905\" width=\"25.202792\" x=\"54.393824\" y=\"-68.453307\"></rect><use x=\"54.393824\" xlink:href=\"#m058_g21-49\" y=\"-58.675779\"></use><use x=\"61.58901\" xlink:href=\"#m058_g8-0\" y=\"-58.675779\"></use><use x=\"71.688296\" xlink:href=\"#m058_g21-22\" y=\"-58.675779\"></use><use x=\"70.20885\" xlink:href=\"#m058_g14-85\" y=\"-58.675779\"></use><use x=\"76.153065\" xlink:href=\"#m058_g11-67\" y=\"-57.181398\"></use><use x=\"81.286906\" xlink:href=\"#m058_g14-110\" y=\"-58.675779\"></use><use x=\"86.078922\" xlink:href=\"#m058_g14-150\" y=\"-58.675779\"></use><use x=\"100.501454\" xlink:href=\"#m058_g8-76\" y=\"-58.675779\"></use><use x=\"111.238887\" xlink:href=\"#m058_g2-61\" y=\"-58.675779\"></use><use x=\"120.342455\" xlink:href=\"#m058_g0-69\" y=\"-58.675779\"></use><use x=\"127.326268\" xlink:href=\"#m058_g5-2\" y=\"-66.795309\"></use><use x=\"131.341205\" xlink:href=\"#m058_g8-107\" y=\"-58.675779\"></use><use x=\"135.854282\" xlink:href=\"#m058_g14-110\" y=\"-58.675779\"></use><use x=\"142.860164\" xlink:href=\"#m058_g8-0\" y=\"-58.675779\"></use><use x=\"151.440156\" xlink:href=\"#m058_g14-110\" y=\"-58.675779\"></use><use x=\"156.315377\" xlink:href=\"#m058_g11-92\" y=\"-57.181398\"></use><use x=\"161.591638\" xlink:href=\"#m058_g8-185\" y=\"-58.675779\"></use><use x=\"165.546804\" xlink:href=\"#m058_g14-73\" y=\"-58.675779\"></use><use x=\"169.757511\" xlink:href=\"#m058_g11-67\" y=\"-57.181398\"></use><use x=\"173.201078\" xlink:href=\"#m058_g14-150\" y=\"-58.675779\"></use><use x=\"177.421864\" xlink:href=\"#m058_g14-67\" y=\"-58.675779\"></use><use x=\"180.769306\" xlink:href=\"#m058_g14-150\" y=\"-58.675779\"></use><use x=\"185.139526\" xlink:href=\"#m058_g14-50\" y=\"-58.675779\"></use><use x=\"189.856839\" xlink:href=\"#m058_g8-186\" y=\"-58.675779\"></use><use x=\"194.170649\" xlink:href=\"#m058_g8-107\" y=\"-58.675779\"></use><use x=\"198.653835\" xlink:href=\"#m058_g18-50\" y=\"-62.790339\"></use><use x=\"198.653835\" xlink:href=\"#m058_g18-50\" y=\"-55.649636\"></use><use x=\"202.987582\" xlink:href=\"#m058_g5-3\" y=\"-66.795309\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">pixel-space diffusion 在高分辨率和 3D 上计算过重</p><p class=\"cell-val cell-val-en lang-en\">Pixel-space diffusion scaled poorly in compute and VRAM on high-resolution 2D images and 3D medical volumes.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">先用 autoencoder 压缩图像，再在 latent grid 上扩散并以 cross-attention 条件化</p><p class=\"cell-val cell-val-en lang-en\">Separate perceptual high-frequency compression (autoencoder) from semantic generative modeling (diffusion U-Net in latent space) with cross-attention conditioning.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">用较小空间网格建模语义，支持更大 backbone 与多模态条件</p><p class=\"cell-val cell-val-en lang-en\">Dramatic spatial token reduction (e.g., 8× downsampling per axis) + flexible cross-attention conditioning mechanism.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">用于医学合成、跨模态 translation 和高分辨生成</p><p class=\"cell-val cell-val-en lang-en\">Dominant architecture for high-resolution 2D/3D medical image synthesis, report-to-image generation, and synthetic data augmentation.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">现实的大模型路线；autoencoder ceiling 可能丢微钙化、小血管和定量强度</p><p class=\"cell-val cell-val-en lang-en\">Pragmatic scaling route; the frozen first-stage autoencoder sets an upper bound on fidelity and can bottleneck tiny micro-lesions or quantitative HU values.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">把感知压缩与生成建模解耦，使扩散主干在更小的 latent 网格上运行。</li><li class=\"lang-zh\">cross-attention 提供统一条件接口，可接文本、类别或其他模态 token。</li><li class=\"lang-zh\">生成上限受 autoencoder reconstruction ceiling 限制；latent 中已丢失的信息无法由数据一致性自动恢复。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Separate perceptual high-frequency compression (autoencoder) from semantic generative modeling (diffusion U-Net in latent space) with cross-attention conditioning.</li><li class=\"lang-en bullet-en\">Architectural Delta: Dramatic spatial token reduction (e.g., 8× downsampling per axis) + flexible cross-attention conditioning mechanism.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Conditional Denoising Diffusion Inside a Perceptually Compressed Autoencoder Latent Space.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合高分辨医学合成与跨模态研究，并显著降低像素空间 diffusion 的内存和计算。</li><li class=\"lang-zh\">微钙化、小血管、薄壁和定量强度可能在 VAE 压缩阶段消失，必须先审计 autoencoder 重建误差。</li><li class=\"lang-en bullet-en\">Clinical Translation: Dominant architecture for high-resolution 2D/3D medical image synthesis, report-to-image generation, and synthetic data augmentation.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Pragmatic scaling route; the frozen first-stage autoencoder sets an upper bound on fidelity and can bottleneck tiny micro-lesions or quantitative HU values.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openaccess.thecvf.com/content/CVPR2022/html/Rombach_High-Resolution_Image_Synthesis_With_Latent_Diffusion_Models_CVPR_2022_paper.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>High-Resolution Image Synthesis with Latent Diffusion Models</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/CompVis/latent-diffusion\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}