"-55.950221\"></use><use x=\"86.748833\" xlink:href=\"#m124_g20-49\" y=\"-55.950221\"></use><use x=\"90.883311\" xlink:href=\"#m124_g10-186\" y=\"-57.444602\"></use><use x=\"94.898244\" xlink:href=\"#m124_g4-17\" y=\"-68.453307\"></use><use x=\"100.9023\" xlink:href=\"#m124_g16-150\" y=\"-57.444602\"></use><use x=\"115.324831\" xlink:href=\"#m124_g10-76\" y=\"-57.444602\"></use><use x=\"123.313366\" xlink:href=\"#m124_g13-58\" y=\"-55.950221\"></use><use x=\"130.575172\" xlink:href=\"#m124_g1-61\" y=\"-57.444602\"></use><use x=\"139.67874\" xlink:href=\"#m124_g10-0\" y=\"-57.444602\"></use><use x=\"147.675376\" xlink:href=\"#m124_g23-78\" y=\"-57.444602\"></use><use x=\"154.718954\" xlink:href=\"#m124_g23-67\" y=\"-57.444602\"></use><use x=\"161.364034\" xlink:href=\"#m124_g23-67\" y=\"-57.444602\"></use><use x=\"168.507247\" xlink:href=\"#m124_g10-185\" y=\"-57.444602\"></use><use x=\"172.631779\" xlink:href=\"#m124_g16-30\" y=\"-57.444602\"></use><use x=\"177.003867\" xlink:href=\"#m124_g13-58\" y=\"-61.559162\"></use><use x=\"177.480589\" xlink:href=\"#m124_g13-53\" y=\"-54.36393\"></use><use x=\"181.520535\" xlink:href=\"#m124_g16-150\" y=\"-57.444602\"></use><use x=\"186.189641\" xlink:href=\"#m124_g16-30\" y=\"-57.444602\"></use><use x=\"190.561728\" xlink:href=\"#m124_g13-58\" y=\"-61.559162\"></use><use x=\"189.802093\" xlink:href=\"#m124_g13-60\" y=\"-54.983844\"></use><use x=\"198.514075\" xlink:href=\"#m124_g10-14\" y=\"-57.444602\"></use><use x=\"205.928433\" xlink:href=\"#m124_g16-113\" y=\"-57.444602\"></use><use x=\"211.934418\" xlink:href=\"#m124_g13-58\" y=\"-55.950221\"></use><use x=\"216.428891\" xlink:href=\"#m124_g10-186\" y=\"-57.444602\"></use><use x=\"222.458433\" xlink:href=\"#m124_g10-184\" y=\"-57.444602\"></use><use x=\"230.879025\" xlink:href=\"#m124_g16-95\" y=\"-57.444602\"></use><use x=\"236.891473\" xlink:href=\"#m124_g10-107\" y=\"-57.444602\"></use><use x=\"241.474287\" xlink:href=\"#m124_g10-114\" y=\"-57.444602\"></use><use x=\"248.438156\" xlink:href=\"#m124_g16-113\" y=\"-57.444602\"></use><use x=\"254.44414\" xlink:href=\"#m124_g13-58\" y=\"-55.950221\"></use><use x=\"259.436748\" xlink:href=\"#m124_g10-107\" y=\"-57.444602\"></use><use x=\"263.919934\" xlink:href=\"#m124_g20-50\" y=\"-61.559162\"></use><use x=\"263.919934\" xlink:href=\"#m124_g20-50\" y=\"-54.418459\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">单尺度配准捕获范围有限，大形变时易落入局部最优</p><p class=\"cell-val cell-val-en lang-en\">Single-scale 3D registration networks failed on large respiratory or inter-subject displacements due to local minima and limited receptive fields.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">在由粗到细的图像金字塔上逐级预测并组合位移场</p><p class=\"cell-val cell-val-en lang-en\">Solve registration progressively from 1/4 → 1/2 → 1/1 resolution using feature-skip pyramid networks that predict incremental residual warps.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">每级以前一级形变为初始化，兼顾大位移捕获和局部精化</p><p class=\"cell-val cell-val-en lang-en\">Coarse-to-fine residual warping + warm-start curriculum training + optional scaling-and-squaring diffeomorphic parameterization.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">用于 3D 脑、腹部和胸部 CT/MRI 快速无监督配准</p><p class=\"cell-val cell-val-en lang-en\">Widely used benchmark baseline for large-deformation lung CT inspiration–expiration and brain MRI registration.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">经典 coarse-to-fine 学习式基线；可逆性与拓扑保持仍需额外约束</p><p class=\"cell-val cell-val-en lang-en\">Classic multi-scale registration architecture; subsequent GradICON/uniGradICON offer stronger inverse-consistency guarantees.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">低分辨率先捕获大位移，高分辨率只需预测局部残差。</li><li class=\"lang-zh\">每层把前一级形变场上采样并用于 warp，使级联具有明确初始化。</li><li class=\"lang-zh\">训练不需真实形变标签，以图像相似度和场平滑正则优化。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Solve registration progressively from 1/4 → 1/2 → 1/1 resolution using feature-skip pyramid networks that predict incremental residual warps.</li><li class=\"lang-en bullet-en\">Architectural Delta: Coarse-to-fine residual warping + warm-start curriculum training + optional scaling-and-squaring diffeomorphic parameterization.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Multi-Resolution Laplacian Pyramid Residual Displacement Composition.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合 3D 脑、腹部和胸部 CT/MRI 的快速大形变配准。</li><li class=\"lang-zh\">相似度变好不保证解剖对应正确；需报告 Jacobian folding、TRE/landmark 与跨模态鲁棒性。</li><li class=\"lang-en bullet-en\">Clinical Translation: Widely used benchmark baseline for large-deformation lung CT inspiration–expiration and brain MRI registration.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Classic multi-scale registration architecture; subsequent GradICON/uniGradICON offer stronger inverse-consistency guarantees.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://arxiv.org/abs/2006.16148\" rel=\"noreferrer\" target=\"_blank\">\n<span>Laplacian Pyramid Networks for Fast Deformable Registration of Large Deformation</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/cwmok/LapIRN\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}