\"-55.950221\"></use><use x=\"159.557399\" xlink:href=\"#m101_g10-185\" y=\"-57.459545\"></use><use x=\"163.671962\" xlink:href=\"#m101_g16-72\" y=\"-57.444602\"></use><use x=\"168.530247\" xlink:href=\"#m101_g13-67\" y=\"-55.950221\"></use><use x=\"175.139651\" xlink:href=\"#m101_g10-106\" y=\"-57.444602\"></use><use x=\"180.69652\" xlink:href=\"#m101_g16-72\" y=\"-57.444602\"></use><use x=\"185.671167\" xlink:href=\"#m101_g13-159\" y=\"-55.950221\"></use><use x=\"190.812985\" xlink:href=\"#m101_g13-67\" y=\"-55.950221\"></use><use x=\"194.256546\" xlink:href=\"#m101_g16-150\" y=\"-57.444602\"></use><use x=\"199.114943\" xlink:href=\"#m101_g10-187\" y=\"-57.444602\"></use><use x=\"202.701471\" xlink:href=\"#m101_g16-68\" y=\"-57.444602\"></use><use x=\"208.021525\" xlink:href=\"#m101_g23-59\" y=\"-57.444602\"></use><use x=\"212.730489\" xlink:href=\"#m101_g16-26\" y=\"-57.444602\"></use><use x=\"219.093625\" xlink:href=\"#m101_g13-41\" y=\"-55.950221\"></use><use x=\"225.188056\" xlink:href=\"#m101_g10-185\" y=\"-57.444602\"></use><use x=\"229.053559\" xlink:href=\"#m101_g16-64\" y=\"-57.444602\"></use><use x=\"234.433384\" xlink:href=\"#m101_g10-186\" y=\"-57.444602\"></use><use x=\"238.24906\" xlink:href=\"#m101_g10-188\" y=\"-57.444602\"></use><use x=\"242.164374\" xlink:href=\"#m101_g10-186\" y=\"-57.459545\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">多数医学 VLM 只支持单张 2D 图像且任务和模态碎片化</p><p class=\"cell-val cell-val-en lang-en\">Most medical MLLMs accepted only single 2D slices, failing to ingest volumetric 3D CT/MRI studies natively.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">统一编码 2D 图像、3D 体积和文本，并以自回归 LLM 完成放射学多任务</p><p class=\"cell-val cell-val-en lang-en\">Encode both 2D images and 3D volumetric patches into unified visual tokens compressed by a Perceiver resampler before an autoregressive LLM.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">引入可变长度 3D visual tokens 与跨模态指令数据</p><p class=\"cell-val cell-val-en lang-en\">Unified 2D/3D visual tokenization + RadMD 16M multi-modal radiology instruction dataset + RadBench evaluation.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">覆盖 CT、MRI、X-ray 等问答、报告与识别任务</p><p class=\"cell-val cell-val-en lang-en\">Addresses multi-modality radiology VQA, report generation, and disease triage across X-ray, CT, and MRI.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">通用放射模型 proof-of-concept；外部临床可靠性和幻觉仍是核心风险</p><p class=\"cell-val cell-val-en lang-en\">Important 3D-capable radiology MLLM proof-of-concept; hallucination rates and external clinical calibration remain critical hurdles.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">视觉 encoder 同时容纳 2D 与 3D 扫描，而不是为每个模态建立孤立系统。</li><li class=\"lang-zh\">Perceiver 将跨切片、跨时间或跨模态的可变长度特征压成固定 token。</li><li class=\"lang-zh\">用 LLM 把识别、问答和报告统一为条件文本生成。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Encode both 2D images and 3D volumetric patches into unified visual tokens compressed by a Perceiver resampler before an autoregressive LLM.</li><li class=\"lang-en bullet-en\">Architectural Delta: Unified 2D/3D visual tokenization + RadMD 16M multi-modal radiology instruction dataset + RadBench evaluation.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Unified 2D/3D Visual Token Perceiver Aggregation for Generative Radiology LLM.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">能在 CT、MRI、X-ray 等混合任务间共享视觉语言接口。</li><li class=\"lang-zh\">固定 token 压缩可能丢失微小三维病灶，且生成正确性不能由语言流畅度替代。</li><li class=\"lang-en bullet-en\">Clinical Translation: Addresses multi-modality radiology VQA, report generation, and disease triage across X-ray, CT, and MRI.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Important 3D-capable radiology MLLM proof-of-concept; hallucination rates and external clinical calibration remain critical hurdles.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://doi.org/10.1038/s41467-025-62385-7\" rel=\"noreferrer\" target=\"_blank\">\n<span>Towards Generalist Foundation Model for Radiology by Leveraging Web-scale 2D&amp;3D Medical Data</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/chaoyi-wu/RadFM\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
