300174-.526047 5.736893-2.01486L6.560702-4.843605C6.937868-6.133909 6.97757-6.183537 7.592946-6.322492Z\" id=\"m005_g7-42\"></path><path d=\"M5.697191-3.275389V-3.831212H.615376V-3.275389H5.697191ZM5.697191-1.260528V-1.816352H.615376V-1.260528H5.697191Z\" id=\"m005_g1-61\"></path><path d=\"M2.828745-2.878372H.615376V-2.223294H2.828745V0H3.483822V-2.223294H5.697191V-2.878372H3.483822V-5.101666H2.828745V-2.878372Z\" id=\"m005_g4-184\"></path><path d=\"M2.927999-7.116526C1.488813-6.183537 .47642-4.575619 .47642-2.550833C.47642-.704705 1.528515 1.161274 2.898223 2.004935L3.017328 1.846128C1.707172 .813884 1.330006-.387091 1.330006-2.580609C1.330006-4.784052 1.736948-5.925476 3.017328-6.957719L2.927999-7.116526Z\" id=\"m005_g4-185\"></path><path d=\"M.377166-7.116526L.287837-6.957719C1.568216-5.925476 1.975159-4.784052 1.975159-2.580609C1.975159-.387091 1.597993 .813884 .287837 1.846128L.406942 2.004935C1.77665 1.161274 2.828745-.704705 2.828745-2.550833C2.828745-4.575619 1.816352-6.183537 .377166-7.116526Z\" id=\"m005_g4-186\"></path></defs><g id=\"m005_page1\"><use x=\"-68.811955\" xlink:href=\"#m005_g7-40\" y=\"-61.947719\"></use><use x=\"-63.571615\" xlink:href=\"#m005_g11-56\" y=\"-60.453338\"></use><use x=\"-59.93525\" xlink:href=\"#m005_g11-115\" y=\"-60.453338\"></use><use x=\"-53.840711\" xlink:href=\"#m005_g1-61\" y=\"-61.947719\"></use><use x=\"-45.085834\" xlink:href=\"#m005_g7-42\" y=\"-61.947719\"></use><use x=\"-37.892806\" xlink:href=\"#m005_g11-56\" y=\"-60.453338\"></use><use x=\"-33.260183\" xlink:href=\"#m005_g4-185\" y=\"-61.962663\"></use><use x=\"-29.255205\" xlink:href=\"#m005_g7-37\" y=\"-61.947719\"></use><use x=\"-23.068412\" xlink:href=\"#m005_g11-56\" y=\"-60.453338\"></use><use x=\"-16.720057\" xlink:href=\"#m005_g4-184\" y=\"-61.947719\"></use><use x=\"-8.518646\" xlink:href=\"#m005_g7-42\" y=\"-61.947719\"></use><use x=\"-1.325618\" xlink:href=\"#m005_g11-50\" y=\"-60.453338\"></use><use x=\"3.307005\" xlink:href=\"#m005_g4-185\" y=\"-61.962663\"></use><use x=\"7.311983\" xlink:href=\"#m005_g7-37\" y=\"-61.947719\"></use><use x=\"13.498776\" xlink:href=\"#m005_g11-49\" y=\"-60.453338\"></use><use x=\"17.135141\" xlink:href=\"#m005_g11-54\" y=\"-60.453338\"></use><use x=\"23.483489\" xlink:href=\"#m005_g4-184\" y=\"-61.947719\"></use><use x=\"31.6849\" xlink:href=\"#m005_g7-42\" y=\"-61.947719\"></use><use x=\"38.877928\" xlink:href=\"#m005_g11-50\" y=\"-60.453338\"></use><use x=\"43.510551\" xlink:href=\"#m005_g4-185\" y=\"-61.947719\"></use><use x=\"47.425869\" xlink:href=\"#m005_g7-40\" y=\"-61.947719\"></use><use x=\"52.666208\" xlink:href=\"#m005_g11-51\" y=\"-60.453338\"></use><use x=\"56.302573\" xlink:href=\"#m005_g11-50\" y=\"-60.453338\"></use><use x=\"60.437055\" xlink:href=\"#m005_g4-186\" y=\"-61.947719\"></use><use x=\"64.252731\" xlink:href=\"#m005_g4-186\" y=\"-61.962663\"></use><use x=\"68.068344\" xlink:href=\"#m005_g4-186\" y=\"-61.962663\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">分类网络只能给图级标签，逐 patch 推理低效且边界粗</p><p class=\"cell-val cell-val-en lang-en\">Classification CNNs produced only image-level labels; sliding-window patch classification was redundant and boundary-coarse.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">将分类 CNN 的全连接层卷积化，端到端输出像素级预测</p><p class=\"cell-val cell-val-en lang-en\">Transform fully connected layers into convolutions and append transposed-convolution upsampling for end-to-end pixel-wise training.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">learned deconvolution，并在 FCN-16s/8s 中逐步加入浅深特征 skip fusion</p><p class=\"cell-val cell-val-en lang-en\">Learned deconvolution combined with multi-scale coarse-to-fine skip score fusion (FCN-32s → FCN-16s → FCN-8s).</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">是 U-Net 等医学 encoder-decoder 分割网络的直接祖先</p><p class=\"cell-val cell-val-en lang-en\">Direct progenitor of U-Net and all modern medical encoder–decoder segmentation networks.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">范式基础；具体结构已被更强解码器替代</p><p class=\"cell-val cell-val-en lang-en\">Foundational dense-prediction paradigm; asymmetric score-only upsampling is superseded by symmetric U-Net decoders.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">把分类网络完全卷积化后，可一次前向计算整图 dense prediction。</li><li class=\"lang-zh\">FCN-16s/8s 用浅层 skip score 补偿深层下采样造成的定位损失。</li><li class=\"lang-zh\">learned deconvolution 学习上采样核，但浅深特征只做分数相加，表达仍较粗。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Transform fully connected layers into convolutions and append transposed-convolution upsampling for end-to-end pixel-wise training.</li><li class=\"lang-en bullet-en\">Architectural Delta: Learned deconvolution combined with multi-scale coarse-to-fine skip score fusion (FCN-32s → FCN-16s → FCN-8s).</li><li class=\"lang-en bullet-en\">Mathematical Formalism: FCN-8s Multi-Stride Score Map Skip Fusion.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">它是 U-Net 等医学 encoder–decoder 的直接概念祖先。</li><li class=\"lang-zh\">对精细边界和小结构，FCN 的稀疏 skip 与粗上采样通常不如对称解码器。</li><li class=\"lang-en bullet-en\">Clinical Translation: Direct progenitor of U-Net and all modern medical encoder–decoder segmentation networks.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Foundational dense-prediction paradigm; asymmetric score-only upsampling is superseded by symmetric U-Net decoders.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openaccess.thecvf.com/content_cvpr_2015/html/Long_Fully_Convolutional_Networks_2015_CVPR_paper.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Fully Convolutional Networks for Semantic Segmentation</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/shelhamer/fcn.berkeleyvision.org\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}