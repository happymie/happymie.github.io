51\" xlink:href=\"#m023_g16-38\" y=\"-61.482058\"></use><use x=\"31.9996\" xlink:href=\"#m023_g13-18\" y=\"-59.987677\"></use><use x=\"36.498068\" xlink:href=\"#m023_g16-32\" y=\"-61.482058\"></use><use x=\"43.900287\" xlink:href=\"#m023_g7-62\" y=\"-65.098486\"></use><use x=\"43.263491\" xlink:href=\"#m023_g13-18\" y=\"-57.957783\"></use><rect height=\".557905\" width=\"25.119501\" x=\"24.45708\" y=\"-56.229538\"></rect><use x=\"30.640754\" xlink:href=\"#m023_g10-112\" y=\"-52.892078\"></use><rect height=\".552919\" width=\"5.748432\" x=\"37.644489\" y=\"-53.444998\"></rect><use x=\"37.893551\" xlink:href=\"#m023_g16-51\" y=\"-44.528438\"></use><use x=\"50.971352\" xlink:href=\"#m023_g4-19\" y=\"-67.449959\"></use><use x=\"56.706439\" xlink:href=\"#m023_g16-43\" y=\"-53.390195\"></use><use x=\"62.465648\" xlink:href=\"#m023_g13-18\" y=\"-51.895814\"></use><use x=\"66.814672\" xlink:href=\"#m023_g16-150\" y=\"-53.390195\"></use><use x=\"91.498721\" xlink:href=\"#m023_g16-34\" y=\"-53.390195\"></use><use x=\"99.718698\" xlink:href=\"#m023_g13-18\" y=\"-51.895814\"></use><use x=\"103.860515\" xlink:href=\"#m023_g7-0\" y=\"-51.895814\"></use><use x=\"108.776871\" xlink:href=\"#m023_g20-49\" y=\"-51.895814\"></use><use x=\"113.409479\" xlink:href=\"#m023_g10-185\" y=\"-53.390195\"></use><use x=\"117.095649\" xlink:href=\"#m023_g16-68\" y=\"-53.390195\"></use><use x=\"122.415703\" xlink:href=\"#m023_g10-186\" y=\"-53.390195\"></use><use x=\"129.197968\" xlink:href=\"#m023_g10-50\" y=\"-53.390195\"></use><use x=\"137.753581\" xlink:href=\"#m023_g10-102\" y=\"-53.390195\"></use><use x=\"142.097279\" xlink:href=\"#m023_g23-48\" y=\"-53.390195\"></use><use x=\"147.078599\" xlink:href=\"#m023_g16-150\" y=\"-53.390195\"></use><use x=\"151.339233\" xlink:href=\"#m023_g10-0\" y=\"-53.390195\"></use><use x=\"157.675469\" xlink:href=\"#m023_g10-49\" y=\"-53.390195\"></use><use x=\"166.42266\" xlink:href=\"#m023_g10-103\" y=\"-53.390195\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">语义、实例和全景分割依赖各自专用结构，全图 cross-attention 昂贵</p><p class=\"cell-val cell-val-en lang-en\">Semantic, instance, and panoptic segmentation relied on fragmented task heads, while global cross-attention converged slowly.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">把分割统一为一组 mask queries 的分类与掩膜预测</p><p class=\"cell-val cell-val-en lang-en\">Formulate all segmentation tasks as mask-classification set prediction using learnable object queries and masked cross-attention.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">masked cross-attention 只关注当前预测区域，配合多尺度 pixel decoder</p><p class=\"cell-val cell-val-en lang-en\">Multi-scale high-resolution pixel decoder + masked cross-attention attending strictly within each query's predicted foreground region.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">启发医学多实例细胞、病灶和开放词汇 mask 接口</p><p class=\"cell-val cell-val-en lang-en\">Inspires unified multi-instance nuclei, lesion, and open-vocabulary query segmentation in pathology and radiology.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">任务接口影响持久；3D、小目标和 matching 稳定性仍是门槛</p><p class=\"cell-val cell-val-en lang-en\">Influential universal task interface; 3D memory scaling, tiny lesions, and bipartite matching stability remain challenging.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">将分割重写为固定数量 query 对 mask 的集合预测，而不是逐像素独立分类。</li><li class=\"lang-zh\">masked attention 用上一轮 mask 把 cross-attention 限制在候选区域，既提高效率又强化局部一致性。</li><li class=\"lang-zh\">同一 class+mask 接口通过不同组合规则覆盖语义、实例和全景分割。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Formulate all segmentation tasks as mask-classification set prediction using learnable object queries and masked cross-attention.</li><li class=\"lang-en bullet-en\">Architectural Delta: Multi-scale high-resolution pixel decoder + masked cross-attention attending strictly within each query's predicted foreground region.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Mask-Constrained Cross-Attention Restricted to Predicted Foreground Regions.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">query 集合适合多病灶、多器官和相互重叠实例，但小样本下需要处理 no-object 比例和匹配稳定性。</li><li class=\"lang-zh\">医学三维化的主要成本在多尺度 voxel features 与 decoder attention；可把 query 作为器官/病灶候选而非类别硬编码。</li><li class=\"lang-en bullet-en\">Clinical Translation: Inspires unified multi-instance nuclei, lesion, and open-vocabulary query segmentation in pathology and radiology.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Influential universal task interface; 3D memory scaling, tiny lesions, and bipartite matching stability remain challenging.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openaccess.thecvf.com/content/CVPR2022/html/Cheng_Masked-Attention_Mask_Transformer_for_Universal_Image_Segmentation_CVPR_2022_paper.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Masked-attention Mask Transformer for Universal Image Segmentation</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/facebookresearch/Mask2Former\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
