y=\"-61.43659\"></use><use x=\"55.35323\" xlink:href=\"#m095_g19-103\" y=\"-61.43659\"></use><rect height=\".557905\" width=\"36.394238\" x=\"31.021901\" y=\"-53.914809\"></rect><use x=\"31.021901\" xlink:href=\"#m095_g7-205\" y=\"-50.171628\"></use><use x=\"40.162608\" xlink:href=\"#m095_g19-57\" y=\"-40.981117\"></use><use x=\"45.226942\" xlink:href=\"#m095_g22-52\" y=\"-43.197795\"></use><use x=\"50.134539\" xlink:href=\"#m095_g19-66\" y=\"-46.537748\"></use><use x=\"53.218175\" xlink:href=\"#m095_g16-56\" y=\"-45.446853\"></use><use x=\"56.17979\" xlink:href=\"#m095_g16-57\" y=\"-45.446853\"></use><use x=\"58.910787\" xlink:href=\"#m095_g10-157\" y=\"-46.537748\"></use><use x=\"62.728967\" xlink:href=\"#m095_g19-103\" y=\"-46.537748\"></use><use x=\"70.825518\" xlink:href=\"#m095_g13-184\" y=\"-51.075465\"></use><use x=\"79.37562\" xlink:href=\"#m095_g29-108\" y=\"-51.075465\"></use><use x=\"82.145233\" xlink:href=\"#m095_g29-111\" y=\"-51.075465\"></use><use x=\"87.126553\" xlink:href=\"#m095_g29-103\" y=\"-51.075465\"></use><use x=\"102.543769\" xlink:href=\"#m095_g22-52\" y=\"-57.820162\"></use><use x=\"107.451366\" xlink:href=\"#m095_g19-66\" y=\"-61.43659\"></use><use x=\"110.535002\" xlink:href=\"#m095_g16-56\" y=\"-60.345695\"></use><use x=\"112.784306\" xlink:href=\"#m095_g16-56\" y=\"-60.345695\"></use><use x=\"115.531737\" xlink:href=\"#m095_g10-157\" y=\"-61.43659\"></use><use x=\"119.349918\" xlink:href=\"#m095_g19-103\" y=\"-61.43659\"></use><rect height=\".557905\" width=\"36.503842\" x=\"94.963786\" y=\"-53.914809\"></rect><use x=\"94.963786\" xlink:href=\"#m095_g7-205\" y=\"-50.171628\"></use><use x=\"104.104493\" xlink:href=\"#m095_g19-57\" y=\"-40.981117\"></use><use x=\"109.168828\" xlink:href=\"#m095_g22-52\" y=\"-43.197795\"></use><use x=\"114.076425\" xlink:href=\"#m095_g19-66\" y=\"-46.537748\"></use><use x=\"117.981976\" xlink:href=\"#m095_g16-57\" y=\"-45.446853\"></use><use x=\"120.214845\" xlink:href=\"#m095_g16-56\" y=\"-45.446853\"></use><use x=\"122.962277\" xlink:href=\"#m095_g10-157\" y=\"-46.537748\"></use><use x=\"126.780458\" xlink:href=\"#m095_g19-103\" y=\"-46.537748\"></use><use x=\"132.8624\" xlink:href=\"#m095_g7-35\" y=\"-68.061755\"></use><use x=\"139.035855\" xlink:href=\"#m095_g22-150\" y=\"-51.075465\"></use><use x=\"153.518158\" xlink:href=\"#m095_g22-66\" y=\"-51.075465\"></use><use x=\"157.592882\" xlink:href=\"#m095_g19-56\" y=\"-49.581084\"></use><use x=\"161.160132\" xlink:href=\"#m095_g19-57\" y=\"-49.581084\"></use><use x=\"167.181953\" xlink:href=\"#m095_g4-61\" y=\"-51.075465\"></use><use x=\"177.3017\" xlink:href=\"#m095_g29-22\" y=\"-51.075465\"></use><use x=\"176.365226\" xlink:href=\"#m095_g22-69\" y=\"-51.075465\"></use><use x=\"181.236951\" xlink:href=\"#m095_g10-62\" y=\"-55.190025\"></use><use x=\"181.236951\" xlink:href=\"#m095_g19-56\" y=\"-48.351139\"></use><use x=\"187.506018\" xlink:href=\"#m095_g29-22\" y=\"-51.977083\"></use><use x=\"186.873407\" xlink:href=\"#m095_g22-67\" y=\"-51.075465\"></use><use x=\"191.032803\" xlink:href=\"#m095_g19-57\" y=\"-49.581084\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">高质量人工图文配对昂贵，早期 VLM 数据规模受限</p><p class=\"cell-val cell-val-en lang-en\">Curating clean, human-verified image captions was expensive and bottlenecked dataset scale.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">用双编码器在十亿级噪声网页图文对上做对比对齐</p><p class=\"cell-val cell-val-en lang-en\">Trade stringent manual data cleaning for sheer data scale (1.8B noisy pairs) using a simple dual-encoder contrastive objective.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">在其网页语料与评测条件下，以极大规模弱监督缓解标签噪声并获得零样本迁移</p><p class=\"cell-val cell-val-en lang-en\">Proved that massive scale can empirically overcome high caption noise in web-scale vision–language pretraining.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">方法上启发从报告、图注和病历构建医学图文预训练数据</p><p class=\"cell-val cell-val-en lang-en\">Methodologically inspired harvesting large-scale noisy hospital PACS archives and scientific figure-caption corpora.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">规模化 VLM 里程碑；原论文不是医学验证，医学隐私、噪声和临床语义错配更突出</p><p class=\"cell-val cell-val-en lang-en\">Web-scale VLM milestone; in clinical medicine, uncurated label/report noise and privacy leakage require far stricter governance.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">图像与文本分别编码，跨模态交互只发生在全局 embedding 相似度。</li><li class=\"lang-zh\">用极大规模弱配对数据吸收单对噪声，而不是依赖昂贵人工清洗。</li><li class=\"lang-zh\">对称批内对比损失同时训练图搜文与文搜图。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Trade stringent manual data cleaning for sheer data scale (1.8B noisy pairs) using a simple dual-encoder contrastive objective.</li><li class=\"lang-en bullet-en\">Architectural Delta: Proved that massive scale can empirically overcome high caption noise in web-scale vision–language pretraining.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Billion-Scale Noisy Image–Alt-Text Bidirectional Contrastive Learning.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">可迁移为影像—报告双塔，用于零样本标签提示和跨模态检索。</li><li class=\"lang-zh\">医学数据规模远小于网页语料，且同义报告会形成假负样本，需要语义软标签或患者级采样修正。</li><li class=\"lang-en bullet-en\">Clinical Translation: Methodologically inspired harvesting large-scale noisy hospital PACS archives and scientific figure-caption corpora.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Web-scale VLM milestone; in clinical medicine, uncurated label/report noise and privacy leakage require far stricter governance.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://proceedings.mlr.press/v139/jia21b.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Scaling Up Visual and Vision-Language Representation Learning With Noisy Text Supervision</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<span class=\"spec-muted-val\"><span class=\"lang-zh\">未提供官方实现</span><span class=\"lang-en\">No Official Repository</span></span>\n</div>\n</footer>\n</div>"}