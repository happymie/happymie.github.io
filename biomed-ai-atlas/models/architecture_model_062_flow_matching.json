e x=\"69.43451\" xlink:href=\"#m062_g21-49\" y=\"-54.047353\"></use><use x=\"73.568999\" xlink:href=\"#m062_g8-186\" y=\"-55.541734\"></use><use x=\"77.882809\" xlink:href=\"#m062_g8-107\" y=\"-55.541734\"></use><use x=\"82.365995\" xlink:href=\"#m062_g21-50\" y=\"-59.656294\"></use><use x=\"82.365995\" xlink:href=\"#m062_g21-50\" y=\"-52.515591\"></use><use x=\"86.699742\" xlink:href=\"#m062_g5-3\" y=\"-63.661264\"></use><use x=\"92.574211\" xlink:href=\"#m062_g17-150\" y=\"-55.541734\"></use><use x=\"108.242061\" xlink:href=\"#m062_g17-51\" y=\"-62.28643\"></use><use x=\"113.19349\" xlink:href=\"#m062_g17-71\" y=\"-62.28643\"></use><rect height=\".557905\" width=\"10.107057\" x=\"107.992998\" y=\"-58.381077\"></rect><use x=\"108.767586\" xlink:href=\"#m062_g17-51\" y=\"-48.707377\"></use><use x=\"114.227116\" xlink:href=\"#m062_g17-67\" y=\"-48.707377\"></use><use x=\"122.062902\" xlink:href=\"#m062_g2-61\" y=\"-55.541734\"></use><use x=\"131.246175\" xlink:href=\"#m062_g17-69\" y=\"-55.541734\"></use><use x=\"136.808811\" xlink:href=\"#m062_g14-92\" y=\"-54.047353\"></use><use x=\"142.085072\" xlink:href=\"#m062_g8-185\" y=\"-55.541734\"></use><use x=\"145.801133\" xlink:href=\"#m062_g17-71\" y=\"-55.541734\"></use><use x=\"150.707715\" xlink:href=\"#m062_g17-150\" y=\"-55.541734\"></use><use x=\"154.928501\" xlink:href=\"#m062_g17-67\" y=\"-55.541734\"></use><use x=\"158.275943\" xlink:href=\"#m062_g8-186\" y=\"-55.541734\"></use><use x=\"162.091619\" xlink:href=\"#m062_g17-150\" y=\"-55.541734\"></use><use x=\"176.314893\" xlink:href=\"#m062_g17-71\" y=\"-55.541734\"></use><use x=\"181.71961\" xlink:href=\"#m062_g8-185\" y=\"-55.541734\"></use><use x=\"185.43567\" xlink:href=\"#m062_g24-48\" y=\"-55.541734\"></use><use x=\"190.41699\" xlink:href=\"#m062_g8-186\" y=\"-55.541734\"></use><use x=\"196.999999\" xlink:href=\"#m062_g8-24\" y=\"-55.541734\"></use><use x=\"206.830839\" xlink:href=\"#m062_g17-63\" y=\"-55.541734\"></use><use x=\"212.210664\" xlink:href=\"#m062_g21-48\" y=\"-54.047353\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">normalizing flow 受可逆层和 Jacobian 限制，diffusion 采样步骤多</p><p class=\"cell-val cell-val-en lang-en\">Continuous Normalizing Flows required costly backpropagation through ODE solvers, while diffusion models relied on curved stochastic paths.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">在选定概率路径上回归条件 velocity field，再解 ODE 从 source transport 到 data</p><p class=\"cell-val cell-val-en lang-en\">Construct conditional probability paths (e.g., optimal transport straight lines) with closed-form conditional velocities and train v_θ via simple L2 regression.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">普通 U-Net/DiT 即可训练，无需 exact invertibility；直路径可少步积分</p><p class=\"cell-val cell-val-en lang-en\">Simulation-free training with unconstrained U-Net/DiT backbones + straight optimal-transport paths enabling fast few-step ODE integration.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">启发 operator-conditioned 医学 inverse solver 与少步跨模态生成</p><p class=\"cell-val cell-val-en lang-en\">Rapidly adopted for fast medical image synthesis, cross-modality translation, and operator-conditioned inverse reconstruction.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">高速发展；医学 coupling、likelihood 耦合与临床 superiority 尚未解决</p><p class=\"cell-val cell-val-en lang-en\">High-momentum generative paradigm; clinical superiority and calibrated posterior uncertainty over unrolled/diffusion baselines remain open research.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">在预先选定的概率路径上直接监督速度场，避免 normalizing flow 的逐层可逆性和 Jacobian 约束。</li><li class=\"lang-zh\">条件 velocity 的平方回归可得到同一边缘运输的 marginal velocity，无需显式学习 score。</li><li class=\"lang-zh\">推理只解常微分方程；轨迹曲率和 solver 误差决定所需函数评估次数。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Construct conditional probability paths (e.g., optimal transport straight lines) with closed-form conditional velocities and train v_θ via simple L2 regression.</li><li class=\"lang-en bullet-en\">Architectural Delta: Simulation-free training with unconstrained U-Net/DiT backbones + straight optimal-transport paths enabling fast few-step ODE integration.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Simulation-Free Conditional Flow Matching (CFM) Velocity Regression &amp; ODE Transport.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">可把解剖、模态或测量作为条件输入，研究少步医学跨模态生成和 inverse solver。</li><li class=\"lang-zh\">更少 ODE 步数不等于病灶更保真；coupling、条件路径及临床指标仍需专门设计与验证。</li><li class=\"lang-en bullet-en\">Clinical Translation: Rapidly adopted for fast medical image synthesis, cross-modality translation, and operator-conditioned inverse reconstruction.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: High-momentum generative paradigm; clinical superiority and calibrated posterior uncertainty over unrolled/diffusion baselines remain open research.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://arxiv.org/abs/2210.02747\" rel=\"noreferrer\" target=\"_blank\">\n<span>Flow Matching for Generative Modeling</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<span class=\"spec-muted-val\"><span class=\"lang-zh\">未提供官方实现</span><span class=\"lang-en\">No Official Repository</span></span>\n</div>\n</footer>\n</div>"}
