k:href=\"#m044_g8-28\" y=\"-55.374879\"></use><use x=\"-51.848947\" xlink:href=\"#m044_g18-109\" y=\"-61.947719\"></use><use x=\"-44.098014\" xlink:href=\"#m044_g18-97\" y=\"-61.947719\"></use><use x=\"-39.6746\" xlink:href=\"#m044_g18-120\" y=\"-61.947719\"></use><use x=\"-46.320192\" xlink:href=\"#m044_g8-25\" y=\"-55.42167\"></use><use x=\"-30.265548\" xlink:href=\"#m044_g0-69\" y=\"-61.947719\"></use><use x=\"-23.742007\" xlink:href=\"#m044_g8-71\" y=\"-60.453338\"></use><use x=\"-19.687473\" xlink:href=\"#m044_g2-24\" y=\"-60.453338\"></use><use x=\"-14.298386\" xlink:href=\"#m044_g8-63\" y=\"-60.453338\"></use><use x=\"-10.189289\" xlink:href=\"#m044_g15-100\" y=\"-59.24656\"></use><use x=\"-7.449563\" xlink:href=\"#m044_g15-97\" y=\"-59.24656\"></use><use x=\"-5.016685\" xlink:href=\"#m044_g15-116\" y=\"-59.24656\"></use><use x=\"-3.493398\" xlink:href=\"#m044_g15-97\" y=\"-59.24656\"></use><use x=\".533474\" xlink:href=\"#m044_g5-187\" y=\"-61.962663\"></use><use x=\"4.149889\" xlink:href=\"#m044_g18-108\" y=\"-61.947719\"></use><use x=\"6.919502\" xlink:href=\"#m044_g18-111\" y=\"-61.947719\"></use><use x=\"11.900822\" xlink:href=\"#m044_g18-103\" y=\"-61.947719\"></use><use x=\"18.911156\" xlink:href=\"#m044_g11-25\" y=\"-61.947719\"></use><use x=\"27.20008\" xlink:href=\"#m044_g5-185\" y=\"-61.947719\"></use><use x=\"30.91614\" xlink:href=\"#m044_g11-71\" y=\"-61.947719\"></use><use x=\"35.822723\" xlink:href=\"#m044_g5-186\" y=\"-61.947719\"></use><use x=\"39.638399\" xlink:href=\"#m044_g5-188\" y=\"-61.962663\"></use><use x=\"45.76755\" xlink:href=\"#m044_g5-184\" y=\"-61.947719\"></use><use x=\"54.317652\" xlink:href=\"#m044_g0-69\" y=\"-61.947719\"></use><use x=\"60.695735\" xlink:href=\"#m044_g8-73\" y=\"-60.317085\"></use><use x=\"64.262995\" xlink:href=\"#m044_g2-24\" y=\"-60.317085\"></use><use x=\"69.652082\" xlink:href=\"#m044_g8-63\" y=\"-60.317085\"></use><use x=\"74.673894\" xlink:href=\"#m044_g2-185\" y=\"-60.317085\"></use><use x=\"77.75025\" xlink:href=\"#m044_g8-73\" y=\"-60.317085\"></use><use x=\"81.681148\" xlink:href=\"#m044_g2-186\" y=\"-60.317085\"></use><use x=\"85.780627\" xlink:href=\"#m044_g5-187\" y=\"-61.962663\"></use><use x=\"89.397042\" xlink:href=\"#m044_g18-108\" y=\"-61.947719\"></use><use x=\"92.166655\" xlink:href=\"#m044_g18-111\" y=\"-61.947719\"></use><use x=\"97.147975\" xlink:href=\"#m044_g18-103\" y=\"-61.947719\"></use><use x=\"102.627429\" xlink:href=\"#m044_g5-185\" y=\"-61.962663\"></use><use x=\"106.343487\" xlink:href=\"#m044_g18-49\" y=\"-61.947719\"></use><use x=\"113.538673\" xlink:href=\"#m044_g5-0\" y=\"-61.947719\"></use><use x=\"122.45739\" xlink:href=\"#m044_g11-25\" y=\"-61.947719\"></use><use x=\"130.746314\" xlink:href=\"#m044_g5-185\" y=\"-61.947719\"></use><use x=\"134.44245\" xlink:href=\"#m044_g11-28\" y=\"-61.947719\"></use><use x=\"142.791146\" xlink:href=\"#m044_g5-185\" y=\"-61.947719\"></use><use x=\"146.746311\" xlink:href=\"#m044_g11-73\" y=\"-61.947719\"></use><use x=\"150.920654\" xlink:href=\"#m044_g5-186\" y=\"-61.947719\"></use><use x=\"154.73633\" xlink:href=\"#m044_g5-186\" y=\"-61.947719\"></use><use x=\"158.552006\" xlink:href=\"#m044_g5-186\" y=\"-61.962663\"></use><use x=\"162.367619\" xlink:href=\"#m044_g5-188\" y=\"-61.962663\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">显式 likelihood 生成模型难训练且样本常过度平滑</p><p class=\"cell-val cell-val-en lang-en\">Pixel-wise L1/L2 and maximum-likelihood generative models averaged over uncertain modes, producing blurry textures.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">generator 与 discriminator 进行对抗式分布学习</p><p class=\"cell-val cell-val-en lang-en\">Pit a generator G against an adversarial discriminator D trained to distinguish real samples from synthesized ones.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">min-max 学习可直接产生锐利样本而无需显式密度</p><p class=\"cell-val cell-val-en lang-en\">Implicit density learning via Jensen-Shannon divergence minimization yielding sharp, high-frequency visual samples.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">推动 MR-CT 翻译、低剂量增强和合成数据</p><p class=\"cell-val cell-val-en lang-en\">Catalyzed medical cross-modality synthesis (MR-to-CT), low-dose perceptual enhancement, and synthetic cohort augmentation.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">历史基础；mode collapse、训练不稳和 hallucination 风险突出</p><p class=\"cell-val cell-val-en lang-en\">Foundational generative paradigm; training instability, mode collapse, and anatomically unfaithful hallucinations pose severe clinical risks.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">判别器估计真实与生成分布的可分性，生成器通过判别梯度隐式学习数据分布而无需显式 likelihood。</li><li class=\"lang-zh\">训练是二人 minimax 博弈；理想均衡处生成分布等于真实分布，判别器无法区分二者。</li><li class=\"lang-zh\">判别器相当于可学习损失，会持续适应当前生成错误，而不是固定的像素距离。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Pit a generator G against an adversarial discriminator D trained to distinguish real samples from synthesized ones.</li><li class=\"lang-en bullet-en\">Architectural Delta: Implicit density learning via Jensen-Shannon divergence minimization yielding sharp, high-frequency visual samples.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Two-Player Minimax Adversarial Value Function Between Generator G and Discriminator D.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">可用于合成影像、增强和跨模态映射，但视觉逼真不代表病灶、剂量或定量值真实。</li><li class=\"lang-zh\">mode collapse 和不稳定训练会隐性减少病种多样性；隐私重复与罕见病例覆盖必须审计。</li><li class=\"lang-en bullet-en\">Clinical Translation: Catalyzed medical cross-modality synthesis (MR-to-CT), low-dose perceptual enhancement, and synthetic cohort augmentation.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Foundational generative paradigm; training instability, mode collapse, and anatomically unfaithful hallucinations pose severe clinical risks.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://papers.neurips.cc/paper_files/paper/2014/hash/f033ed80deb0234979a61f95710dbe25-Abstract.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Generative Adversarial Nets</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<span class=\"spec-muted-val\"><span class=\"lang-zh\">未提供官方实现</span><span class=\"lang-en\">No Official Repository</span></span>\n</div>\n</footer>\n</div>"}