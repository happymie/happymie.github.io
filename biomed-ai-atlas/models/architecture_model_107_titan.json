58.816958\"></use><use x=\"83.026558\" xlink:href=\"#m107_g20-51\" y=\"-57.322577\"></use><use x=\"88.821447\" xlink:href=\"#m107_g4-213\" y=\"-69.011212\"></use><use x=\"93.957204\" xlink:href=\"#m107_g13-67\" y=\"-47.7659\"></use><use x=\"103.662415\" xlink:href=\"#m107_g23-108\" y=\"-58.816958\"></use><use x=\"106.432028\" xlink:href=\"#m107_g23-111\" y=\"-58.816958\"></use><use x=\"111.413348\" xlink:href=\"#m107_g23-103\" y=\"-58.816958\"></use><use x=\"118.78234\" xlink:href=\"#m107_g16-63\" y=\"-58.816958\"></use><use x=\"124.853076\" xlink:href=\"#m107_g13-92\" y=\"-57.322577\"></use><use x=\"130.129338\" xlink:href=\"#m107_g10-185\" y=\"-58.816958\"></use><use x=\"133.685998\" xlink:href=\"#m107_g16-65\" y=\"-58.816958\"></use><use x=\"137.996334\" xlink:href=\"#m107_g13-67\" y=\"-57.322577\"></use><use x=\"144.605739\" xlink:href=\"#m107_g10-106\" y=\"-58.816958\"></use><use x=\"149.604702\" xlink:href=\"#m107_g16-65\" y=\"-58.816958\"></use><use x=\"154.031401\" xlink:href=\"#m107_g13-159\" y=\"-57.322577\"></use><use x=\"159.173219\" xlink:href=\"#m107_g13-67\" y=\"-57.322577\"></use><use x=\"162.61678\" xlink:href=\"#m107_g16-150\" y=\"-58.816958\"></use><use x=\"167.116519\" xlink:href=\"#m107_g16-73\" y=\"-58.816958\"></use><use x=\"171.290862\" xlink:href=\"#m107_g20-87\" y=\"-57.322577\"></use><use x=\"177.865405\" xlink:href=\"#m107_g20-83\" y=\"-57.322577\"></use><use x=\"181.909041\" xlink:href=\"#m107_g20-73\" y=\"-57.322577\"></use><use x=\"184.828961\" xlink:href=\"#m107_g10-186\" y=\"-58.816958\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">仅 patch 级预训练缺整片上下文，纯视觉模型难接入语言任务</p><p class=\"cell-val cell-val-en lang-en\">Most pathology foundation models stopped at the tile level, requiring task-specific MIL training from scratch for every slide-level task.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">以 slide encoder 汇聚 gigapixel WSI，并与病理报告文本进行跨模态对齐</p><p class=\"cell-val cell-val-en lang-en\">Pretrain a Vision Transformer slide encoder directly over spatial grids of tile embeddings using progressive visual and clinical report supervision.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">在整片尺度联合视觉自监督和图文对齐，支持零样本与生成任务</p><p class=\"cell-val cell-val-en lang-en\">Progressive 3-stage slide-level curriculum (335K WSIs) bridging spatial tile grids, synthetic ROI morphology captions, and clinical reports.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">用于 WSI 分类、检索、报告和生物标志物预测</p><p class=\"cell-val cell-val-en lang-en\">Enables zero-shot whole-slide subtyping, rare cancer retrieval, biomarker prediction, and slide-level representation reuse.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">whole-slide 多模态 FM 前沿；公开权重移除了多模态 decoder，论文报告生成功能不能完整复现</p><p class=\"cell-val cell-val-en lang-en\">Frontier multimodal slide foundation model; note that the publicly released weights omit the generative text decoder.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">先把 patch 特征按坐标组成二维网格，再在 embedding 空间训练全片 ViT。</li><li class=\"lang-zh\">Stage 1 用 iBOT 视觉自监督学习 ROI/WSI 结构。</li><li class=\"lang-zh\">Stage 2/3 用 CoCa 分别对齐细粒度 ROI 描述和 slide-level 报告，同时训练检索与生成。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Pretrain a Vision Transformer slide encoder directly over spatial grids of tile embeddings using progressive visual and clinical report supervision.</li><li class=\"lang-en bullet-en\">Architectural Delta: Progressive 3-stage slide-level curriculum (335K WSIs) bridging spatial tile grids, synthetic ROI morphology captions, and clinical reports.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Three-Stage Slide Pretraining: Grid iBOT + ROI Caption CoCa + Clinical WSI Report CoCa.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">把病理基础模型从 tile 表示推进到整片、零样本、报告和跨模态检索。</li><li class=\"lang-zh\">合成 caption 与机构报告可带入风格偏差；公开权重若不含完整 decoder，则论文生成能力不能直接复现。</li><li class=\"lang-en bullet-en\">Clinical Translation: Enables zero-shot whole-slide subtyping, rare cancer retrieval, biomarker prediction, and slide-level representation reuse.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Frontier multimodal slide foundation model; note that the publicly released weights omit the generative text decoder.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://doi.org/10.1038/s41591-025-03982-3\" rel=\"noreferrer\" target=\"_blank\">\n<span>A Multimodal Whole-Slide Foundation Model for Pathology</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/mahmoodlab/TITAN\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
