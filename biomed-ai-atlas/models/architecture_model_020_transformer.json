20-116\" y=\"-54.393543\"></use><use x=\"-59.247837\" xlink:href=\"#m020_g20-116\" y=\"-54.393543\"></use><use x=\"-56.478224\" xlink:href=\"#m020_g20-101\" y=\"-54.393543\"></use><use x=\"-52.05481\" xlink:href=\"#m020_g20-110\" y=\"-54.393543\"></use><use x=\"-47.07349\" xlink:href=\"#m020_g20-116\" y=\"-54.393543\"></use><use x=\"-44.303877\" xlink:href=\"#m020_g20-105\" y=\"-54.393543\"></use><use x=\"-41.534264\" xlink:href=\"#m020_g20-111\" y=\"-54.393543\"></use><use x=\"-36.552944\" xlink:href=\"#m020_g20-110\" y=\"-54.393543\"></use><use x=\"-31.07349\" xlink:href=\"#m020_g10-185\" y=\"-54.393543\"></use><use x=\"-27.457058\" xlink:href=\"#m020_g16-38\" y=\"-54.393543\"></use><use x=\"-19.785821\" xlink:href=\"#m020_g16-150\" y=\"-54.393543\"></use><use x=\"-15.375744\" xlink:href=\"#m020_g16-32\" y=\"-54.393543\"></use><use x=\"-7.973525\" xlink:href=\"#m020_g16-150\" y=\"-54.393543\"></use><use x=\"-4.111396\" xlink:href=\"#m020_g16-43\" y=\"-54.393543\"></use><use x=\"2.902301\" xlink:href=\"#m020_g10-186\" y=\"-54.393543\"></use><use x=\"9.48531\" xlink:href=\"#m020_g1-61\" y=\"-54.393543\"></use><use x=\"18.588878\" xlink:href=\"#m020_g20-115\" y=\"-54.393543\"></use><use x=\"22.464345\" xlink:href=\"#m020_g20-111\" y=\"-54.393543\"></use><use x=\"27.445665\" xlink:href=\"#m020_g20-102\" y=\"-54.393543\"></use><use x=\"30.763226\" xlink:href=\"#m020_g20-116\" y=\"-54.393543\"></use><use x=\"33.532838\" xlink:href=\"#m020_g20-109\" y=\"-54.393543\"></use><use x=\"41.283771\" xlink:href=\"#m020_g20-97\" y=\"-54.393543\"></use><use x=\"45.707186\" xlink:href=\"#m020_g20-120\" y=\"-54.393543\"></use><use x=\"51.485516\" xlink:href=\"#m020_g4-18\" y=\"-68.453307\"></use><use x=\"56.456856\" xlink:href=\"#m020_g16-38\" y=\"-61.13824\"></use><use x=\"64.277537\" xlink:href=\"#m020_g16-32\" y=\"-61.13824\"></use><use x=\"71.679756\" xlink:href=\"#m020_g7-62\" y=\"-64.754668\"></use><rect height=\".557905\" width=\"20.799565\" x=\"56.556485\" y=\"-57.232886\"></rect><use x=\"58.308794\" xlink:href=\"#m020_g10-112\" y=\"-53.895426\"></use><rect height=\".552919\" width=\"10.291227\" x=\"65.312529\" y=\"-54.448346\"></rect><use x=\"65.561591\" xlink:href=\"#m020_g16-51\" y=\"-46.256424\"></use><use x=\"71.10929\" xlink:href=\"#m020_g13-58\" y=\"-44.762043\"></use><use x=\"78.750821\" xlink:href=\"#m020_g4-19\" y=\"-68.453307\"></use><use x=\"84.485924\" xlink:href=\"#m020_g16-43\" y=\"-54.393543\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">RNN 串行且长依赖路径长，卷积需堆层获得远程交互</p><p class=\"cell-val cell-val-en lang-en\">Recurrent networks precluded parallel training across time steps and struggled with long-range dependencies.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">以 scaled dot-product multi-head self-attention 并行建模 token 间关系</p><p class=\"cell-val cell-val-en lang-en\">Replace recurrence and convolution entirely with parallel multi-head scaled dot-product attention and position encodings.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">Q/K/V 动态全局交互、位置编码、残差和前馈网络</p><p class=\"cell-val cell-val-en lang-en\">Content-dependent Q/K/V all-pair affinity matrices, multi-head subspace projection, residual LayerNorm, and position-wise FFN.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">是 ViT、医学 VLM、长生理信号模型的共同基础</p><p class=\"cell-val cell-val-en lang-en\">Foundational operator underlying Vision Transformers, medical VLMs, multimodal EHR fusion, and biosignal foundation models.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">基础设施级方法；高分辨 3D 仍受 O(N²) 限制</p><p class=\"cell-val cell-val-en lang-en\">Universal deep learning infrastructure; direct application to dense 3D voxels is bottlenecked by O(N²) attention complexity.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">scaled dot-product attention 用当前输入动态生成 token 间聚合权重。</li><li class=\"lang-zh\">多头机制并行学习不同关系，位置编码补回顺序信息。</li><li class=\"lang-zh\">encoder–decoder cross-attention 将源表示与自回归目标生成解耦。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Replace recurrence and convolution entirely with parallel multi-head scaled dot-product attention and position encodings.</li><li class=\"lang-en bullet-en\">Architectural Delta: Content-dependent Q/K/V all-pair affinity matrices, multi-head subspace projection, residual LayerNorm, and position-wise FFN.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Scaled Dot-Product Multi-Head Self-Attention.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">它是 ViT、医学 VLM 和长生理序列模型的共同注意力母体。</li><li class=\"lang-zh\">标准全局 attention 的 N×N 矩阵在高分辨率 3D 中通常必须窗口化或降采样。</li><li class=\"lang-en bullet-en\">Clinical Translation: Foundational operator underlying Vision Transformers, medical VLMs, multimodal EHR fusion, and biosignal foundation models.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Universal deep learning infrastructure; direct application to dense 3D voxels is bottlenecked by O(N²) attention complexity.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://proceedings.neurips.cc/paper_files/paper/2017/hash/3f5ee243547dee91fbd053c1c4a845aa-Abstract.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Attention Is All You Need</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/tensorflow/tensor2tensor\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}