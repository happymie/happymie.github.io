ref=\"#m073_g4-13\" y=\"-60.931815\"></use><use x=\"115.840789\" xlink:href=\"#m073_g4-13\" y=\"-54.95423\"></use><use x=\"115.840789\" xlink:href=\"#m073_g4-13\" y=\"-48.976646\"></use><use x=\"120.184486\" xlink:href=\"#m073_g7-0\" y=\"-52.39384\"></use><use x=\"128.181121\" xlink:href=\"#m073_g20-108\" y=\"-52.39384\"></use><use x=\"130.950734\" xlink:href=\"#m073_g20-111\" y=\"-52.39384\"></use><use x=\"135.932054\" xlink:href=\"#m073_g20-103\" y=\"-52.39384\"></use><use x=\"144.177759\" xlink:href=\"#m073_g13-30\" y=\"-59.138536\"></use><use x=\"147.572025\" xlink:href=\"#m073_g10-65\" y=\"-57.644155\"></use><rect height=\".557905\" width=\"8.220865\" x=\"143.769287\" y=\"-55.233183\"></rect><use x=\"144.283214\" xlink:href=\"#m073_g13-30\" y=\"-45.559483\"></use><use x=\"147.750208\" xlink:href=\"#m073_g17-48\" y=\"-44.065103\"></use><use x=\"155.399532\" xlink:href=\"#m073_g7-0\" y=\"-52.39384\"></use><use x=\"163.949634\" xlink:href=\"#m073_g4-185\" y=\"-65.947992\"></use><use x=\"169.555607\" xlink:href=\"#m073_g10-65\" y=\"-43.596827\"></use><use x=\"176.112345\" xlink:href=\"#m073_g13-96\" y=\"-52.39384\"></use><use x=\"182.332515\" xlink:href=\"#m073_g10-92\" y=\"-50.899459\"></use><use x=\"187.608776\" xlink:href=\"#m073_g7-185\" y=\"-52.39384\"></use><use x=\"191.324837\" xlink:href=\"#m073_g13-71\" y=\"-52.39384\"></use><use x=\"196.231419\" xlink:href=\"#m073_g7-186\" y=\"-52.39384\"></use><use x=\"201.956557\" xlink:href=\"#m073_g13-51\" y=\"-52.39384\"></use><use x=\"207.416087\" xlink:href=\"#m073_g13-18\" y=\"-52.39384\"></use><use x=\"211.899252\" xlink:href=\"#m073_g4-13\" y=\"-66.909399\"></use><use x=\"211.899252\" xlink:href=\"#m073_g4-13\" y=\"-60.931815\"></use><use x=\"211.899252\" xlink:href=\"#m073_g4-13\" y=\"-54.95423\"></use><use x=\"211.899252\" xlink:href=\"#m073_g4-13\" y=\"-48.976646\"></use><use x=\"216.242876\" xlink:href=\"#m073_g17-50\" y=\"-64.102131\"></use><use x=\"216.242876\" xlink:href=\"#m073_g17-50\" y=\"-42.635436\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">稀疏 CBCT 重建缺细节，监督网络需大量成对训练数据</p><p class=\"cell-val cell-val-en lang-en\">Applying RGB NeRF directly to X-ray projections violated transmission physics, while Fourier MLP encodings took hours to optimize per patient.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">用坐标网络表示 X-ray attenuation，并最小化输入投影的重投影误差</p><p class=\"cell-val cell-val-en lang-en\">Model a view-independent scalar attenuation field μ(x) using multi-resolution hash grid encoding (Instant-NGP) supervised purely by line-integral projection residuals.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">将 NeRF 改为符合 Beer-Lambert 的 attenuation field，并用 hash encoding 加速</p><p class=\"cell-val cell-val-en lang-en\">Physically faithful Beer–Lambert line integral + multi-resolution learnable hash table reducing self-supervised 3D CBCT reconstruction to minutes.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">适用于 phantom/人体 sparse-view CBCT 的自监督 per-case reconstruction；需区分模拟投影与真实 acquisition</p><p class=\"cell-val cell-val-en lang-en\">Fast, self-supervised per-patient sparse-view CBCT reconstruction requiring zero external training datasets.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">正确的医学 NeRF 改写；无外部 prior 时仍不能创造缺失信息</p><p class=\"cell-val cell-val-en lang-en\">Correct physics adaptation of NeRF to tomography; without an external population prior, extreme view sparsity still exhibits null-space streaks.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">把 NeRF 的 radiance field 改写为非负 attenuation field，使渲染符合 X-ray 射线积分。</li><li class=\"lang-zh\">只用输入投影重投影误差做 per-case self-supervision，不需要成对 ground-truth CT。</li><li class=\"lang-zh\">多分辨率 hash encoding 提升坐标场的训练速度和细节表达，但不能补足未观测的零空间。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Model a view-independent scalar attenuation field μ(x) using multi-resolution hash grid encoding (Instant-NGP) supervised purely by line-integral projection residuals.</li><li class=\"lang-en bullet-en\">Architectural Delta: Physically faithful Beer–Lambert line integral + multi-resolution learnable hash table reducing self-supervised 3D CBCT reconstruction to minutes.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Beer–Lambert Logarithmic Line-Integral Reprojection Consistency Over Multi-Resolution Hash Grids.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合 sparse-view CBCT 的病例级自监督重建，可在连续坐标中任意分辨率查询。</li><li class=\"lang-zh\">真实散射、束硬化、金属和校准误差若未纳入 renderer，会被场错误吸收为解剖；模拟与真实证据应分开报告。</li><li class=\"lang-en bullet-en\">Clinical Translation: Fast, self-supervised per-patient sparse-view CBCT reconstruction requiring zero external training datasets.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Correct physics adaptation of NeRF to tomography; without an external population prior, extreme view sparsity still exhibits null-space streaks.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://conferences.miccai.org/2022/papers/349-Paper0974.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Neural Attenuation Fields for Sparse-View CBCT Reconstruction</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/ruyi-zha/naf_cbct\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}