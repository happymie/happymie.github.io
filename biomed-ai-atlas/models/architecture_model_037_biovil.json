rm=\"scale(1.369862)\" xlink:href=\"#m037_g7-186\"></use></defs><g id=\"m037_page1\"><use x=\"-68.264016\" xlink:href=\"#m037_g16-22\" y=\"-51.467018\"></use><use x=\"-62.054299\" xlink:href=\"#m037_g13-64\" y=\"-49.972637\"></use><use x=\"-57.567035\" xlink:href=\"#m037_g13-56\" y=\"-49.972637\"></use><use x=\"-51.67977\" xlink:href=\"#m037_g1-61\" y=\"-51.467018\"></use><use x=\"-42.576202\" xlink:href=\"#m037_g20-115\" y=\"-51.467018\"></use><use x=\"-38.700736\" xlink:href=\"#m037_g20-111\" y=\"-51.467018\"></use><use x=\"-33.719416\" xlink:href=\"#m037_g20-102\" y=\"-51.467018\"></use><use x=\"-30.401855\" xlink:href=\"#m037_g20-116\" y=\"-51.467018\"></use><use x=\"-27.632242\" xlink:href=\"#m037_g20-109\" y=\"-51.467018\"></use><use x=\"-19.881309\" xlink:href=\"#m037_g20-97\" y=\"-51.467018\"></use><use x=\"-15.457894\" xlink:href=\"#m037_g20-120\" y=\"-51.467018\"></use><use x=\"-10.476574\" xlink:href=\"#m037_g13-56\" y=\"-49.972637\"></use><use x=\"-6.559626\" xlink:href=\"#m037_g4-32\" y=\"-68.453307\"></use><use x=\"-1.398986\" xlink:href=\"#m037_g16-67\" y=\"-59.899005\"></use><use x=\"1.948456\" xlink:href=\"#m037_g7-62\" y=\"-63.515433\"></use><use x=\"1.742232\" xlink:href=\"#m037_g13-64\" y=\"-57.438247\"></use><use x=\"7.704476\" xlink:href=\"#m037_g16-69\" y=\"-59.899005\"></use><use x=\"12.576201\" xlink:href=\"#m037_g13-56\" y=\"-58.404625\"></use><rect height=\".557905\" width=\"17.05526\" x=\"-1.359138\" y=\"-54.306361\"></rect><use x=\"4.692773\" xlink:href=\"#m037_g16-103\" y=\"-44.632661\"></use><use x=\"17.090893\" xlink:href=\"#m037_g4-33\" y=\"-68.453307\"></use><use x=\"23.354019\" xlink:href=\"#m037_g16-150\" y=\"-51.467018\"></use><use x=\"47.599705\" xlink:href=\"#m037_g16-54\" y=\"-51.467018\"></use><use x=\"53.383024\" xlink:href=\"#m037_g10-185\" y=\"-51.467018\"></use><use x=\"57.248527\" xlink:href=\"#m037_g16-64\" y=\"-51.467018\"></use><use x=\"62.628352\" xlink:href=\"#m037_g16-150\" y=\"-51.467018\"></use><use x=\"67.297458\" xlink:href=\"#m037_g16-30\" y=\"-51.467018\"></use><use x=\"71.342273\" xlink:href=\"#m037_g10-186\" y=\"-51.467018\"></use><use x=\"77.925281\" xlink:href=\"#m037_g1-61\" y=\"-51.467018\"></use><use x=\"87.028849\" xlink:href=\"#m037_g4-213\" y=\"-61.661272\"></use><use x=\"92.308231\" xlink:href=\"#m037_g13-56\" y=\"-40.12252\"></use><use x=\"102.617013\" xlink:href=\"#m037_g16-22\" y=\"-51.467018\"></use><use x=\"108.82673\" xlink:href=\"#m037_g13-64\" y=\"-49.972637\"></use><use x=\"113.313994\" xlink:href=\"#m037_g13-56\" y=\"-49.972637\"></use><use x=\"116.513632\" xlink:href=\"#m037_g16-69\" y=\"-51.467018\"></use><use x=\"121.385356\" xlink:href=\"#m037_g13-56\" y=\"-49.972637\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">通用文本 encoder 不理解放射学否定、关系和叙述结构</p><p class=\"cell-val cell-val-en lang-en\">Generic BERT text encoders mishandled radiological negations ('no pleural effusion'), temporal comparisons, and clinical syntax.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">以放射学专科语言模型增强全局图文对齐和局部 grounding</p><p class=\"cell-val cell-val-en lang-en\">Pretrain a dedicated radiology language model (CXR-BERT) with radiology section matching, then align it globally and locally with chest X-rays.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">强化文本侧临床语义，并联合 image-text contrastive learning</p><p class=\"cell-val cell-val-en lang-en\">Domain-tailored text modeling + symmetric global/local contrastive projection + MS-CXR phrase grounding benchmark.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">在胸片 phrase grounding、分类、分割和检索上形成强专科模型</p><p class=\"cell-val cell-val-en lang-en\">Strong specialist baseline for chest X-ray zero-shot classification, phrase grounding, and semantic report evaluation.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">证明文本建模不是附属模块；模态范围仍以 CXR 为主</p><p class=\"cell-val cell-val-en lang-en\">Proved that clinical text modeling is as critical as visual architecture; scope is primarily specialized to chest radiography.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">先训练放射学专用语言模型，减少通用 BERT 对专业缩写、否定和报告句式的语义误读。</li><li class=\"lang-zh\">图像 encoder 保留空间网格，使报告短语不仅与整图对齐，也能在 patch 级计算 grounding。</li><li class=\"lang-zh\">全局配对约束诊断语义，局部相似约束解剖位置，形成可迁移且可查询的共享空间。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Pretrain a dedicated radiology language model (CXR-BERT) with radiology section matching, then align it globally and locally with chest X-rays.</li><li class=\"lang-en bullet-en\">Architectural Delta: Domain-tailored text modeling + symmetric global/local contrastive projection + MS-CXR phrase grounding benchmark.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Radiology-Specific CXR-BERT Semantic Encoding + Local Patch–Phrase Alignment.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">短语 grounding 可作为检索和可解释界面，但相似图仍不是像素级标注替代品。</li><li class=\"lang-zh\">模型专为胸片与英文报告训练；迁移到 CT、其他语言或不同报告规范需重新对齐。</li><li class=\"lang-en bullet-en\">Clinical Translation: Strong specialist baseline for chest X-ray zero-shot classification, phrase grounding, and semantic report evaluation.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Proved that clinical text modeling is as critical as visual architecture; scope is primarily specialized to chest radiography.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://www.ecva.net/papers/eccv_2022/papers_ECCV/papers/136960001.pdf\" rel=\"noreferrer\" target=\"_blank\">\n<span>Making the Most of Text Semantics to Improve Biomedical Vision-Language Processing</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<span class=\"spec-muted-val\"><span class=\"lang-zh\">未提供官方实现</span><span class=\"lang-en\">No Official Repository</span></span>\n</div>\n</footer>\n</div>"}