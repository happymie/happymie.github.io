069_g17-27\" y=\"-60.333776\"></use><use x=\"32.98227\" xlink:href=\"#m069_g14-51\" y=\"-58.839396\"></use><use x=\"37.993108\" xlink:href=\"#m069_g17-150\" y=\"-60.333776\"></use><use x=\"42.751876\" xlink:href=\"#m069_g17-34\" y=\"-60.333776\"></use><use x=\"51.219122\" xlink:href=\"#m069_g14-51\" y=\"-58.839396\"></use><use x=\"58.443826\" xlink:href=\"#m069_g11-14\" y=\"-60.333776\"></use><use x=\"65.609122\" xlink:href=\"#m069_g2-8\" y=\"-60.333776\"></use><use x=\"73.901523\" xlink:href=\"#m069_g14-92\" y=\"-58.839396\"></use><use x=\"79.177784\" xlink:href=\"#m069_g11-185\" y=\"-60.333776\"></use><use x=\"83.391979\" xlink:href=\"#m069_g17-34\" y=\"-60.333776\"></use><use x=\"91.859225\" xlink:href=\"#m069_g14-51\" y=\"-58.839396\"></use><use x=\"96.870063\" xlink:href=\"#m069_g17-150\" y=\"-60.333776\"></use><use x=\"101.419617\" xlink:href=\"#m069_g17-27\" y=\"-60.333776\"></use><use x=\"107.286608\" xlink:href=\"#m069_g14-51\" y=\"-58.839396\"></use><use x=\"112.297446\" xlink:href=\"#m069_g11-186\" y=\"-60.333776\"></use><use x=\"116.113122\" xlink:href=\"#m069_g11-186\" y=\"-60.34872\"></use><use x=\"122.142599\" xlink:href=\"#m069_g11-184\" y=\"-60.333776\"></use><use x=\"130.563191\" xlink:href=\"#m069_g17-95\" y=\"-60.333776\"></use><use x=\"136.276762\" xlink:href=\"#m069_g11-76\" y=\"-60.333776\"></use><use x=\"143.938023\" xlink:href=\"#m069_g21-71\" y=\"-58.839396\"></use><use x=\"149.188935\" xlink:href=\"#m069_g21-73\" y=\"-58.839396\"></use><use x=\"151.610756\" xlink:href=\"#m069_g21-67\" y=\"-58.839396\"></use><use x=\"156.607105\" xlink:href=\"#m069_g14-150\" y=\"-58.839396\"></use><use x=\"159.130736\" xlink:href=\"#m069_g14-51\" y=\"-58.839396\"></use><use x=\"164.639706\" xlink:href=\"#m069_g11-185\" y=\"-60.333776\"></use><use x=\"168.485276\" xlink:href=\"#m069_g17-92\" y=\"-60.333776\"></use><use x=\"173.41677\" xlink:href=\"#m069_g11-186\" y=\"-60.333776\"></use><use x=\"177.431704\" xlink:href=\"#m069_g5-3\" y=\"-68.453307\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">task-specific registration 网络迁移到新器官或模态时脆弱</p><p class=\"cell-val cell-val-en lang-en\">Conventional learning-based registration required training a separate network for every organ, modality, and FOV.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">在多解剖、多模态、多数据集联合训练 GradICON，支持 zero-shot 与微调</p><p class=\"cell-val cell-val-en lang-en\">Unify diverse public 3D registration cohorts (brain, lung, abdomen, knee; CT &amp; MRI) under a single GradICON training objective.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">共享跨任务的对应特征与形变先验，同时保留 inverse consistency</p><p class=\"cell-val cell-val-en lang-en\">Demonstrates that a single frozen registration weight set achieves strong out-of-the-box zero-shot accuracy on unseen anatomical domains and fast one-shot adaptation.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">是 registration foundation model 的早期可信实例</p><p class=\"cell-val cell-val-en lang-en\">First credible, open-weight foundation model for 3D medical deformable image registration.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">高速发展；尚未覆盖所有临床域和细结构</p><p class=\"cell-val cell-val-en lang-en\">Rapidly advancing registration foundation baseline; extreme cross-modality contrasts (e.g., ultrasound-to-MRI) still benefit from domain adaptation.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">通过多任务联合训练把器官、模态和形变统计汇总到单一共享注册器，而非每任务单独训练。</li><li class=\"lang-zh\">保留 GradICON 的双向复合梯度约束，使规模扩展不丢失核心几何正则。</li><li class=\"lang-zh\">foundation model 在此指跨训练任务 zero-shot/可微调能力，不表示覆盖所有临床域。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Unify diverse public 3D registration cohorts (brain, lung, abdomen, knee; CT &amp; MRI) under a single GradICON training objective.</li><li class=\"lang-en bullet-en\">Architectural Delta: Demonstrates that a single frozen registration weight set achieves strong out-of-the-box zero-shot accuracy on unseen anatomical domains and fast one-shot adaptation.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Multi-Dataset Composite Similarity &amp; Gradient Inverse Consistency Foundation Training.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">可作为多器官、多模态注册的统一初始化或基线，减少每个新任务重新训练的成本。</li><li class=\"lang-zh\">未覆盖的儿科、术后、植入物或极端病理仍可能失效；需按目标域报告 landmark、Jacobian 和病理保持。</li><li class=\"lang-en bullet-en\">Clinical Translation: First credible, open-weight foundation model for 3D medical deformable image registration.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Rapidly advancing registration foundation baseline; extreme cross-modality contrasts (e.g., ultrasound-to-MRI) still benefit from domain adaptation.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://papers.miccai.org/miccai-2024/816-Paper0527.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>uniGradICON: A Foundation Model for Medical Image Registration</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/uncbiag/uniGradICON\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
