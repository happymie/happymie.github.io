ref=\"#m122_g13-35\" y=\"-49.359655\"></use><use x=\"53.361998\" xlink:href=\"#m122_g7-184\" y=\"-49.359655\"></use><use x=\"58.205632\" xlink:href=\"#m122_g13-25\" y=\"-49.359655\"></use><use x=\"64.885623\" xlink:href=\"#m122_g7-186\" y=\"-49.359655\"></use><use x=\"67.889251\" xlink:href=\"#m122_g7-157\" y=\"-49.359655\"></use><use x=\"71.234707\" xlink:href=\"#m122_g20-50\" y=\"-49.359655\"></use><use x=\"76.564664\" xlink:href=\"#m122_g16-150\" y=\"-53.897372\"></use><use x=\"92.232514\" xlink:href=\"#m122_g16-51\" y=\"-60.642069\"></use><use x=\"97.183944\" xlink:href=\"#m122_g16-71\" y=\"-60.642069\"></use><rect height=\".557905\" width=\"10.107057\" x=\"91.983452\" y=\"-56.736715\"></rect><use x=\"92.319681\" xlink:href=\"#m122_g16-51\" y=\"-47.063016\"></use><use x=\"97.380706\" xlink:href=\"#m122_g16-65\" y=\"-47.063016\"></use><use x=\"106.053355\" xlink:href=\"#m122_g1-61\" y=\"-53.897372\"></use><use x=\"116.63139\" xlink:href=\"#m122_g16-26\" y=\"-60.642069\"></use><use x=\"123.503622\" xlink:href=\"#m122_g13-71\" y=\"-59.147688\"></use><use x=\"128.554416\" xlink:href=\"#m122_g10-185\" y=\"-60.642069\"></use><use x=\"132.270477\" xlink:href=\"#m122_g16-71\" y=\"-60.642069\"></use><use x=\"137.177059\" xlink:href=\"#m122_g16-150\" y=\"-60.642069\"></use><use x=\"141.278293\" xlink:href=\"#m122_g16-65\" y=\"-60.642069\"></use><use x=\"145.900948\" xlink:href=\"#m122_g10-186\" y=\"-60.642069\"></use><rect height=\".557905\" width=\"33.364142\" x=\"116.352438\" y=\"-56.736715\"></rect><use x=\"116.953212\" xlink:href=\"#m122_g16-26\" y=\"-47.063016\"></use><use x=\"123.316348\" xlink:href=\"#m122_g13-65\" y=\"-45.568635\"></use><use x=\"128.23261\" xlink:href=\"#m122_g10-185\" y=\"-47.063016\"></use><use x=\"131.94867\" xlink:href=\"#m122_g16-71\" y=\"-47.063016\"></use><use x=\"136.855253\" xlink:href=\"#m122_g16-150\" y=\"-47.063016\"></use><use x=\"140.956486\" xlink:href=\"#m122_g16-65\" y=\"-47.063016\"></use><use x=\"145.579141\" xlink:href=\"#m122_g10-186\" y=\"-47.063016\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">原始 PFGM 与 diffusion 的关系和可扩展调节机制不清</p><p class=\"cell-val cell-val-en lang-en\">Diffusion models rely on Gaussian kernels with thin tails, whereas original PFGM (D=1) was difficult to scale to large conditional architectures.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">在增广空间用高维电场/Poisson flow 连接数据分布与简单先验</p><p class=\"cell-val cell-val-en lang-en\">Generalize the augmented electrostatic dimension from D=1 to arbitrary D, proving that as D→∞ and r=σ√D, the Poisson kernel converges to Gaussian diffusion.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">以增广维度 D 连续统一 Poisson flow 与 diffusion，并改善鲁棒性和采样</p><p class=\"cell-val cell-val-en lang-en\">Provides a tunable robustness–rigidity knob D (e.g., D=64 or 2048) that improves ODE integration stability and error tolerance over standard EDM diffusion.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">提供医学生成与逆问题的新型 score/flow 先验选择</p><p class=\"cell-val cell-val-en lang-en\">Evaluated on low-dose CT denoising and medical image generation as a more perturbation-robust drop-in alternative to score models.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">有理论吸引力但医学实证有限；仍需与强 diffusion 公平比较</p><p class=\"cell-val cell-val-en lang-en\">Theoretically elegant unification of electrostatic flows and diffusion; clinical adoption remains at an early research stage.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">把数据当作增广空间超平面上的电荷，用 Poisson 场定义生成轨迹。</li><li class=\"lang-zh\">增广维度 D 连续连接原 PFGM 与 diffusion 极限，可调鲁棒性和训练行为。</li><li class=\"lang-zh\">采样是沿学习场求解 ODE，从简单大半径分布流向数据。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Generalize the augmented electrostatic dimension from D=1 to arbitrary D, proving that as D→∞ and r=σ√D, the Poisson kernel converges to Gaussian diffusion.</li><li class=\"lang-en bullet-en\">Architectural Delta: Provides a tunable robustness–rigidity knob D (e.g., D=64 or 2048) that improves ODE integration stability and error tolerance over standard EDM diffusion.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Augmented D-Dimensional Heavy-Tailed Poisson Perturbation Kernel &amp; Electric Field ODE.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">为医学图像生成和逆问题提供 diffusion 之外的 score/flow 先验。</li><li class=\"lang-zh\">高维 ODE 仍会继承训练分布偏差；医学保真必须检查定量值、病灶保存和条件测量残差。</li><li class=\"lang-en bullet-en\">Clinical Translation: Evaluated on low-dose CT denoising and medical image generation as a more perturbation-robust drop-in alternative to score models.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Theoretically elegant unification of electrostatic flows and diffusion; clinical adoption remains at an early research stage.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://proceedings.mlr.press/v202/xu23m.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>PFGM++: Unlocking the Potential of Physics-Inspired Generative Models</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/Newbeeer/pfgmpp\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
