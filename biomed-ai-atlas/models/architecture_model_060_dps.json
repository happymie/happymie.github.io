0_g7-114\" y=\"-59.987571\"></use><use x=\"135.915456\" xlink:href=\"#m060_g23-94\" y=\"-58.49319\"></use><use x=\"134.917291\" xlink:href=\"#m060_g13-71\" y=\"-58.49319\"></use><use x=\"138.604565\" xlink:href=\"#m060_g20-48\" y=\"-57.360384\"></use><use x=\"142.838684\" xlink:href=\"#m060_g7-107\" y=\"-59.987571\"></use><use x=\"147.720375\" xlink:href=\"#m060_g16-72\" y=\"-59.987571\"></use><use x=\"154.736231\" xlink:href=\"#m060_g7-0\" y=\"-59.987571\"></use><use x=\"164.033529\" xlink:href=\"#m060_g16-22\" y=\"-59.987571\"></use><use x=\"171.453183\" xlink:href=\"#m060_g26-94\" y=\"-59.987571\"></use><use x=\"170.250205\" xlink:href=\"#m060_g16-71\" y=\"-59.987571\"></use><use x=\"174.972496\" xlink:href=\"#m060_g23-48\" y=\"-58.49319\"></use><use x=\"179.60511\" xlink:href=\"#m060_g7-107\" y=\"-59.987571\"></use><use x=\"184.088296\" xlink:href=\"#m060_g23-50\" y=\"-64.102131\"></use><use x=\"184.088296\" xlink:href=\"#m060_g23-50\" y=\"-56.961428\"></use><use x=\"190.990118\" xlink:href=\"#m060_g1-61\" y=\"-59.987571\"></use><use x=\"200.093687\" xlink:href=\"#m060_g26-50\" y=\"-59.987571\"></use><use x=\"205.822203\" xlink:href=\"#m060_g16-22\" y=\"-59.987571\"></use><use x=\"212.038879\" xlink:href=\"#m060_g4-3\" y=\"-64.102131\"></use><use x=\"216.460593\" xlink:href=\"#m060_g7-185\" y=\"-59.987571\"></use><use x=\"220.923849\" xlink:href=\"#m060_g16-22\" y=\"-59.987571\"></use><use x=\"228.343503\" xlink:href=\"#m060_g26-94\" y=\"-59.987571\"></use><use x=\"227.140525\" xlink:href=\"#m060_g16-71\" y=\"-59.987571\"></use><use x=\"231.862816\" xlink:href=\"#m060_g23-48\" y=\"-58.49319\"></use><use x=\"238.211162\" xlink:href=\"#m060_g7-0\" y=\"-59.987571\"></use><use x=\"247.159769\" xlink:href=\"#m060_g16-72\" y=\"-59.987571\"></use><use x=\"251.96176\" xlink:href=\"#m060_g7-186\" y=\"-59.987571\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">早期 diffusion inverse 方法难处理 noisy 或 nonlinear operators</p><p class=\"cell-val cell-val-en lang-en\">Projection-based diffusion solvers failed under heavy measurement noise or non-linear operators without closed-form SVD.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">把 learned score prior 与可微 measurement likelihood gradient 结合</p><p class=\"cell-val cell-val-en lang-en\">Approximate p(y|x_t) ≈ p(y | x̂_0(x_t)) using Tweedie's formula and take a gradient step ∇_{x_t} ||y − A(x̂_0(x_t))||² at every reverse diffusion step.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">通过 x0 估计近似 posterior score guidance，支持通用 differentiable A</p><p class=\"cell-val cell-val-en lang-en\">Handles general noisy linear and non-linear differentiable forward operators without SVD or task-specific retraining.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">可用于 MRI、CT、PET 等测量模型耦合的 posterior sampling</p><p class=\"cell-val cell-val-en lang-en\">Widely used in accelerated multi-coil MRI, sparse-view CT, phase retrieval, and PET posterior sampling research.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">研究主干；guidance 调参、NFE 和 posterior calibration 仍是限制</p><p class=\"cell-val cell-val-en lang-en\">Core diffusion inverse baseline; requires backpropagation through the score network at every step (high memory/latency) and sensitive guidance-scale tuning.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">用 Tweedie/去噪估计把不可直接求得的 noisy-state likelihood 近似为对 x0_hat 的测量残差。</li><li class=\"lang-zh\">可微 A 使同一无条件 prior 能接入不同线性或非线性 inverse problems。</li><li class=\"lang-zh\">每个逆时间步都执行 score 与 data-consistency guidance，属于采样迭代而非固定 K 级学习优化器。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Approximate p(y|x_t) ≈ p(y | x̂_0(x_t)) using Tweedie's formula and take a gradient step ∇_{x_t} ||y − A(x̂_0(x_t))||² at every reverse diffusion step.</li><li class=\"lang-en bullet-en\">Architectural Delta: Handles general noisy linear and non-linear differentiable forward operators without SVD or task-specific retraining.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Prior Score Coupled with Measurement Likelihood Gradient via Tweedie Denoised Estimate x̂_0.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">可为 MRI、CT、PET 等显式测量模型生成多个候选样本，用于研究条件不确定性。</li><li class=\"lang-zh\">guidance 权重、噪声似然和 A 的误差会改变样本分布；多样性不等于经过校准的临床后验。</li><li class=\"lang-en bullet-en\">Clinical Translation: Widely used in accelerated multi-coil MRI, sparse-view CT, phase retrieval, and PET posterior sampling research.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Core diffusion inverse baseline; requires backpropagation through the score network at every step (high memory/latency) and sensitive guidance-scale tuning.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://arxiv.org/abs/2209.14687\" rel=\"noreferrer\" target=\"_blank\">\n<span>Diffusion Posterior Sampling for General Noisy Inverse Problems</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/DPS2022/diffusion-posterior-sampling\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
