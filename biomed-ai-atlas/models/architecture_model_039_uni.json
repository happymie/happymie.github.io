869\" xlink:href=\"#m039_g20-73\" y=\"-54.047368\"></use><use x=\"-44.961601\" xlink:href=\"#m039_g1-61\" y=\"-55.541749\"></use><use x=\"-35.658775\" xlink:href=\"#m039_g10-76\" y=\"-55.541749\"></use><use x=\"-27.688675\" xlink:href=\"#m039_g20-116\" y=\"-59.656309\"></use><use x=\"-25.666857\" xlink:href=\"#m039_g20-105\" y=\"-59.656309\"></use><use x=\"-23.645038\" xlink:href=\"#m039_g20-108\" y=\"-59.656309\"></use><use x=\"-21.62322\" xlink:href=\"#m039_g20-101\" y=\"-59.656309\"></use><use x=\"-27.997514\" xlink:href=\"#m039_g20-68\" y=\"-52.435614\"></use><use x=\"-22.746602\" xlink:href=\"#m039_g20-73\" y=\"-52.435614\"></use><use x=\"-20.324781\" xlink:href=\"#m039_g20-78\" y=\"-52.435614\"></use><use x=\"-15.219335\" xlink:href=\"#m039_g20-79\" y=\"-52.435614\"></use><use x=\"-7.256445\" xlink:href=\"#m039_g10-184\" y=\"-55.541749\"></use><use x=\"1.164147\" xlink:href=\"#m039_g16-95\" y=\"-55.541749\"></use><use x=\"13.851543\" xlink:href=\"#m039_g23-49\" y=\"-62.286445\"></use><rect height=\".557905\" width=\"16.936443\" x=\"7.873974\" y=\"-58.381092\"></rect><use x=\"8.272479\" xlink:href=\"#m039_g10-106\" y=\"-48.707392\"></use><use x=\"10.663511\" xlink:href=\"#m039_g10-77\" y=\"-48.707392\"></use><use x=\"22.419412\" xlink:href=\"#m039_g10-106\" y=\"-48.707392\"></use><use x=\"29.136038\" xlink:href=\"#m039_g4-213\" y=\"-65.736003\"></use><use x=\"27.66633\" xlink:href=\"#m039_g13-56\" y=\"-43.659078\"></use><use x=\"30.724506\" xlink:href=\"#m039_g7-50\" y=\"-43.659078\"></use><use x=\"35.495403\" xlink:href=\"#m039_g7-77\" y=\"-43.659078\"></use><use x=\"45.705728\" xlink:href=\"#m039_g16-29\" y=\"-55.541749\"></use><use x=\"54.253668\" xlink:href=\"#m039_g4-0\" y=\"-63.135754\"></use><use x=\"58.09924\" xlink:href=\"#m039_g16-63\" y=\"-55.541749\"></use><use x=\"63.479065\" xlink:href=\"#m039_g13-56\" y=\"-59.656309\"></use><use x=\"63.51543\" xlink:href=\"#m039_g13-67\" y=\"-53.080991\"></use><use x=\"66.958996\" xlink:href=\"#m039_g16-150\" y=\"-55.541749\"></use><use x=\"71.946903\" xlink:href=\"#m039_g16-63\" y=\"-55.541749\"></use><use x=\"77.326728\" xlink:href=\"#m039_g13-56\" y=\"-59.656309\"></use><use x=\"77.472186\" xlink:href=\"#m039_g13-66\" y=\"-53.080991\"></use><use x=\"81.64956\" xlink:href=\"#m039_g4-1\" y=\"-63.135754\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">ImageNet 或小规模 TCGA encoder 跨组织迁移弱</p><p class=\"cell-val cell-val-en lang-en\">ImageNet-pretrained encoders and small TCGA-only models generalized poorly across diverse tissue types and rare cancers.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">在超过一亿病理 patches 上用 DINOv2 训练 ViT-L 通用 tile encoder</p><p class=\"cell-val cell-val-en lang-en\">Scale DINOv2 self-supervised pretraining to &gt;100M non-public diagnostic tissue tiles across 20 major tissue types (100,000+ WSIs).</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">大规模多组织 WSI 数据、自监督预训练与 34 个临床任务评估</p><p class=\"cell-val cell-val-en lang-en\">Massive non-TCGA clinical tissue diversity + DINOv2/iBOT recipe evaluated systematically across 34 clinical pathology tasks.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">原论文及后续比较报告较强的病理 label efficiency 和跨任务迁移</p><p class=\"cell-val cell-val-en lang-en\">Widely adopted frozen tile feature extractor for cancer subtyping, biomarker prediction, ROI retrieval, and cell segmentation.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">病理 foundation model 的成熟代表；slide 聚合仍常需任务训练</p><p class=\"cell-val cell-val-en lang-en\">Mature pathology tile foundation model; slide-level diagnosis still requires training an MIL or slide aggregator on top.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">把病理基础模型训练单元设为组织 tile，以超大规模无标签 WSI 转化为可管理的视觉样本。</li><li class=\"lang-zh\">DINOv2 式图像级自蒸馏与 patch 遮蔽蒸馏同时学习形态语义和局部组织结构。</li><li class=\"lang-zh\">预训练 encoder 与任务聚合器解耦，同一 tile 表征可用在线性探针、ROI 和 WSI 级任务。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Scale DINOv2 self-supervised pretraining to &gt;100M non-public diagnostic tissue tiles across 20 major tissue types (100,000+ WSIs).</li><li class=\"lang-en bullet-en\">Architectural Delta: Massive non-TCGA clinical tissue diversity + DINOv2/iBOT recipe evaluated systematically across 34 clinical pathology tasks.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: UNI Joint Tile-Level DINO Self-Distillation &amp; Masked Patch iBOT Distillation.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">强 tile encoder 不自动解决 WSI 级空间推理；聚合方法、取样倍率和 tile 数仍决定病例级性能。</li><li class=\"lang-zh\">染色、扫描仪和组织来源偏移需独立验证，且患者级/切片级划分必须防止近重复泄漏。</li><li class=\"lang-en bullet-en\">Clinical Translation: Widely adopted frozen tile feature extractor for cancer subtyping, biomarker prediction, ROI retrieval, and cell segmentation.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Mature pathology tile foundation model; slide-level diagnosis still requires training an MIL or slide aggregator on top.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://doi.org/10.1038/s41591-024-02857-3\" rel=\"noreferrer\" target=\"_blank\">\n<span>Towards a General-Purpose Foundation Model for Computational Pathology</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/mahmoodlab/UNI\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}