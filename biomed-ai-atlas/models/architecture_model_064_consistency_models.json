64_g10-150\" y=\"-61.962663\"></use><use x=\"43.326818\" xlink:href=\"#m064_g10-71\" y=\"-61.962663\"></use><use x=\"48.194568\" xlink:href=\"#m064_g7-66\" y=\"-60.468282\"></use><use x=\"54.663344\" xlink:href=\"#m064_g12-108\" y=\"-61.962663\"></use><use x=\"57.432957\" xlink:href=\"#m064_g12-105\" y=\"-61.962663\"></use><use x=\"60.20257\" xlink:href=\"#m064_g12-101\" y=\"-61.962663\"></use><use x=\"67.116644\" xlink:href=\"#m064_g12-111\" y=\"-61.962663\"></use><use x=\"72.097965\" xlink:href=\"#m064_g12-110\" y=\"-61.962663\"></use><use x=\"79.569945\" xlink:href=\"#m064_g12-111\" y=\"-61.962663\"></use><use x=\"84.551265\" xlink:href=\"#m064_g12-110\" y=\"-61.962663\"></use><use x=\"89.532585\" xlink:href=\"#m064_g12-101\" y=\"-61.962663\"></use><use x=\"96.446659\" xlink:href=\"#m064_g12-80\" y=\"-61.962663\"></use><use x=\"101.985885\" xlink:href=\"#m064_g12-70\" y=\"-61.962663\"></use><use x=\"107.52511\" xlink:href=\"#m064_g12-45\" y=\"-61.962663\"></use><use x=\"110.842671\" xlink:href=\"#m064_g12-79\" y=\"-61.962663\"></use><use x=\"118.035699\" xlink:href=\"#m064_g12-68\" y=\"-61.962663\"></use><use x=\"125.228726\" xlink:href=\"#m064_g12-69\" y=\"-61.962663\"></use><use x=\"133.80656\" xlink:href=\"#m064_g12-112\" y=\"-61.962663\"></use><use x=\"138.78788\" xlink:href=\"#m064_g12-97\" y=\"-61.962663\"></use><use x=\"143.211294\" xlink:href=\"#m064_g12-116\" y=\"-61.962663\"></use><use x=\"145.980907\" xlink:href=\"#m064_g12-104\" y=\"-61.962663\"></use><use x=\"150.962227\" xlink:href=\"#m064_g10-150\" y=\"-61.962663\"></use><use x=\"176.881639\" xlink:href=\"#m064_g10-53\" y=\"-61.962663\"></use><use x=\"180.441791\" xlink:href=\"#m064_g7-92\" y=\"-60.468282\"></use><use x=\"185.718053\" xlink:href=\"#m064_g4-185\" y=\"-61.962663\"></use><use x=\"189.434113\" xlink:href=\"#m064_g10-71\" y=\"-61.962663\"></use><use x=\"194.340696\" xlink:href=\"#m064_g10-150\" y=\"-61.962663\"></use><use x=\"198.690992\" xlink:href=\"#m064_g10-89\" y=\"-61.962663\"></use><use x=\"203.831708\" xlink:href=\"#m064_g4-186\" y=\"-61.962663\"></use><use x=\"210.414716\" xlink:href=\"#m064_g1-61\" y=\"-61.962663\"></use><use x=\"219.518285\" xlink:href=\"#m064_g10-71\" y=\"-61.962663\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">高质量 diffusion 需要许多 solver steps</p><p class=\"cell-val cell-val-en lang-en\">Even accelerated ODE/DDIM samplers required 10–50 sequential neural evaluations, limiting real-time intraoperative or streaming use.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">把同一 probability-flow ODE 轨迹上的任意点直接映射到相同 clean endpoint</p><p class=\"cell-val cell-val-en lang-en\">Enforce that any two adjacent points on the same PF-ODE trajectory map to the exact same clean endpoint under an EMA target network.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">可由预训练 diffusion 蒸馏或独立训练，实现 one/few-step generation</p><p class=\"cell-val cell-val-en lang-en\">Supports single-step generation (1 NFE) as well as zero-shot multi-step iterative refinement trading compute for quality.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">对实时医学重建和交互生成有直接吸引力</p><p class=\"cell-val cell-val-en lang-en\">Highly attractive for real-time medical reconstruction, interactive synthesis, and low-latency clinical workflows.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">速度方向重要；医学 raw-data benchmark 和校准证据不足</p><p class=\"cell-val cell-val-en lang-en\">Important speed frontier; raw-data medical inverse benchmarks and quantitative bias audits at 1–2 NFEs remain limited.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">同一 probability-flow ODE 轨迹上的所有状态应映射到同一个干净端点。</li><li class=\"lang-zh\">可由 score-based diffusion 蒸馏，也可通过 consistency training 独立学习；两种训练证据需区分。</li><li class=\"lang-zh\">推理跳过逐步 ODE/SDE 数值积分，一步速度来自端点映射而非更粗的普通 diffusion solver。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Enforce that any two adjacent points on the same PF-ODE trajectory map to the exact same clean endpoint under an EMA target network.</li><li class=\"lang-en bullet-en\">Architectural Delta: Supports single-step generation (1 NFE) as well as zero-shot multi-step iterative refinement trading compute for quality.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Trajectory Self-Consistency f_θ(x_{t_{n+1}}, t_{n+1}) = f_{θ^-}(x_{t_n}, t_n) with Boundary Condition f_θ(x_ε, ε) = x_ε.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合对延迟敏感的交互重建、床旁生成或大体积推理探索。</li><li class=\"lang-zh\">医学 raw-data 条件化、少步病灶保真和后验校准证据仍少，不能从自然图像速度结果外推临床等效。</li><li class=\"lang-en bullet-en\">Clinical Translation: Highly attractive for real-time medical reconstruction, interactive synthesis, and low-latency clinical workflows.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Important speed frontier; raw-data medical inverse benchmarks and quantitative bias audits at 1–2 NFEs remain limited.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://proceedings.mlr.press/v202/song23a/song23a.pdf\" rel=\"noreferrer\" target=\"_blank\">\n<span>Consistency Models</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/openai/consistency_models\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
