453338\"></use><use x=\"-8.855939\" xlink:href=\"#m045_g12-78\" y=\"-60.453338\"></use><use x=\"-2.60878\" xlink:href=\"#m045_g2-185\" y=\"-61.947719\"></use><use x=\"1.087357\" xlink:href=\"#m045_g8-28\" y=\"-61.947719\"></use><use x=\"8.937918\" xlink:href=\"#m045_g8-150\" y=\"-61.947719\"></use><use x=\"13.567167\" xlink:href=\"#m045_g8-25\" y=\"-61.947719\"></use><use x=\"21.357957\" xlink:href=\"#m045_g2-186\" y=\"-61.947719\"></use><use x=\"27.387499\" xlink:href=\"#m045_g2-184\" y=\"-61.947719\"></use><use x=\"35.808091\" xlink:href=\"#m045_g8-95\" y=\"-61.947719\"></use><use x=\"42.982804\" xlink:href=\"#m045_g0-69\" y=\"-61.947719\"></use><use x=\"49.506345\" xlink:href=\"#m045_g5-71\" y=\"-60.453338\"></use><use x=\"53.706336\" xlink:href=\"#m045_g5-150\" y=\"-60.453338\"></use><use x=\"56.41179\" xlink:href=\"#m045_g5-72\" y=\"-60.453338\"></use><use x=\"61.529478\" xlink:href=\"#m045_g2-187\" y=\"-61.962663\"></use><use x=\"65.644027\" xlink:href=\"#m045_g2-107\" y=\"-61.947719\"></use><use x=\"70.525718\" xlink:href=\"#m045_g8-72\" y=\"-61.947719\"></use><use x=\"77.541575\" xlink:href=\"#m045_g2-0\" y=\"-61.947719\"></use><use x=\"86.071753\" xlink:href=\"#m045_g8-28\" y=\"-61.947719\"></use><use x=\"94.420448\" xlink:href=\"#m045_g2-185\" y=\"-61.947719\"></use><use x=\"98.136509\" xlink:href=\"#m045_g8-71\" y=\"-61.947719\"></use><use x=\"103.043091\" xlink:href=\"#m045_g2-186\" y=\"-61.947719\"></use><use x=\"107.356901\" xlink:href=\"#m045_g2-107\" y=\"-61.947719\"></use><use x=\"111.840087\" xlink:href=\"#m045_g12-49\" y=\"-60.453338\"></use><use x=\"115.974576\" xlink:href=\"#m045_g2-188\" y=\"-61.962663\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">纯 L1/L2 输出过平滑，普通 GAN 不保证输入输出对应</p><p class=\"cell-val cell-val-en lang-en\">Pure L1/L2 regression blurs high-frequency textures, while unconditional GANs do not preserve patient-specific spatial anatomy.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">以输入为条件训练 PatchGAN，并以 L1 保持配对结构</p><p class=\"cell-val cell-val-en lang-en\">Condition both U-Net generator and patch-level discriminator on the input image x while anchoring low-frequency structure via L1 loss.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">paired fidelity 与 learned local texture loss 结合，常用 U-Net generator</p><p class=\"cell-val cell-val-en lang-en\">U-Net skip generator + 70×70 Markovian PatchGAN critic + λ||y − G(x)||_1 structural constraint.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">用于 paired 低剂量、PET、MR-CT 和骨抑制映射</p><p class=\"cell-val cell-val-en lang-en\">Workhorse baseline for paired low-dose-to-full-dose PET/CT, MR-to-synthetic-CT radiation planning, and virtual histological staining.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">强 mapping 基线；不保证测量一致，可能生成逼真但错误结构</p><p class=\"cell-val cell-val-en lang-en\">Strong paired image-translation baseline; remains an image-domain mapping without physical sensor consistency guarantees.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">conditional GAN 让判别器同时看 x 和输出，迫使真实性与给定输入相一致，而非任意生成。</li><li class=\"lang-zh\">PatchGAN 把判别学习限制在局部感受野，充当可学习的高频纹理损失并可卷积应用到任意尺寸。</li><li class=\"lang-zh\">U-Net skips 和 L1 保持配对结构，adversarial loss 弥补单纯像素回归造成的过度平滑。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Condition both U-Net generator and patch-level discriminator on the input image x while anchoring low-frequency structure via L1 loss.</li><li class=\"lang-en bullet-en\">Architectural Delta: U-Net skip generator + 70×70 Markovian PatchGAN critic + λ||y − G(x)||_1 structural constraint.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Conditional PatchGAN Adversarial Objective Coupled with Paired L1 Pixel Fidelity.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适用于严格配准的低剂量→常规剂量、MR→CT 等 mapping；配准误差会被模型当作生成目标。</li><li class=\"lang-zh\">Patch 级真实感不能保证器官拓扑或定量测量一致，必须检查病灶保真和物理/临床约束。</li><li class=\"lang-en bullet-en\">Clinical Translation: Workhorse baseline for paired low-dose-to-full-dose PET/CT, MR-to-synthetic-CT radiation planning, and virtual histological staining.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Strong paired image-translation baseline; remains an image-domain mapping without physical sensor consistency guarantees.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openaccess.thecvf.com/content_cvpr_2017/html/Isola_Image-To-Image_Translation_With_CVPR_2017_paper.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Image-to-Image Translation with Conditional Adversarial Networks</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/phillipi/pix2pix\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}