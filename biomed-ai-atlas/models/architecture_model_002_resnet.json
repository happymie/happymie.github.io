51 1.64762 .019851 1.64762 .019851C1.727023 .019851 1.786576 .079403 1.786576 .158807C1.786576 .47642 1.508664 .843661 .972691 1.210901L1.06202 1.399484C1.746874 1.06202 2.173667 .466495 2.173667-.12903ZM1.905681-3.990019C1.905681-4.297707 1.64762-4.555768 1.349857-4.555768S.803959-4.297707 .803959-3.990019C.803959-3.702182 1.052094-3.454046 1.339932-3.454046C1.64762-3.454046 1.905681-3.702182 1.905681-3.990019Z\" id=\"m002_g17-59\"></path><path d=\"M8.99243-6.322492V-6.481299H7.156228V-6.322492C7.702126-6.272865 7.80138-6.203387 7.80138-5.925476C7.80138-5.756743 7.731902-5.528459 7.592946-5.260472L5.736893-1.607918L5.339876-5.597937L5.32995-5.736893C5.32995-6.143835 5.478832-6.272865 6.004879-6.322492V-6.481299H3.642629V-6.322492C4.218303-6.302642 4.317558-6.233164 4.387036-5.746818L4.476364-5.061964L2.769192-1.607918L2.332474-5.637638L2.322548-5.776594C2.322548-6.163686 2.441653-6.253014 3.047104-6.322492V-6.481299H.704705V-6.322492C1.022318-6.282791 1.111647-6.253014 1.210901-6.173611C1.330006-6.054506 1.369708-5.885774 1.488813-4.952784L2.104189 .178658H2.292772L4.496215-4.327483H4.545842L5.042113 .178658H5.240622L8.248024-5.607862C8.51601-6.114059 8.615264-6.203387 8.99243-6.322492Z\" id=\"m002_g13-44\"></path><path d=\"M1.934564-.746293L1.825881-.825994C1.48534-.412997 1.304201-.26084 1.166535-.26084C1.094079-.26084 1.028869-.311559 1.021624-.369524C1.021624-.485452 1.101325-.702819 1.144798-.84773L1.731689-3.180801L1.775162-3.195292C.920186-3.057626 .746293-3.035889 .412997-3.014153V-2.898224C.862222-2.890978 .927432-2.869242 .934677-2.72433C.934677-2.666366 .91294-2.543191 .876713-2.405526L.550663-1.123062C.434734-.688328 .39126-.478207 .39126-.333296C.405751-.06521 .543417 .079701 .789766 .079701C1.188272 .079701 1.48534-.137666 1.934564-.746293ZM2.151931-4.267635C2.144686-4.477756 1.956301-4.658895 1.731689-4.658895S1.340429-4.499492 1.347674-4.27488C1.35492-4.043022 1.528813-3.890865 1.767917-3.890865C1.985283-3.890865 2.159177-4.064759 2.151931-4.267635Z\" id=\"m002_g10-56\"></path></defs><g id=\"m002_page1\"><use x=\"-69.011212\" xlink:href=\"#m002_g2-121\" y=\"-61.962663\"></use><use x=\"-61.26256\" xlink:href=\"#m002_g4-61\" y=\"-61.962663\"></use><use x=\"-51.909929\" xlink:href=\"#m002_g7-70\" y=\"-61.962663\"></use><use x=\"-43.102951\" xlink:href=\"#m002_g7-185\" y=\"-61.962663\"></use><use x=\"-39.386891\" xlink:href=\"#m002_g2-120\" y=\"-61.962663\"></use><use x=\"-34.405571\" xlink:href=\"#m002_g17-59\" y=\"-61.962663\"></use><use x=\"-29.726496\" xlink:href=\"#m002_g7-102\" y=\"-61.962663\"></use><use x=\"-25.641827\" xlink:href=\"#m002_g13-44\" y=\"-61.962663\"></use><use x=\"-17.342946\" xlink:href=\"#m002_g10-56\" y=\"-60.468282\"></use><use x=\"-13.973946\" xlink:href=\"#m002_g7-103\" y=\"-61.962663\"></use><use x=\"-9.630227\" xlink:href=\"#m002_g7-186\" y=\"-61.962663\"></use><use x=\"-3.600685\" xlink:href=\"#m002_g7-184\" y=\"-61.962663\"></use><use x=\"4.949417\" xlink:href=\"#m002_g2-120\" y=\"-61.962663\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">网络加深后出现优化退化，训练误差反而上升</p><p class=\"cell-val cell-val-en lang-en\">Deepening plain networks triggered optimization degradation where training error paradoxically increased with depth.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">用恒等捷径学习残差映射 y=x+F(x)</p><p class=\"cell-val cell-val-en lang-en\">Reformulate layers to learn residual perturbations y = x + F(x) relative to an identity reference.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">identity shortcut 与必要时的 projection shortcut 使百层网络可优化</p><p class=\"cell-val cell-val-en lang-en\">Parameter-free identity shortcuts and 1×1 projection shortcuts enable stable optimization beyond 100+ layers.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">3D ResNet、Residual U-Net 与 nnU-Net ResEnc 的核心结构</p><p class=\"cell-val cell-val-en lang-en\">Foundational building block for 3D ResNet, Residual U-Net, and nnU-Net ResEnc across medical modalities.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">仍是必须精通的强主干和公平对照</p><p class=\"cell-val cell-val-en lang-en\">Mandatory foundational backbone and fair baseline across 2D and 3D biomedical tasks.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">残差块学习相对恒等映射的修正，而不是每层重新构造完整表示。</li><li class=\"lang-zh\">恒等捷径提供不经过权重层的梯度通路，缓解深层优化退化。</li><li class=\"lang-zh\">projection shortcut 只在空间或通道维度变化时匹配张量形状。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Reformulate layers to learn residual perturbations y = x + F(x) relative to an identity reference.</li><li class=\"lang-en bullet-en\">Architectural Delta: Parameter-free identity shortcuts and 1×1 projection shortcuts enable stable optimization beyond 100+ layers.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Additive Residual Branch with Identity Shortcut Mapping.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">3D ResNet、Residual U-Net 与 nnU-Net ResEnc 都复用其块级优化机制。</li><li class=\"lang-zh\">残差捷径解决深层优化，不等同于 U-Net 用于恢复定位信息的长跳连。</li><li class=\"lang-en bullet-en\">Clinical Translation: Foundational building block for 3D ResNet, Residual U-Net, and nnU-Net ResEnc across medical modalities.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Mandatory foundational backbone and fair baseline across 2D and 3D biomedical tasks.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openaccess.thecvf.com/content_cvpr_2016/html/He_Deep_Residual_Learning_CVPR_2016_paper.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Deep Residual Learning for Image Recognition</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/KaimingHe/deep-residual-networks\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
