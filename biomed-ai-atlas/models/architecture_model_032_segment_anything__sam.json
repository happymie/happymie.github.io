-3.260502H1.8766V-3.137327C2.325825-3.115591 2.412771-3.043135 2.412771-2.680857V-.978151C2.412771-.78252 2.376544-.673837 2.289597-.608627C2.086721-.434734 1.862109-.347787 1.637496-.347787C1.35492-.347787 1.123062-.594136 1.123062-.898449V-3.260502H.06521V-3.159064C.412997-3.137327 .514435-3.028644 .514435-2.695348V-.869467C.514435-.297068 .862222 .072456 1.391147 .072456C1.659233 .072456 1.94181-.043473 2.13744-.239103L2.448999-.550663V.050719L2.477981 .06521C2.840259-.079701 3.101099-.159402 3.470623-.26084Z\" id=\"m032_g20-117\"></path><use id=\"m032_g10-185\" transform=\"scale(1.369862)\" xlink:href=\"#m032_g7-185\"></use><use id=\"m032_g10-186\" transform=\"scale(1.369862)\" xlink:href=\"#m032_g7-186\"></use></defs><g id=\"m032_page1\"><use x=\"-68.881703\" xlink:href=\"#m032_g16-70\" y=\"-60.259044\"></use><use x=\"-61.788294\" xlink:href=\"#m032_g13-56\" y=\"-58.764664\"></use><use x=\"-55.901024\" xlink:href=\"#m032_g1-61\" y=\"-60.259044\"></use><use x=\"-46.797456\" xlink:href=\"#m032_g23-77\" y=\"-60.259044\"></use><use x=\"-37.940669\" xlink:href=\"#m032_g23-76\" y=\"-60.259044\"></use><use x=\"-31.853496\" xlink:href=\"#m032_g23-80\" y=\"-60.259044\"></use><use x=\"-25.816136\" xlink:href=\"#m032_g10-185\" y=\"-60.259044\"></use><use x=\"-21.950633\" xlink:href=\"#m032_g16-64\" y=\"-60.259044\"></use><use x=\"-16.570807\" xlink:href=\"#m032_g13-56\" y=\"-58.764664\"></use><use x=\"-13.45087\" xlink:href=\"#m032_g10-186\" y=\"-60.259044\"></use><use x=\"-9.635194\" xlink:href=\"#m032_g16-150\" y=\"-60.259044\"></use><use x=\"18.68521\" xlink:href=\"#m032_g23-94\" y=\"-62.286445\"></use><use x=\"15.048854\" xlink:href=\"#m032_g16-34\" y=\"-60.259044\"></use><use x=\"23.297921\" xlink:href=\"#m032_g13-56\" y=\"-58.764664\"></use><use x=\"26.915989\" xlink:href=\"#m032_g10-185\" y=\"-60.259044\"></use><use x=\"30.602159\" xlink:href=\"#m032_g16-68\" y=\"-60.259044\"></use><use x=\"35.922213\" xlink:href=\"#m032_g10-186\" y=\"-60.259044\"></use><use x=\"42.505221\" xlink:href=\"#m032_g1-61\" y=\"-60.259044\"></use><use x=\"51.738299\" xlink:href=\"#m032_g16-102\" y=\"-60.259044\"></use><use x=\"59.668565\" xlink:href=\"#m032_g4-0\" y=\"-67.853049\"></use><use x=\"62.916375\" xlink:href=\"#m032_g16-70\" y=\"-60.259044\"></use><use x=\"70.009783\" xlink:href=\"#m032_g7-62\" y=\"-64.373604\"></use><use x=\"70.009783\" xlink:href=\"#m032_g13-56\" y=\"-57.534718\"></use><use x=\"75.975018\" xlink:href=\"#m032_g16-27\" y=\"-60.259044\"></use><use x=\"81.623829\" xlink:href=\"#m032_g20-117\" y=\"-58.764664\"></use><use x=\"85.260194\" xlink:href=\"#m032_g20-112\" y=\"-58.764664\"></use><use x=\"89.89281\" xlink:href=\"#m032_g10-185\" y=\"-60.259044\"></use><use x=\"93.57898\" xlink:href=\"#m032_g16-68\" y=\"-60.259044\"></use><use x=\"98.899034\" xlink:href=\"#m032_g10-186\" y=\"-60.259044\"></use><use x=\"102.913967\" xlink:href=\"#m032_g4-1\" y=\"-67.853049\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">传统分割绑定固定数据集和标签集，每换目标需重新训练</p><p class=\"cell-val cell-val-en lang-en\">Traditional segmentation networks were locked to fixed training classes and could not interactively segment arbitrary user-specified targets.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">可复用 ViT image encoder 加点、框、mask prompt encoder 与轻量 mask decoder</p><p class=\"cell-val cell-val-en lang-en\">Amortize heavy image feature extraction once per image, then decode masks in real time (&lt;50 ms) conditioned on flexible spatial prompts.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">promptable mask proposal、候选 mask/IoU 预测与 SA-1B 数据引擎</p><p class=\"cell-val cell-val-en lang-en\">Decoupled ViT-H encoder + positional prompt encoder + 2-layer two-way Transformer decoder + SA-1B 1.1-billion-mask data engine.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">成为医学交互标注和专科适配的重要底座</p><p class=\"cell-val cell-val-en lang-en\">Transformed interactive medical image annotation, semi-automated contour refinement, and specialist adapter development.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">标注基础设施；原版对低对比、小结构、血管和 3D 不可靠</p><p class=\"cell-val cell-val-en lang-en\">Annotation infrastructure; zero-shot SAM struggles on low-contrast boundaries, thin branching vessels, and unprompted 3D volumes.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">把图像编码与提示解码拆开，使昂贵 image embedding 可被交互式多轮提示反复复用。</li><li class=\"lang-zh\">two-way attention 不是单向读取图像，而是让 prompt 与 image tokens 相互条件化。</li><li class=\"lang-zh\">多 mask 输出显式承认单点等提示的固有歧义，并以独立质量头帮助选择。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Amortize heavy image feature extraction once per image, then decode masks in real time (&lt;50 ms) conditioned on flexible spatial prompts.</li><li class=\"lang-en bullet-en\">Architectural Delta: Decoupled ViT-H encoder + positional prompt encoder + 2-layer two-way Transformer decoder + SA-1B 1.1-billion-mask data engine.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Prompt-Conditioned Two-Way Attention &amp; Dynamic Hypernetwork Mask Generation.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">框/点交互可降低逐像素勾画成本，但自然图像预训练在低对比、细长结构和三维连续性上并非天然可靠。</li><li class=\"lang-zh\">临床系统应记录提示类型、交互轮数和失败区域；单一 Dice 不能反映人机交互成本。</li><li class=\"lang-en bullet-en\">Clinical Translation: Transformed interactive medical image annotation, semi-automated contour refinement, and specialist adapter development.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Annotation infrastructure; zero-shot SAM struggles on low-contrast boundaries, thin branching vessels, and unprompted 3D volumes.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openaccess.thecvf.com/content/ICCV2023/html/Kirillov_Segment_Anything_ICCV_2023_paper.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Segment Anything</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/facebookresearch/segment-anything\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}