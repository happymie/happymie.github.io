"-58.321602\" xlink:href=\"#m041_g21-108\" y=\"-54.047368\"></use><use x=\"-56.299784\" xlink:href=\"#m041_g21-105\" y=\"-54.047368\"></use><use x=\"-54.277966\" xlink:href=\"#m041_g21-100\" y=\"-54.047368\"></use><use x=\"-50.641601\" xlink:href=\"#m041_g21-101\" y=\"-54.047368\"></use><use x=\"-47.412506\" xlink:href=\"#m041_g0-45\" y=\"-54.047368\"></use><use x=\"-44.990695\" xlink:href=\"#m041_g21-77\" y=\"-54.047368\"></use><use x=\"-38.525239\" xlink:href=\"#m041_g21-65\" y=\"-54.047368\"></use><use x=\"-33.274326\" xlink:href=\"#m041_g21-69\" y=\"-54.047368\"></use><use x=\"-25.565282\" xlink:href=\"#m041_g2-61\" y=\"-55.541749\"></use><use x=\"-9.288631\" xlink:href=\"#m041_g24-49\" y=\"-62.286445\"></use><rect height=\".557905\" width=\"16.936443\" x=\"-15.2662\" y=\"-58.381092\"></rect><use x=\"-14.867695\" xlink:href=\"#m041_g11-106\" y=\"-48.707392\"></use><use x=\"-12.476663\" xlink:href=\"#m041_g11-77\" y=\"-48.707392\"></use><use x=\"-.720762\" xlink:href=\"#m041_g11-106\" y=\"-48.707392\"></use><use x=\"5.995864\" xlink:href=\"#m041_g5-213\" y=\"-65.736003\"></use><use x=\"4.526156\" xlink:href=\"#m041_g14-56\" y=\"-43.659078\"></use><use x=\"7.584332\" xlink:href=\"#m041_g8-50\" y=\"-43.659078\"></use><use x=\"12.355229\" xlink:href=\"#m041_g8-77\" y=\"-43.659078\"></use><use x=\"22.306525\" xlink:href=\"#m041_g5-13\" y=\"-64.079724\"></use><use x=\"22.306525\" xlink:href=\"#m041_g5-13\" y=\"-58.10214\"></use><use x=\"27.018837\" xlink:href=\"#m041_g17-25\" y=\"-55.541749\"></use><use x=\"35.30776\" xlink:href=\"#m041_g11-185\" y=\"-55.556692\"></use><use x=\"39.023819\" xlink:href=\"#m041_g24-76\" y=\"-55.541749\"></use><use x=\"45.110993\" xlink:href=\"#m041_g24-111\" y=\"-55.541749\"></use><use x=\"50.092313\" xlink:href=\"#m041_g24-110\" y=\"-55.541749\"></use><use x=\"55.073633\" xlink:href=\"#m041_g24-103\" y=\"-55.541749\"></use><use x=\"60.054953\" xlink:href=\"#m041_g24-78\" y=\"-55.541749\"></use><use x=\"67.098532\" xlink:href=\"#m041_g24-101\" y=\"-55.541749\"></use><use x=\"71.521946\" xlink:href=\"#m041_g24-116\" y=\"-55.541749\"></use><use x=\"74.79965\" xlink:href=\"#m041_g11-185\" y=\"-55.541749\"></use><use x=\"78.754816\" xlink:href=\"#m041_g17-73\" y=\"-55.541749\"></use><use x=\"83.365525\" xlink:href=\"#m041_g8-86\" y=\"-54.047368\"></use><use x=\"90.845456\" xlink:href=\"#m041_g17-150\" y=\"-55.541749\"></use><use x=\"95.833362\" xlink:href=\"#m041_g17-63\" y=\"-55.541749\"></use><use x=\"101.649555\" xlink:href=\"#m041_g8-86\" y=\"-54.047368\"></use><use x=\"109.129486\" xlink:href=\"#m041_g11-186\" y=\"-55.541749\"></use><use x=\"112.945161\" xlink:href=\"#m041_g11-186\" y=\"-55.556692\"></use><use x=\"116.760794\" xlink:href=\"#m041_g14-56\" y=\"-53.006274\"></use><use x=\"122.094597\" xlink:href=\"#m041_g11-0\" y=\"-55.541749\"></use><use x=\"130.883804\" xlink:href=\"#m041_g17-73\" y=\"-55.541749\"></use><use x=\"135.058147\" xlink:href=\"#m041_g14-56\" y=\"-54.047368\"></use><use x=\"138.178085\" xlink:href=\"#m041_g5-13\" y=\"-64.079724\"></use><use x=\"138.178085\" xlink:href=\"#m041_g5-13\" y=\"-58.10214\"></use><use x=\"142.521764\" xlink:href=\"#m041_g21-50\" y=\"-61.272456\"></use><use x=\"142.521764\" xlink:href=\"#m041_g21-50\" y=\"-51.760929\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">独立 tile 表示无法捕获病例级、跨区域关系</p><p class=\"cell-val cell-val-en lang-en\">Tile-level encoders treat patches independently, while standard self-attention cannot scale to 40,000+ tiles per gigapixel WSI.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">DINOv2 tile encoder 加 LongNet/MAE slide encoder 建模超长全切片上下文</p><p class=\"cell-val cell-val-en lang-en\">Encode tiles via DINOv2, then model whole-slide spatial dependencies across all tiles using LongNet dilated attention pretrained with MAE.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">在 13 亿 tiles 上预训练并进行 whole-slide long-context aggregation</p><p class=\"cell-val cell-val-en lang-en\">1.3B-tile real-world clinical pretraining (171,189 WSIs) + LongNet linear-scaling dilated slide attention + vision-language report alignment.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">面向病理病例级诊断、分型和预后迁移</p><p class=\"cell-val cell-val-en lang-en\">Targets whole-slide cancer subtyping, mutation/biomarker prediction, and prognostic modeling across health-system cohorts.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">whole-slide 建模是实质变化；跨国家流程仍需验证</p><p class=\"cell-val cell-val-en lang-en\">Represents true whole-slide context pretraining; external multi-institutional calibration remains essential.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">先用 tile encoder 学局部细胞/组织形态，再用独立 slide encoder 学跨 tile 空间关系，分层匹配 WSI 尺度。</li><li class=\"lang-zh\">LongNet 的 dilated attention 以多尺度稀疏连接扩大上下文，使超长 tile 序列无需完整两两注意力。</li><li class=\"lang-zh\">slide-level masked autoencoding 要求从可见区域推断被遮 tile 表征，显式预训练病例级组织上下文。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Encode tiles via DINOv2, then model whole-slide spatial dependencies across all tiles using LongNet dilated attention pretrained with MAE.</li><li class=\"lang-en bullet-en\">Architectural Delta: 1.3B-tile real-world clinical pretraining (171,189 WSIs) + LongNet linear-scaling dilated slide attention + vision-language report alignment.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Masked Tile Embedding Reconstruction Across Tens of Thousands of WSI Coordinates via LongNet.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">whole-slide encoder 能捕捉肿瘤–间质、多个病灶区和空间异质性，这是独立 tile 分类不能提供的。</li><li class=\"lang-zh\">组织采样、坐标编码和超长序列截断均会影响病例结论；外部国家、染色和扫描流程仍需验证。</li><li class=\"lang-en bullet-en\">Clinical Translation: Targets whole-slide cancer subtyping, mutation/biomarker prediction, and prognostic modeling across health-system cohorts.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Represents true whole-slide context pretraining; external multi-institutional calibration remains essential.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://doi.org/10.1038/s41586-024-07441-w\" rel=\"noreferrer\" target=\"_blank\">\n<span>A Whole-Slide Foundation Model for Digital Pathology from Real-World Data</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/prov-gigapath/prov-gigapath\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
