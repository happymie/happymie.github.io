#m126_g13-30\" y=\"-59.987571\"></use><use x=\"133.170238\" xlink:href=\"#m126_g10-53\" y=\"-58.49319\"></use><use x=\"137.708318\" xlink:href=\"#m126_g7-185\" y=\"-59.987571\"></use><use x=\"142.15165\" xlink:href=\"#m126_g13-63\" y=\"-59.987571\"></use><use x=\"147.531476\" xlink:href=\"#m126_g7-186\" y=\"-59.987571\"></use><use x=\"151.347152\" xlink:href=\"#m126_g13-150\" y=\"-59.987571\"></use><use x=\"156.016257\" xlink:href=\"#m126_g13-30\" y=\"-59.987571\"></use><use x=\"159.62871\" xlink:href=\"#m126_g10-60\" y=\"-58.49319\"></use><use x=\"166.62496\" xlink:href=\"#m126_g7-185\" y=\"-59.987571\"></use><use x=\"170.590083\" xlink:href=\"#m126_g13-113\" y=\"-59.987571\"></use><use x=\"176.959705\" xlink:href=\"#m126_g10-92\" y=\"-58.49319\"></use><use x=\"182.235967\" xlink:href=\"#m126_g7-185\" y=\"-59.987571\"></use><use x=\"186.679299\" xlink:href=\"#m126_g13-63\" y=\"-59.987571\"></use><use x=\"192.059125\" xlink:href=\"#m126_g7-186\" y=\"-59.987571\"></use><use x=\"195.874801\" xlink:href=\"#m126_g7-186\" y=\"-59.987571\"></use><use x=\"199.690477\" xlink:href=\"#m126_g7-186\" y=\"-59.987571\"></use><use x=\"205.720018\" xlink:href=\"#m126_g7-184\" y=\"-59.987571\"></use><use x=\"214.140611\" xlink:href=\"#m126_g13-95\" y=\"-59.987571\"></use><use x=\"220.153058\" xlink:href=\"#m126_g7-107\" y=\"-59.987571\"></use><use x=\"224.735873\" xlink:href=\"#m126_g7-114\" y=\"-59.987571\"></use><use x=\"231.699741\" xlink:href=\"#m126_g13-113\" y=\"-59.987571\"></use><use x=\"238.069364\" xlink:href=\"#m126_g10-92\" y=\"-58.49319\"></use><use x=\"243.345625\" xlink:href=\"#m126_g7-185\" y=\"-59.987571\"></use><use x=\"247.788958\" xlink:href=\"#m126_g13-63\" y=\"-59.987571\"></use><use x=\"253.168783\" xlink:href=\"#m126_g7-186\" y=\"-59.987571\"></use><use x=\"257.482593\" xlink:href=\"#m126_g7-107\" y=\"-59.987571\"></use><use x=\"261.965779\" xlink:href=\"#m126_g17-50\" y=\"-64.102131\"></use><use x=\"261.965779\" xlink:href=\"#m126_g17-50\" y=\"-56.961428\"></use><use x=\"266.299526\" xlink:href=\"#m126_g4-3\" y=\"-68.107101\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">离散位移网格受分辨率限制，学习式配准受训练分布约束</p><p class=\"cell-val cell-val-en lang-en\">Discrete voxel-grid registration is tied to grid resolution, relies on finite-difference derivative approximations, and suffers from training-cohort bias.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">以坐标 MLP 连续表示单对图像的位移场，并按相似度逐病例优化</p><p class=\"cell-val cell-val-en lang-en\">Represent the displacement vector field u_θ(x) as a periodic-activation coordinate MLP optimized directly on the test pair via stochastic coordinate sampling.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">连续可微形变表示无需预训练，可在任意坐标查询并正则化</p><p class=\"cell-val cell-val-en lang-en\">Grid-free continuous parameterization + exact analytical Jacobian/hyperelastic/bending-energy derivatives via automatic differentiation.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">用于 MRI/CT 个体化配准和连续形变建模</p><p class=\"cell-val cell-val-en lang-en\">Used for high-precision lung 4D-CT landmark tracking and patient-specific registration without training datasets.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">INR 配准代表；逐病例优化较慢且相似度仍可能歧义</p><p class=\"cell-val cell-val-en lang-en\">Representative implicit neural registration method; per-case optimization takes seconds to minutes rather than milliseconds.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">不在离散 voxel 网格直接存位移，而用坐标 MLP 参数化连续场。</li><li class=\"lang-zh\">每个图像对独立优化网络参数，因此无需训练集或预训练 checkpoint。</li><li class=\"lang-zh\">同一隐式函数可在任意坐标求值，并通过可微插值由图像相似度监督。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Represent the displacement vector field u_θ(x) as a periodic-activation coordinate MLP optimized directly on the test pair via stochastic coordinate sampling.</li><li class=\"lang-en bullet-en\">Architectural Delta: Grid-free continuous parameterization + exact analytical Jacobian/hyperelastic/bending-energy derivatives via automatic differentiation.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Per-Pair Continuous Coordinate MLP Deformation Field Optimization with Analytical Jacobian Regularization.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合个体化 MRI/CT 配准、连续场分析和需要任意分辨率查询的场景。</li><li class=\"lang-zh\">逐病例迭代较慢且可能落入局部最优；连续 MLP 本身不保证 diffeomorphism，需显式拓扑正则。</li><li class=\"lang-en bullet-en\">Clinical Translation: Used for high-precision lung 4D-CT landmark tracking and patient-specific registration without training datasets.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Representative implicit neural registration method; per-case optimization takes seconds to minutes rather than milliseconds.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://2022.midl.io/papers/c2\" rel=\"noreferrer\" target=\"_blank\">\n<span>Implicit Neural Representations for Deformable Image Registration</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/MIAGroupUT/IDIR\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}