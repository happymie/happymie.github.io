577\"></use><use x=\"157.203581\" xlink:href=\"#m059_g13-56\" y=\"-57.322577\"></use><use x=\"160.821647\" xlink:href=\"#m059_g10-185\" y=\"-58.816958\"></use><use x=\"165.740686\" xlink:href=\"#m059_g23-22\" y=\"-58.816958\"></use><use x=\"164.537708\" xlink:href=\"#m059_g16-71\" y=\"-58.816958\"></use><use x=\"170.026108\" xlink:href=\"#m059_g7-185\" y=\"-63.760851\"></use><use x=\"172.811555\" xlink:href=\"#m059_g13-56\" y=\"-63.760851\"></use><use x=\"175.797002\" xlink:href=\"#m059_g7-186\" y=\"-63.760851\"></use><use x=\"169.296363\" xlink:href=\"#m059_g13-67\" y=\"-55.191059\"></use><use x=\"172.53272\" xlink:href=\"#m059_g7-0\" y=\"-55.191059\"></use><use x=\"177.449076\" xlink:href=\"#m059_g20-49\" y=\"-55.191059\"></use><use x=\"184.74938\" xlink:href=\"#m059_g10-106\" y=\"-58.816958\"></use><use x=\"191.110722\" xlink:href=\"#m059_g23-22\" y=\"-58.816958\"></use><use x=\"189.907744\" xlink:href=\"#m059_g16-71\" y=\"-58.816958\"></use><use x=\"195.396144\" xlink:href=\"#m059_g7-185\" y=\"-63.760851\"></use><use x=\"198.181591\" xlink:href=\"#m059_g13-56\" y=\"-63.760851\"></use><use x=\"201.167038\" xlink:href=\"#m059_g7-186\" y=\"-63.760851\"></use><use x=\"194.666399\" xlink:href=\"#m059_g13-67\" y=\"-56.169233\"></use><use x=\"204.668766\" xlink:href=\"#m059_g16-150\" y=\"-58.816958\"></use><use x=\"210.299247\" xlink:href=\"#m059_g23-22\" y=\"-58.816958\"></use><use x=\"209.327905\" xlink:href=\"#m059_g16-72\" y=\"-58.816958\"></use><use x=\"214.711713\" xlink:href=\"#m059_g7-185\" y=\"-62.931518\"></use><use x=\"217.49716\" xlink:href=\"#m059_g13-56\" y=\"-62.931518\"></use><use x=\"220.482607\" xlink:href=\"#m059_g7-186\" y=\"-62.931518\"></use><use x=\"223.984333\" xlink:href=\"#m059_g16-150\" y=\"-58.816958\"></use><use x=\"228.374476\" xlink:href=\"#m059_g16-102\" y=\"-58.816958\"></use><use x=\"234.541355\" xlink:href=\"#m059_g13-56\" y=\"-57.322577\"></use><use x=\"237.661293\" xlink:href=\"#m059_g10-186\" y=\"-58.816958\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">每种线性退化都需重新训练专用模型</p><p class=\"cell-val cell-val-en lang-en\">Supervised restoration required retraining a separate model whenever the degradation operator, blur kernel, or undersampling mask changed.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">利用线性退化算子 A 的 SVD 构造 diffusion restoration posterior</p><p class=\"cell-val cell-val-en lang-en\">Transform the reverse diffusion process into the Singular Value Decomposition (SVD) basis of H, conditioning spectral coefficients directly on observed measurements and noise level.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">将无条件 diffusion prior 与已知线性 forward model 解耦</p><p class=\"cell-val cell-val-en lang-en\">Zero-shot plug-and-play linear inverse solver requiring only 20 DDIM-style steps and zero task-specific retraining.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">同一 prior 可研究 MRI、去模糊、超分辨和部分 CT 线性逆问题</p><p class=\"cell-val cell-val-en lang-en\">Applicable to super-resolution, deblurring, inpainting, and compressed sensing MRI where the forward operator admits tractable spectral decomposition.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">inverse solver 重要节点；大规模 CT 的 SVD 和非线性 likelihood 不便</p><p class=\"cell-val cell-val-en lang-en\">Important zero-shot inverse solver milestone; computing explicit full SVD is intractable for large 3D cone-beam CT or non-linear forward operators.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">在 A 的奇异向量基中，测量约束可按每个 singular direction 与噪声水平解析处理。</li><li class=\"lang-zh\">无条件 diffusion prior 与退化算子解耦，同一 prior 可用于多种线性恢复任务。</li><li class=\"lang-zh\">T 个逆扩散步骤构成恢复迭代，但不是学习优化器式的 stage-by-stage unrolling。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Transform the reverse diffusion process into the Singular Value Decomposition (SVD) basis of H, conditioning spectral coefficients directly on observed measurements and noise level.</li><li class=\"lang-en bullet-en\">Architectural Delta: Zero-shot plug-and-play linear inverse solver requiring only 20 DDIM-style steps and zero task-specific retraining.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Spectral-Space Conditional Reverse Diffusion Along Singular Vectors of Operator H.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合具有可计算 SVD 或快速谱分解的线性 MRI、去模糊和超分辨研究。</li><li class=\"lang-zh\">大规模 CT 显式 SVD 通常不可行，非线性/Poisson 成像也不满足其解析条件化假设。</li><li class=\"lang-en bullet-en\">Clinical Translation: Applicable to super-resolution, deblurring, inpainting, and compressed sensing MRI where the forward operator admits tractable spectral decomposition.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Important zero-shot inverse solver milestone; computing explicit full SVD is intractable for large 3D cone-beam CT or non-linear forward operators.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://papers.nips.cc/paper_files/paper/2022/hash/95504595b6169131b6ed6cd72eb05616-Abstract-Conference.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Denoising Diffusion Restoration Models</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/bahjat-kawar/ddrm\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
