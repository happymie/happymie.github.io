.526804\" y=\"-58.381077\"></rect><use x=\"181.526804\" xlink:href=\"#m057_g20-50\" y=\"-48.707377\"></use><use x=\"187.763409\" xlink:href=\"#m057_g13-54\" y=\"-55.541734\"></use><use x=\"193.546727\" xlink:href=\"#m057_g7-185\" y=\"-55.541734\"></use><use x=\"197.22294\" xlink:href=\"#m057_g13-67\" y=\"-55.541734\"></use><use x=\"200.570382\" xlink:href=\"#m057_g7-186\" y=\"-55.541734\"></use><use x=\"204.386058\" xlink:href=\"#m057_g17-50\" y=\"-59.656294\"></use><use x=\"208.779577\" xlink:href=\"#m057_g13-66\" y=\"-55.541734\"></use><use x=\"213.545212\" xlink:href=\"#m057_g10-92\" y=\"-54.047353\"></use><use x=\"218.821473\" xlink:href=\"#m057_g7-185\" y=\"-55.541734\"></use><use x=\"222.537534\" xlink:href=\"#m057_g13-71\" y=\"-55.541734\"></use><use x=\"227.444116\" xlink:href=\"#m057_g13-150\" y=\"-55.541734\"></use><use x=\"231.664902\" xlink:href=\"#m057_g13-67\" y=\"-55.541734\"></use><use x=\"235.012344\" xlink:href=\"#m057_g7-186\" y=\"-55.541734\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">离散 diffusion 和 score matching 缺少统一连续框架</p><p class=\"cell-val cell-val-en lang-en\">SMLD (score matching) and DDPM (diffusion) were developed as separate discrete heuristics lacking a unified continuous mathematical theory.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">以连续时间 score network 统一 reverse SDE、probability-flow ODE 与采样器</p><p class=\"cell-val cell-val-en lang-en\">Cast forward corruption as a continuous Itô SDE whose reverse-time SDE and deterministic PF-ODE depend solely on the time-dependent score ∇_x log p_t(x).</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">反向 SDE、predictor-corrector 与同边缘分布的确定性 PF-ODE</p><p class=\"cell-val cell-val-en lang-en\">Unified VE/VP/sub-VP SDE taxonomy + Predictor-Corrector (PC) samplers + exact log-likelihood computation + controllable inverse conditional sampling.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">为 MRI/CT posterior sampling 和 likelihood guidance 提供理论接口</p><p class=\"cell-val cell-val-en lang-en\">Provides the rigorous continuous-time mathematical foundation for MRI/CT score-based posterior reconstruction.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">核心数学基础；posterior 与采样仍受 score/likelihood mismatch 影响</p><p class=\"cell-val cell-val-en lang-en\">Foundational mathematical framework; practical medical inverse solving still depends on accurate likelihood score approximations.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">连续时间 SDE 统一了离散 diffusion 与多噪声尺度 score matching。</li><li class=\"lang-zh\">反向 SDE 的随机路径和 PF-ODE 的确定性路径使用同一 score，并具有相同时间边缘分布。</li><li class=\"lang-zh\">predictor-corrector 将数值积分与每尺度 MCMC 校正组合，但质量和计算量均依赖步长策略。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Cast forward corruption as a continuous Itô SDE whose reverse-time SDE and deterministic PF-ODE depend solely on the time-dependent score ∇_x log p_t(x).</li><li class=\"lang-en bullet-en\">Architectural Delta: Unified VE/VP/sub-VP SDE taxonomy + Predictor-Corrector (PC) samplers + exact log-likelihood computation + controllable inverse conditional sampling.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Continuous-Time Forward/Reverse SDE &amp; Marginal-Equivalent Probability-Flow ODE.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">可把测量 likelihood gradient 加入 reverse dynamics，用于 MRI/CT posterior sampling 与不确定性研究。</li><li class=\"lang-zh\">score prior、噪声 SDE 和真实测量 likelihood 任一失配都会使样本不再代表可信后验。</li><li class=\"lang-en bullet-en\">Clinical Translation: Provides the rigorous continuous-time mathematical foundation for MRI/CT score-based posterior reconstruction.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Foundational mathematical framework; practical medical inverse solving still depends on accurate likelihood score approximations.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openreview.net/pdf?id=PxTIG12RRHS\" rel=\"noreferrer\" target=\"_blank\">\n<span>Score-Based Generative Modeling through Stochastic Differential Equations</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/yang-song/score_sde\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
