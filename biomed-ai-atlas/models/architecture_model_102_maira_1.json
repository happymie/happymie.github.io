#m102_g20-117\" y=\"-57.322577\"></use><use x=\"144.804071\" xlink:href=\"#m102_g20-110\" y=\"-57.322577\"></use><use x=\"148.440436\" xlink:href=\"#m102_g20-97\" y=\"-57.322577\"></use><use x=\"152.66575\" xlink:href=\"#m102_g10-185\" y=\"-58.831901\"></use><use x=\"156.222409\" xlink:href=\"#m102_g16-65\" y=\"-58.816958\"></use><use x=\"160.532745\" xlink:href=\"#m102_g13-67\" y=\"-57.322577\"></use><use x=\"167.142149\" xlink:href=\"#m102_g10-106\" y=\"-58.816958\"></use><use x=\"172.141113\" xlink:href=\"#m102_g16-65\" y=\"-58.816958\"></use><use x=\"176.567811\" xlink:href=\"#m102_g13-159\" y=\"-57.322577\"></use><use x=\"181.70963\" xlink:href=\"#m102_g13-67\" y=\"-57.322577\"></use><use x=\"185.153191\" xlink:href=\"#m102_g16-150\" y=\"-58.816958\"></use><use x=\"190.011587\" xlink:href=\"#m102_g10-187\" y=\"-58.816958\"></use><use x=\"193.707711\" xlink:href=\"#m102_g16-69\" y=\"-58.816958\"></use><use x=\"198.579435\" xlink:href=\"#m102_g23-59\" y=\"-58.816958\"></use><use x=\"203.2884\" xlink:href=\"#m102_g16-26\" y=\"-58.816958\"></use><use x=\"209.651536\" xlink:href=\"#m102_g13-41\" y=\"-57.322577\"></use><use x=\"215.745966\" xlink:href=\"#m102_g10-185\" y=\"-58.816958\"></use><use x=\"219.61147\" xlink:href=\"#m102_g16-64\" y=\"-58.816958\"></use><use x=\"224.991295\" xlink:href=\"#m102_g10-186\" y=\"-58.816958\"></use><use x=\"228.806971\" xlink:href=\"#m102_g10-188\" y=\"-58.816958\"></use><use x=\"232.722285\" xlink:href=\"#m102_g10-186\" y=\"-58.831901\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">通用 VLM 报告缺结构化临床表述且易遗漏异常</p><p class=\"cell-val cell-val-en lang-en\">General-purpose VLMs produced stylistically generic reports and frequently omitted subtle thoracic abnormalities.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">将胸片专用视觉编码器与 Vicuna-7B 对齐并针对放射学报告生成完整微调</p><p class=\"cell-val cell-val-en lang-en\">Combine a domain-pretrained chest X-ray self-supervised encoder (RAD-DINO) with full LLM fine-tuning tailored specifically to CXR reporting.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">使用 CXR 专用视觉编码、文本数据增强与完整 LLM fine-tuning 强化胸片叙述</p><p class=\"cell-val cell-val-en lang-en\">Frozen high-resolution RAD-DINO ViT-B/14 (49×49 grid) + 4-layer MLP adapter + text augmentation + RadGraph/radiologist evaluation.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">面向胸片 findings/impression 自动草拟与研究基线</p><p class=\"cell-val cell-val-en lang-en\">Dedicated baseline for automated chest X-ray Findings drafting and clinical factuality evaluation.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">报告生成代表模型；需逐项事实核验和放射科医生复核</p><p class=\"cell-val cell-val-en lang-en\">Representative specialist report generator; lacks explicit spatial bounding-box grounding (addressed in MAIRA-2).</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">用胸片专用 RAD-DINO 代替通用自然图像 encoder。</li><li class=\"lang-zh\">四层 adapter 保留大量视觉 token，再输入 Vicuna-7B。</li><li class=\"lang-zh\">视觉 encoder 冻结，但语言模型针对报告任务完整微调，并用文本改写扩充监督。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Combine a domain-pretrained chest X-ray self-supervised encoder (RAD-DINO) with full LLM fine-tuning tailored specifically to CXR reporting.</li><li class=\"lang-en bullet-en\">Architectural Delta: Frozen high-resolution RAD-DINO ViT-B/14 (49×49 grid) + 4-layer MLP adapter + text augmentation + RadGraph/radiologist evaluation.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Frozen RAD-DINO Patch Tokens Projected via 4-Layer Adapter into Fine-Tuned LLM.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">直接面向胸片 Findings 草拟，可作为研究基线和人工复核候选。</li><li class=\"lang-zh\">仅凭生成文本不能排除漏诊或幻觉；MIMIC-CXR 域外设备、人群和报告风格需独立验证。</li><li class=\"lang-en bullet-en\">Clinical Translation: Dedicated baseline for automated chest X-ray Findings drafting and clinical factuality evaluation.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Representative specialist report generator; lacks explicit spatial bounding-box grounding (addressed in MAIRA-2).</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://arxiv.org/abs/2311.13668\" rel=\"noreferrer\" target=\"_blank\">\n<span>MAIRA-1: A Specialised Large Multimodal Model for Radiology Report Generation</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<span class=\"spec-muted-val\"><span class=\"lang-zh\">未提供官方实现</span><span class=\"lang-en\">No Official Repository</span></span>\n</div>\n</footer>\n</div>"}
