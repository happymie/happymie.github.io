ale(1.369862)\" xlink:href=\"#m007_g20-51\"></use><use id=\"m007_g23-67\" transform=\"scale(1.369862)\" xlink:href=\"#m007_g20-67\"></use><use id=\"m007_g23-68\" transform=\"scale(1.369862)\" xlink:href=\"#m007_g20-68\"></use><use id=\"m007_g23-85\" transform=\"scale(1.369862)\" xlink:href=\"#m007_g20-85\"></use><use id=\"m007_g23-110\" transform=\"scale(1.369862)\" xlink:href=\"#m007_g20-110\"></use><use id=\"m007_g23-111\" transform=\"scale(1.369862)\" xlink:href=\"#m007_g20-111\"></use><use id=\"m007_g23-112\" transform=\"scale(1.369862)\" xlink:href=\"#m007_g20-112\"></use><use id=\"m007_g23-118\" transform=\"scale(1.369862)\" xlink:href=\"#m007_g20-118\"></use></defs><g id=\"m007_page1\"><use x=\"-68.76215\" xlink:href=\"#m007_g16-51\" y=\"-57.444602\"></use><use x=\"-63.570814\" xlink:href=\"#m007_g13-18\" y=\"-55.950221\"></use><use x=\"-56.454456\" xlink:href=\"#m007_g1-61\" y=\"-57.444602\"></use><use x=\"-47.350888\" xlink:href=\"#m007_g23-67\" y=\"-57.444602\"></use><use x=\"-40.705809\" xlink:href=\"#m007_g23-111\" y=\"-57.444602\"></use><use x=\"-35.724489\" xlink:href=\"#m007_g23-110\" y=\"-57.444602\"></use><use x=\"-31.042051\" xlink:href=\"#m007_g23-118\" y=\"-57.444602\"></use><use x=\"-26.060731\" xlink:href=\"#m007_g23-51\" y=\"-57.444602\"></use><use x=\"-21.079411\" xlink:href=\"#m007_g23-68\" y=\"-57.444602\"></use><use x=\"-13.089373\" xlink:href=\"#m007_g4-16\" y=\"-68.453307\"></use><use x=\"-8.745675\" xlink:href=\"#m007_g10-187\" y=\"-57.444602\"></use><use x=\"-3.468857\" xlink:href=\"#m007_g23-85\" y=\"-57.444602\"></use><use x=\"3.425288\" xlink:href=\"#m007_g23-112\" y=\"-57.444602\"></use><use x=\"8.406608\" xlink:href=\"#m007_g23-51\" y=\"-57.444602\"></use><use x=\"13.387929\" xlink:href=\"#m007_g23-68\" y=\"-57.444602\"></use><use x=\"21.07909\" xlink:href=\"#m007_g10-185\" y=\"-57.444602\"></use><use x=\"25.044212\" xlink:href=\"#m007_g16-51\" y=\"-57.444602\"></use><use x=\"30.235549\" xlink:href=\"#m007_g13-18\" y=\"-55.950221\"></use><use x=\"34.086457\" xlink:href=\"#m007_g7-184\" y=\"-55.950221\"></use><use x=\"38.711911\" xlink:href=\"#m007_g20-49\" y=\"-55.950221\"></use><use x=\"42.846378\" xlink:href=\"#m007_g10-186\" y=\"-57.444602\"></use><use x=\"46.662053\" xlink:href=\"#m007_g16-150\" y=\"-57.444602\"></use><use x=\"52.73253\" xlink:href=\"#m007_g16-52\" y=\"-57.444602\"></use><use x=\"57.494669\" xlink:href=\"#m007_g20-51\" y=\"-61.559162\"></use><use x=\"61.349214\" xlink:href=\"#m007_g13-25\" y=\"-61.559162\"></use><use x=\"57.46558\" xlink:href=\"#m007_g13-18\" y=\"-54.316653\"></use><use x=\"69.82409\" xlink:href=\"#m007_g10-188\" y=\"-57.444602\"></use><use x=\"73.938661\" xlink:href=\"#m007_g4-17\" y=\"-68.453307\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">逐切片 2D 网络忽略层间上下文和体结构连续性</p><p class=\"cell-val cell-val-en lang-en\">Slice-by-slice 2D segmentation ignores inter-slice z-axis continuity and 3D anatomical topology.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">把 U-Net 全部算子扩展为 3D，并从稀疏标注切片学习体素级输出</p><p class=\"cell-val cell-val-en lang-en\">Generalize U-Net operators to native 3D volumetric tensors and train with weighted loss on sparsely annotated slices.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">3D 卷积、3D elastic augmentation 与体素级 dense prediction</p><p class=\"cell-val cell-val-en lang-en\">3D convolutions, 3D batch normalization, smooth 3D elastic augmentations, and dense volumetric inference.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">奠定 CT/MRI 体分割母体，支持稀疏体标注</p><p class=\"cell-val cell-val-en lang-en\">Foundational parent of volumetric CT, MRI, and microscopy segmentation pipelines.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">经典 3D 基线；显存、patch context 与各向异性仍是瓶颈</p><p class=\"cell-val cell-val-en lang-en\">Canonical 3D baseline; bounded by GPU activation memory, patch field-of-view, and anisotropic slice spacing.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">所有空间算子原生三维化，显式利用 through-plane continuity。</li><li class=\"lang-zh\">3D long skip 同时传递体边界与局部形状信息。</li><li class=\"lang-zh\">训练目标可只作用于稀疏标注位置，而前向仍输出完整体分割。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Generalize U-Net operators to native 3D volumetric tensors and train with weighted loss on sparsely annotated slices.</li><li class=\"lang-en bullet-en\">Architectural Delta: 3D convolutions, 3D batch normalization, smooth 3D elastic augmentations, and dense volumetric inference.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Volumetric 3D Convolutions, Upsampling, and 3D Skip Concatenation.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合近各向同性 CT/MRI 中形状和连通性关键的器官/病灶任务。</li><li class=\"lang-zh\">显存、patch 截断和各向异性会改变真实物理视野，不能只报告 voxel patch 大小。</li><li class=\"lang-en bullet-en\">Clinical Translation: Foundational parent of volumetric CT, MRI, and microscopy segmentation pipelines.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Canonical 3D baseline; bounded by GPU activation memory, patch field-of-view, and anisotropic slice spacing.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://doi.org/10.1007/978-3-319-46723-8_49\" rel=\"noreferrer\" target=\"_blank\">\n<span>3D U-Net: Learning Dense Volumetric Segmentation from Sparse Annotation</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<span class=\"spec-muted-val\"><span class=\"lang-zh\">未提供官方实现</span><span class=\"lang-en\">No Official Repository</span></span>\n</div>\n</footer>\n</div>"}