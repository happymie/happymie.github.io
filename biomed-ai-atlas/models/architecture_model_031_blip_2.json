13\" xlink:href=\"#m031_g23-115\" y=\"-54.107354\"></use><use x=\"-42.598746\" xlink:href=\"#m031_g23-111\" y=\"-54.107354\"></use><use x=\"-37.617426\" xlink:href=\"#m031_g23-102\" y=\"-54.107354\"></use><use x=\"-34.299865\" xlink:href=\"#m031_g23-116\" y=\"-54.107354\"></use><use x=\"-31.530252\" xlink:href=\"#m031_g23-109\" y=\"-54.107354\"></use><use x=\"-23.77932\" xlink:href=\"#m031_g23-97\" y=\"-54.107354\"></use><use x=\"-19.355905\" xlink:href=\"#m031_g23-120\" y=\"-54.107354\"></use><use x=\"-13.577575\" xlink:href=\"#m031_g4-18\" y=\"-68.167118\"></use><use x=\"-8.008472\" xlink:href=\"#m031_g10-185\" y=\"-61.482058\"></use><use x=\"-4.39204\" xlink:href=\"#m031_g16-38\" y=\"-61.482058\"></use><use x=\"3.020169\" xlink:href=\"#m031_g16-44\" y=\"-61.482058\"></use><use x=\"11.391779\" xlink:href=\"#m031_g13-38\" y=\"-59.987677\"></use><use x=\"18.140804\" xlink:href=\"#m031_g10-186\" y=\"-61.482058\"></use><use x=\"22.454614\" xlink:href=\"#m031_g10-185\" y=\"-61.482058\"></use><use x=\"25.772169\" xlink:href=\"#m031_g16-43\" y=\"-61.482058\"></use><use x=\"32.526838\" xlink:href=\"#m031_g16-44\" y=\"-61.482058\"></use><use x=\"41.007534\" xlink:href=\"#m031_g13-32\" y=\"-59.987677\"></use><use x=\"47.636558\" xlink:href=\"#m031_g10-186\" y=\"-61.482058\"></use><use x=\"51.452234\" xlink:href=\"#m031_g7-62\" y=\"-65.098486\"></use><rect height=\".557905\" width=\"65.635094\" x=\"-8.506606\" y=\"-56.946698\"></rect><use x=\"17.934858\" xlink:href=\"#m031_g10-112\" y=\"-53.609238\"></use><rect height=\".552919\" width=\"5.748432\" x=\"24.938592\" y=\"-54.162157\"></rect><use x=\"25.187655\" xlink:href=\"#m031_g16-51\" y=\"-45.245597\"></use><use x=\"58.523259\" xlink:href=\"#m031_g4-19\" y=\"-68.167118\"></use><use x=\"65.155001\" xlink:href=\"#m031_g10-185\" y=\"-54.107354\"></use><use x=\"68.472556\" xlink:href=\"#m031_g16-43\" y=\"-54.107354\"></use><use x=\"75.227225\" xlink:href=\"#m031_g16-44\" y=\"-54.107354\"></use><use x=\"83.526106\" xlink:href=\"#m031_g13-43\" y=\"-52.612974\"></use><use x=\"89.806053\" xlink:href=\"#m031_g10-186\" y=\"-54.107354\"></use><use x=\"93.621729\" xlink:href=\"#m031_g16-150\" y=\"-54.107354\"></use><use x=\"118.096563\" xlink:href=\"#m031_g16-37\" y=\"-54.107354\"></use><use x=\"124.283356\" xlink:href=\"#m031_g20-76\" y=\"-52.612974\"></use><use x=\"128.726994\" xlink:href=\"#m031_g20-76\" y=\"-52.612974\"></use><use x=\"133.170633\" xlink:href=\"#m031_g20-77\" y=\"-52.612974\"></use><use x=\"142.901541\" xlink:href=\"#m031_g1-61\" y=\"-54.107354\"></use><use x=\"151.746081\" xlink:href=\"#m031_g16-44\" y=\"-54.107354\"></use><use x=\"160.481328\" xlink:href=\"#m031_g13-37\" y=\"-52.612974\"></use><use x=\"166.188918\" xlink:href=\"#m031_g16-38\" y=\"-54.107354\"></use><use x=\"173.89652\" xlink:href=\"#m031_g7-48\" y=\"-58.221914\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">端到端训练大型视觉语言模型成本过高</p><p class=\"cell-val cell-val-en lang-en\">End-to-end joint pretraining of giant vision encoders and multi-billion-parameter LLMs was computationally prohibitive.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">冻结视觉 encoder 与 LLM，只训练 Q-Former 连接视觉查询和语言空间</p><p class=\"cell-val cell-val-en lang-en\">Keep both the vision encoder and LLM frozen, training only a lightweight Q-Former bottleneck to extract language-informative visual features.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">两阶段图文表示与生成训练的轻量 connector</p><p class=\"cell-val cell-val-en lang-en\">Two-stage pretraining: Stage 1 vision–language representation learning (ITC + ITM + ITG) followed by Stage 2 vision-to-LLM generative alignment.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">成为最有影响力的 connector-based 医学 MLLM、VQA 和报告生成模板之一</p><p class=\"cell-val cell-val-en lang-en\">Canonical connector architecture behind medical VQA, report generation, and multimodal LLM assistants.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">架构影响持久；语言先验可能覆盖真实视觉证据</p><p class=\"cell-val cell-val-en lang-en\">Highly influential modular paradigm; strong frozen LLM priors can still hallucinate plausible text detached from visual query tokens.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">Q-Former 用少量 learnable queries 从密集视觉 tokens 中抽取与文本最相关的信息，形成窄接口。</li><li class=\"lang-zh\">视觉 encoder 与 LLM 均冻结，把训练成本和灾难性遗忘集中到轻量跨模态桥。</li><li class=\"lang-zh\">先做视觉语言表征对齐，再做面向 LLM 的生成对齐，分阶段解决模态差异与语言接口差异。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Keep both the vision encoder and LLM frozen, training only a lightweight Q-Former bottleneck to extract language-informative visual features.</li><li class=\"lang-en bullet-en\">Architectural Delta: Two-stage pretraining: Stage 1 vision–language representation learning (ITC + ITM + ITG) followed by Stage 2 vision-to-LLM generative alignment.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Learnable Q-Former Queries Extracting Text-Relevant Visual Tokens for a Frozen LLM.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">可将冻结医学图像主干接入领域 LLM，但固定 query 数可能压缩掉多病灶或三维细节。</li><li class=\"lang-zh\">生成流畅度来自 LLM，不等于影像事实正确；需要定位证据、否定识别和幻觉审计。</li><li class=\"lang-en bullet-en\">Clinical Translation: Canonical connector architecture behind medical VQA, report generation, and multimodal LLM assistants.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Highly influential modular paradigm; strong frozen LLM priors can still hallucinate plausible text detached from visual query tokens.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://proceedings.mlr.press/v202/li23q.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>BLIP-2: Bootstrapping Language-Image Pre-training with Frozen Image Encoders and Large Language Models</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/salesforce/LAVIS\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
