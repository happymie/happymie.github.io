"-60.37359\"></use><use x=\"331.304719\" xlink:href=\"#m136_g7-0\" y=\"-60.37359\"></use><use x=\"340.093926\" xlink:href=\"#m136_g13-73\" y=\"-60.37359\"></use><use x=\"344.304633\" xlink:href=\"#m136_g10-67\" y=\"-58.879209\"></use><use x=\"347.7482\" xlink:href=\"#m136_g7-186\" y=\"-60.37359\"></use><use x=\"354.076618\" xlink:href=\"#m136_g7-12\" y=\"-60.37359\"></use><use x=\"363.284254\" xlink:href=\"#m136_g13-17\" y=\"-60.37359\"></use><use x=\"368.501187\" xlink:href=\"#m136_g10-67\" y=\"-58.879209\"></use><use x=\"371.737543\" xlink:href=\"#m136_g4-0\" y=\"-58.879209\"></use><use x=\"376.653899\" xlink:href=\"#m136_g17-49\" y=\"-58.879209\"></use><use x=\"383.002241\" xlink:href=\"#m136_g7-184\" y=\"-60.37359\"></use><use x=\"391.791448\" xlink:href=\"#m136_g13-73\" y=\"-60.37359\"></use><use x=\"396.002155\" xlink:href=\"#m136_g10-67\" y=\"-58.879209\"></use><use x=\"401.958465\" xlink:href=\"#m136_g7-12\" y=\"-60.37359\"></use><use x=\"412.0179\" xlink:href=\"#m136_g20-126\" y=\"-62.615199\"></use><use x=\"411.166101\" xlink:href=\"#m136_g13-17\" y=\"-60.37359\"></use><use x=\"416.383033\" xlink:href=\"#m136_g10-67\" y=\"-58.879209\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">vanilla RNN 梯度不稳，LSTM 门控和状态较复杂</p><p class=\"cell-val cell-val-en lang-en\">LSTM required three separate gates and dual state vectors, increasing parameter count and overfitting risk on small clinical cohorts.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">以 update/reset gates 控制隐藏状态保留与重置，简化门控循环结构</p><p class=\"cell-val cell-val-en lang-en\">Eliminate the separate cell state and control memory retention versus new candidate overwriting with a single complementary update gate z_t.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">仅用单一隐藏状态和两类门，在保留长依赖能力时减少参数</p><p class=\"cell-val cell-val-en lang-en\">25% fewer parameters than LSTM while retaining additive gradient highways via (1 − z_t) ⊙ h_{t-1}.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">常用于 ECG、EEG、生命体征和纵向临床序列的小数据基线</p><p class=\"cell-val cell-val-en lang-en\">Widely used in compact wearable biosignal monitors, GRU-D missing-value clinical EHR time series, and edge medical devices.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">仍是轻量时序基线；串行计算和超长依赖能力弱于现代并行模型</p><p class=\"cell-val cell-val-en lang-en\">Lightweight recurrent baseline; like LSTM, remains bottlenecked by sequential step-by-step training on ultra-long sequences.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">reset gate 决定计算候选状态时遗忘多少过去。</li><li class=\"lang-zh\">update gate 直接插值旧状态与候选状态，为梯度和长期记忆提供短路径。</li><li class=\"lang-zh\">只有一个隐藏状态和两类门，比 LSTM 少一个 cell state 与一组输出门。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Eliminate the separate cell state and control memory retention versus new candidate overwriting with a single complementary update gate z_t.</li><li class=\"lang-en bullet-en\">Architectural Delta: 25% fewer parameters than LSTM while retaining additive gradient highways via (1 − z_t) ⊙ h_{t-1}.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Coupled Update Gate Interpolation h_t = (1−z_t) ⊙ h_{t-1} + z_t ⊙ h̃_t &amp; Reset Gate.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">是 ECG、EEG、生命体征和纵向病历的小数据时序强基线。</li><li class=\"lang-zh\">长序列逐步递归限制并行，缺失采样和时间间隔若未显式编码会被误当等距观测。</li><li class=\"lang-en bullet-en\">Clinical Translation: Widely used in compact wearable biosignal monitors, GRU-D missing-value clinical EHR time series, and edge medical devices.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Lightweight recurrent baseline; like LSTM, remains bottlenecked by sequential step-by-step training on ultra-long sequences.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://aclanthology.org/D14-1179/\" rel=\"noreferrer\" target=\"_blank\">\n<span>Learning Phrase Representations Using RNN Encoder-Decoder for Statistical Machine Translation</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<span class=\"spec-muted-val\"><span class=\"lang-zh\">未提供官方实现</span><span class=\"lang-en\">No Official Repository</span></span>\n</div>\n</footer>\n</div>"}
