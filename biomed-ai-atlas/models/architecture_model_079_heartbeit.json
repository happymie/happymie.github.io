287\"></use><use x=\"5.438939\" xlink:href=\"#m079_g23-108\" y=\"-58.816958\"></use><use x=\"8.208552\" xlink:href=\"#m079_g23-111\" y=\"-58.816958\"></use><use x=\"13.189872\" xlink:href=\"#m079_g23-103\" y=\"-58.816958\"></use><use x=\"20.558864\" xlink:href=\"#m079_g16-63\" y=\"-58.816958\"></use><use x=\"26.6296\" xlink:href=\"#m079_g13-92\" y=\"-57.322577\"></use><use x=\"32.204738\" xlink:href=\"#m079_g4-0\" y=\"-66.410963\"></use><use x=\"35.472481\" xlink:href=\"#m079_g16-64\" y=\"-58.816958\"></use><use x=\"40.852307\" xlink:href=\"#m079_g13-56\" y=\"-57.322577\"></use><use x=\"47.138082\" xlink:href=\"#m079_g10-106\" y=\"-58.816958\"></use><use x=\"52.704918\" xlink:href=\"#m079_g16-30\" y=\"-58.816958\"></use><use x=\"56.171912\" xlink:href=\"#m079_g7-110\" y=\"-57.186323\"></use><use x=\"59.953735\" xlink:href=\"#m079_g7-77\" y=\"-57.186323\"></use><use x=\"68.94201\" xlink:href=\"#m079_g4-1\" y=\"-66.410963\"></use><use x=\"74.318438\" xlink:href=\"#m079_g16-150\" y=\"-58.816958\"></use><use x=\"88.691155\" xlink:href=\"#m079_g16-64\" y=\"-58.816958\"></use><use x=\"94.07098\" xlink:href=\"#m079_g13-56\" y=\"-57.322577\"></use><use x=\"99.95825\" xlink:href=\"#m079_g1-61\" y=\"-58.816958\"></use><use x=\"108.96219\" xlink:href=\"#m079_g16-38\" y=\"-58.816958\"></use><use x=\"117.131561\" xlink:href=\"#m079_g10-185\" y=\"-58.816958\"></use><use x=\"121.256094\" xlink:href=\"#m079_g16-30\" y=\"-58.816958\"></use><use x=\"124.723088\" xlink:href=\"#m079_g13-56\" y=\"-57.322577\"></use><use x=\"127.843026\" xlink:href=\"#m079_g10-186\" y=\"-58.816958\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">ImageNet 初始化与小型监督模型难覆盖 ECG 形态及标签稀缺</p><p class=\"cell-val cell-val-en lang-en\">Small supervised ECG models overfit single-center cohorts, while natural-image ViT weights did not capture fine QRS/ST-segment morphology.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">把 ECG 渲染为图像并用 BEiT 式 masked image modeling 进行大规模领域预训练</p><p class=\"cell-val cell-val-en lang-en\">Convert clinical 12-lead ECGs into standardized 2D visual plots and pretrain a ViT to reconstruct masked waveform patches via discrete visual tokens.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">在 850 万 ECG、210 万患者上做领域 masked pretraining</p><p class=\"cell-val cell-val-en lang-en\">Large-scale in-domain masked pretraining across 8.5M ECGs from 2.1M patients, directly compatible with printed/scanned paper ECGs.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">提高 ECG 少标签迁移和外部分类表现</p><p class=\"cell-val cell-val-en lang-en\">Improves label-efficient transfer for reduced LVEF screening, hypertrophic cardiomyopathy, and myocardial infarction detection.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">证明领域预训练价值；渲染、截断和缩放可能损失精确采样、幅值及采集元数据，并依赖固定版式</p><p class=\"cell-val cell-val-en lang-en\">Demonstrates the power of scale in ECG SSL; rasterizing 1D voltage time series into 2D pixels discards microvolt resolution and ties the model to a fixed plot layout.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">把 ECG 版面视为二维视觉结构，使 ViT 同时建模单导联形态和跨导联空间关系。</li><li class=\"lang-zh\">BEiT 式 masked image modeling 在无诊断标签的大规模 ECG 上预训练领域表示。</li><li class=\"lang-zh\">预训练单位是渲染图 patch；采样时刻、精确幅值和设备元数据只有在版式保留时才可间接读取。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Convert clinical 12-lead ECGs into standardized 2D visual plots and pretrain a ViT to reconstruct masked waveform patches via discrete visual tokens.</li><li class=\"lang-en bullet-en\">Architectural Delta: Large-scale in-domain masked pretraining across 8.5M ECGs from 2.1M patients, directly compatible with printed/scanned paper ECGs.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Masked Patch Visual Token Prediction Over Rendered 12-Lead ECG Waveform Plots.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合有大量 ECG 图像归档但下游标注有限的分类迁移，并能复用视觉 Transformer 工具链。</li><li class=\"lang-zh\">版式、纸速、增益、裁切和打印噪声改变会形成域移位；不能把图像模型等同于原始波形基础模型。</li><li class=\"lang-en bullet-en\">Clinical Translation: Improves label-efficient transfer for reduced LVEF screening, hypertrophic cardiomyopathy, and myocardial infarction detection.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Demonstrates the power of scale in ECG SSL; rasterizing 1D voltage time series into 2D pixels discards microvolt resolution and ties the model to a fixed plot layout.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://www.nature.com/articles/s41746-023-00840-9\" rel=\"noreferrer\" target=\"_blank\">\n<span>A Foundational Vision Transformer Improves Diagnostic Performance for Electrocardiograms</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<span class=\"spec-muted-val\"><span class=\"lang-zh\">未提供官方实现</span><span class=\"lang-en\">No Official Repository</span></span>\n</div>\n</footer>\n</div>"}
