=\"#m090_g20-82\" y=\"-61.13824\"></use><use x=\"63.525609\" xlink:href=\"#m090_g13-39\" y=\"-59.643859\"></use><use x=\"69.761861\" xlink:href=\"#m090_g10-185\" y=\"-61.13824\"></use><use x=\"73.627365\" xlink:href=\"#m090_g16-32\" y=\"-61.13824\"></use><use x=\"81.029584\" xlink:href=\"#m090_g10-186\" y=\"-61.13824\"></use><use x=\"84.84526\" xlink:href=\"#m090_g7-62\" y=\"-64.754668\"></use><rect height=\".557905\" width=\"50.363551\" x=\"40.157988\" y=\"-57.232886\"></rect><use x=\"58.963687\" xlink:href=\"#m090_g10-112\" y=\"-53.895426\"></use><rect height=\".552919\" width=\"5.748432\" x=\"65.967422\" y=\"-54.448346\"></rect><use x=\"66.216484\" xlink:href=\"#m090_g16-51\" y=\"-45.531786\"></use><use x=\"91.91631\" xlink:href=\"#m090_g4-19\" y=\"-68.453307\"></use><use x=\"98.049917\" xlink:href=\"#m090_g20-83\" y=\"-54.393543\"></use><use x=\"103.589143\" xlink:href=\"#m090_g20-82\" y=\"-54.393543\"></use><use x=\"110.525131\" xlink:href=\"#m090_g13-39\" y=\"-52.899162\"></use><use x=\"116.761383\" xlink:href=\"#m090_g10-185\" y=\"-54.393543\"></use><use x=\"120.078938\" xlink:href=\"#m090_g16-43\" y=\"-54.393543\"></use><use x=\"127.092636\" xlink:href=\"#m090_g10-186\" y=\"-54.393543\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">平坦 ViT 保持固定 token 尺度，密集预测计算高且缺多尺度层级</p><p class=\"cell-val cell-val-en lang-en\">Columnar ViTs output single-scale low-resolution feature maps unsuitable for FPN/U-Net style dense prediction.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">逐级降低 token 分辨率并增加通道，形成 Transformer 金字塔</p><p class=\"cell-val cell-val-en lang-en\">Progressively shrink patch stride across four stages while spatially downsampling Key and Value tensors inside self-attention.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">用 spatial-reduction attention 高效构建可替换 CNN 的层级主干</p><p class=\"cell-val cell-val-en lang-en\">Pyramid token shrinking + Spatial-Reduction Attention (SRA) reducing attention memory and compute on high-resolution grids.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">适配医学检测、分割和高分辨率病理特征金字塔</p><p class=\"cell-val cell-val-en lang-en\">Frequently used as a drop-in hierarchical Transformer encoder for polyp, skin lesion, and ultrasound segmentation.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">奠定层级视觉 Transformer；后续 Swin、MiT 等结构更常用</p><p class=\"cell-val cell-val-en lang-en\">Pioneered pyramid Vision Transformers; often succeeded by Swin or SegFormer (MiT) in recent pipelines.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">通过 stage-wise token 下采样建立与 CNN 类似的分辨率金字塔，适配检测和分割。</li><li class=\"lang-zh\">SRA 仅压缩 K/V 的空间长度，显著降低高分辨率 self-attention 计算。</li><li class=\"lang-zh\">PVT-v1 仍使用位置编码和非重叠 patch embedding；不应把后续 PVTv2 的 overlap/卷积 FFN 混入。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Progressively shrink patch stride across four stages while spatially downsampling Key and Value tensors inside self-attention.</li><li class=\"lang-en bullet-en\">Architectural Delta: Pyramid token shrinking + Spatial-Reduction Attention (SRA) reducing attention memory and compute on high-resolution grids.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Spatial-Reduction Attention (SRA) for Multi-Scale Pyramid Tokens.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">适合高分辨病理、内镜和 2D 医学检测/分割中需要多尺度特征的任务。</li><li class=\"lang-zh\">小病灶可能在早期 patch 化或 SRA 中受损；3D 扩展还需重新设计 token 长度与内存。</li><li class=\"lang-en bullet-en\">Clinical Translation: Frequently used as a drop-in hierarchical Transformer encoder for polyp, skin lesion, and ultrasound segmentation.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Pioneered pyramid Vision Transformers; often succeeded by Swin or SegFormer (MiT) in recent pipelines.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openaccess.thecvf.com/content/ICCV2021/html/Wang_Pyramid_Vision_Transformer_A_Versatile_Backbone_for_Dense_Prediction_Without_ICCV_2021_paper.html\" rel=\"noreferrer\" target=\"_blank\">\n<span>Pyramid Vision Transformer: A Versatile Backbone for Dense Prediction without Convolutions</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/whai362/PVT\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
