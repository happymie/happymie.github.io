212H.615376V-3.275389H5.697191ZM5.697191-1.260528V-1.816352H.615376V-1.260528H5.697191Z\" id=\"m021_g1-61\"></path><path d=\"M2.828745-2.878372H.615376V-2.223294H2.828745V0H3.483822V-2.223294H5.697191V-2.878372H3.483822V-5.101666H2.828745V-2.878372Z\" id=\"m021_g4-184\"></path><path d=\"M2.967701 1.667471H2.114114C1.786576 1.667471 1.627769 1.498738 1.627769 1.151349V-6.332418C1.627769-6.640106 1.756799-6.769136 2.074413-6.769136H2.967701V-7.017272H.873437V1.915606H2.967701V1.667471Z\" id=\"m021_g4-187\"></path><path d=\"M.337464 1.667471V1.915606H2.431728V-7.017272H.337464V-6.769136H1.19105C1.518589-6.769136 1.677396-6.600404 1.677396-6.253014V1.230752C1.677396 1.53844 1.53844 1.667471 1.230752 1.667471H.337464Z\" id=\"m021_g4-188\"></path></defs><g id=\"m021_page1\"><use x=\"-68.772107\" xlink:href=\"#m021_g10-73\" y=\"-59.987571\"></use><use x=\"-64.597764\" xlink:href=\"#m021_g14-48\" y=\"-58.49319\"></use><use x=\"-57.695942\" xlink:href=\"#m021_g1-61\" y=\"-59.987571\"></use><use x=\"-47.994611\" xlink:href=\"#m021_g4-187\" y=\"-59.987571\"></use><use x=\"-42.717793\" xlink:href=\"#m021_g10-71\" y=\"-59.987571\"></use><use x=\"-37.995502\" xlink:href=\"#m021_g14-99\" y=\"-58.49319\"></use><use x=\"-34.766408\" xlink:href=\"#m021_g14-108\" y=\"-58.49319\"></use><use x=\"-32.74459\" xlink:href=\"#m021_g14-115\" y=\"-58.49319\"></use><use x=\"-29.417395\" xlink:href=\"#m021_g17-59\" y=\"-59.987571\"></use><use x=\"-23.326983\" xlink:href=\"#m021_g10-71\" y=\"-59.987571\"></use><use x=\"-18.420401\" xlink:href=\"#m021_g14-49\" y=\"-64.102131\"></use><use x=\"-17.841059\" xlink:href=\"#m021_g7-63\" y=\"-57.526813\"></use><use x=\"-12.623991\" xlink:href=\"#m021_g10-26\" y=\"-59.987571\"></use><use x=\"-5.699967\" xlink:href=\"#m021_g17-59\" y=\"-59.987571\"></use><use x=\".549845\" xlink:href=\"#m021_g10-149\" y=\"-59.987571\"></use><use x=\"5.029671\" xlink:href=\"#m021_g10-149\" y=\"-59.987571\"></use><use x=\"9.509498\" xlink:href=\"#m021_g10-149\" y=\"-59.987571\"></use><use x=\"13.829884\" xlink:href=\"#m021_g17-59\" y=\"-59.987571\"></use><use x=\"19.920296\" xlink:href=\"#m021_g10-71\" y=\"-59.987571\"></use><use x=\"25.335967\" xlink:href=\"#m021_g7-35\" y=\"-64.102131\"></use><use x=\"25.40622\" xlink:href=\"#m021_g7-63\" y=\"-57.526813\"></use><use x=\"32.469407\" xlink:href=\"#m021_g10-26\" y=\"-59.987571\"></use><use x=\"41.053831\" xlink:href=\"#m021_g4-188\" y=\"-59.987571\"></use><use x=\"47.183011\" xlink:href=\"#m021_g4-184\" y=\"-59.987571\"></use><use x=\"56.012066\" xlink:href=\"#m021_g10-26\" y=\"-59.987571\"></use><use x=\"62.44793\" xlink:href=\"#m021_g14-112\" y=\"-58.49319\"></use><use x=\"66.084295\" xlink:href=\"#m021_g14-111\" y=\"-58.49319\"></use><use x=\"69.72066\" xlink:href=\"#m021_g14-115\" y=\"-58.49319\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">Transformer 缺少二维图像输入接口，视觉模型长期依赖卷积</p><p class=\"cell-val cell-val-en lang-en\">Standard Transformers could not directly ingest pixel grids due to quadratic cost, leaving computer vision reliant on CNNs.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">把图像切成 patch token 并使用标准 Transformer encoder</p><p class=\"cell-val cell-val-en lang-en\">Treat non-overlapping 16×16 image patches as sequence tokens and apply a standard isotropic Transformer encoder.</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">patch embedding、位置编码和 class token 形成可扩展视觉编码器</p><p class=\"cell-val cell-val-en lang-en\">Linear patchify stem, learnable 1D positional embeddings, and global self-attention from the very first layer.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">成为医学 foundation encoder 主流，但 3D 和小病灶需更细致 token 化</p><p class=\"cell-val cell-val-en lang-en\">Dominant backbone for large-scale self-supervised pathology (UNI, Virchow) and multimodal medical foundation models.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">大规模预训练时强；小数据从头训练不一定优于 CNN</p><p class=\"cell-val cell-val-en lang-en\">Excels under massive pretraining (MAE, DINOv2, CLIP); underperforms CNNs when trained from scratch on small medical cohorts.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">把固定大小图像块直接视为 token，使纯 Transformer 可在视觉任务中工作。</li><li class=\"lang-zh\">全局 self-attention 从第一层起建立任意远 patch 间的内容依赖，而不依赖卷积感受野递增。</li><li class=\"lang-zh\">CLS token 通过多层注意力汇聚整幅图像，预训练规模与正则化决定其数据效率。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Treat non-overlapping 16×16 image patches as sequence tokens and apply a standard isotropic Transformer encoder.</li><li class=\"lang-en bullet-en\">Architectural Delta: Linear patchify stem, learnable 1D positional embeddings, and global self-attention from the very first layer.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Non-Overlapping Patch Tokenization &amp; Global Self-Attention Encoding.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">病理切片 patch、眼底图和二维放射影像可直接 token 化，但小病灶可能在粗 patch 中被平均。</li><li class=\"lang-zh\">医学小数据场景通常需要自然图像或领域自监督预训练，且高分辨率会使全局注意力显存按 N² 增长。</li><li class=\"lang-en bullet-en\">Clinical Translation: Dominant backbone for large-scale self-supervised pathology (UNI, Virchow) and multimodal medical foundation models.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Excels under massive pretraining (MAE, DINOv2, CLIP); underperforms CNNs when trained from scratch on small medical cohorts.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openreview.net/pdf?id=YicbFdNTTy\" rel=\"noreferrer\" target=\"_blank\">\n<span>An Image Is Worth 16x16 Words: Transformers for Image Recognition at Scale</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<a class=\"spec-ext-link\" href=\"https://github.com/google-research/vision_transformer\" rel=\"noreferrer\" target=\"_blank\"><span>作者/机构官方实现</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg></a>\n</div>\n</footer>\n</div>"}
