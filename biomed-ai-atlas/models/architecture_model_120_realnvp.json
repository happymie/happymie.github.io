29\" xlink:href=\"#m120_g10-185\" y=\"-58.816958\"></use><use x=\"63.075889\" xlink:href=\"#m120_g19-71\" y=\"-58.816958\"></use><use x=\"68.052725\" xlink:href=\"#m120_g16-48\" y=\"-57.322577\"></use><use x=\"72.914477\" xlink:href=\"#m120_g10-186\" y=\"-58.816958\"></use><use x=\"76.730153\" xlink:href=\"#m120_g19-150\" y=\"-58.816958\"></use><use x=\"90.953427\" xlink:href=\"#m120_g23-108\" y=\"-58.816958\"></use><use x=\"93.72304\" xlink:href=\"#m120_g23-111\" y=\"-58.816958\"></use><use x=\"98.70436\" xlink:href=\"#m120_g23-103\" y=\"-58.816958\"></use><use x=\"106.073351\" xlink:href=\"#m120_g19-63\" y=\"-58.816958\"></use><use x=\"111.707721\" xlink:href=\"#m120_g16-45\" y=\"-57.322577\"></use><use x=\"118.002152\" xlink:href=\"#m120_g10-185\" y=\"-58.816958\"></use><use x=\"121.718213\" xlink:href=\"#m120_g19-71\" y=\"-58.816958\"></use><use x=\"126.624795\" xlink:href=\"#m120_g10-186\" y=\"-58.816958\"></use><use x=\"133.207803\" xlink:href=\"#m120_g1-61\" y=\"-58.816958\"></use><use x=\"142.311372\" xlink:href=\"#m120_g23-108\" y=\"-58.816958\"></use><use x=\"145.080984\" xlink:href=\"#m120_g23-111\" y=\"-58.816958\"></use><use x=\"150.062305\" xlink:href=\"#m120_g23-103\" y=\"-58.816958\"></use><use x=\"157.431296\" xlink:href=\"#m120_g19-63\" y=\"-58.816958\"></use><use x=\"163.138395\" xlink:href=\"#m120_g16-47\" y=\"-57.322577\"></use><use x=\"169.39646\" xlink:href=\"#m120_g10-185\" y=\"-58.816958\"></use><use x=\"173.511025\" xlink:href=\"#m120_g19-72\" y=\"-58.816958\"></use><use x=\"178.313016\" xlink:href=\"#m120_g10-186\" y=\"-58.816958\"></use><use x=\"184.342557\" xlink:href=\"#m120_g10-184\" y=\"-58.816958\"></use><use x=\"192.892659\" xlink:href=\"#m120_g4-213\" y=\"-69.011212\"></use><use x=\"198.650225\" xlink:href=\"#m120_g16-57\" y=\"-47.47246\"></use><use x=\"207.992656\" xlink:href=\"#m120_g19-66\" y=\"-58.816958\"></use><use x=\"213.158287\" xlink:href=\"#m120_g16-57\" y=\"-57.322577\"></use><use x=\"216.910913\" xlink:href=\"#m120_g10-185\" y=\"-58.816958\"></use><use x=\"220.626974\" xlink:href=\"#m120_g19-71\" y=\"-58.816958\"></use><use x=\"225.603809\" xlink:href=\"#m120_g16-48\" y=\"-57.322577\"></use><use x=\"230.465561\" xlink:href=\"#m120_g10-186\" y=\"-58.816958\"></use></g></svg>\n</div>\n</section>\n<!-- 5-Column Swiss Specification Matrix -->\n<div class=\"spec-evo-matrix\">\n<div class=\"spec-matrix-cell spec-cell-bottleneck\"><div class=\"cell-kicker\">01 // PRIOR LIMITATION</div><div class=\"cell-zh-label lang-zh\">上一代瓶颈</div><p class=\"cell-val lang-zh\">一般生成网络缺精确似然，早期 flow 的可扩展性和可逆设计有限</p><p class=\"cell-val cell-val-en lang-en\">GANs and VAEs lacked exact tractable likelihood evaluation, while autoregressive density models were slow to sample.</p></div><div class=\"spec-matrix-cell spec-cell-idea\"><div class=\"cell-kicker\">02 // CORE HYPOTHESIS</div><div class=\"cell-zh-label lang-zh\">核心想法</div><p class=\"cell-val lang-zh\">用仿射 coupling layers 构造可逆网络并精确计算 log-determinant</p><p class=\"cell-val cell-val-en lang-en\">Split dimensions in each coupling layer so half remain unchanged while scaling and translating the other half via unconstrained neural networks s(·), t(·).</p></div><div class=\"spec-matrix-cell spec-cell-improvement\"><div class=\"cell-kicker\">03 // ARCHITECTURAL DELTA</div><div class=\"cell-zh-label lang-zh\">关键改进</div><p class=\"cell-val lang-zh\">通过三角 Jacobian 实现高效双向变换、采样与精确密度估计</p><p class=\"cell-val cell-val-en lang-en\">Triangular Jacobian with closed-form sum-of-logs determinant + exact single-pass forward density estimation and inverse sampling.</p></div><div class=\"spec-matrix-cell spec-cell-adaptation\"><div class=\"cell-kicker\">04 // MEDICAL TRANSLATION</div><div class=\"cell-zh-label lang-zh\">医学适配</div><p class=\"cell-val lang-zh\">用于医学图像生成、异常检测和可逆重建先验</p><p class=\"cell-val cell-val-en lang-en\">Applied to invertible medical image priors, exact-likelihood out-of-distribution detection, and bijective registration.</p></div><div class=\"spec-matrix-cell spec-cell-evidence\"><div class=\"cell-kicker\">05 // EVIDENCE &amp; BOUNDARY</div><div class=\"cell-zh-label lang-zh\">适用范围与证据</div><p class=\"cell-val lang-zh\">normalizing flow 基础；coupling 表达受限且高维似然未必对应临床异常</p><p class=\"cell-val cell-val-en lang-en\">Foundational normalizing flow; coupling layers require deep stacking for expressivity and raw pixel likelihoods often mis-score semantic OOD anomalies.</p></div>\n</div>\n<!-- 2-Column Design Principles & Medical Translation Band -->\n<div class=\"spec-dual-band\">\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">ARCHITECTURAL AXIOMS // 设计原理与数学机制</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">coupling 层只变换一半变量，使逆映射有闭式表达。</li><li class=\"lang-zh\">三角 Jacobian 将行列式化为缩放项之和，可做精确最大似然。</li><li class=\"lang-zh\">交替划分和多尺度 split 让所有维度逐步混合并控制计算。</li><li class=\"lang-en bullet-en\">Core Hypothesis: Split dimensions in each coupling layer so half remain unchanged while scaling and translating the other half via unconstrained neural networks s(·), t(·).</li><li class=\"lang-en bullet-en\">Architectural Delta: Triangular Jacobian with closed-form sum-of-logs determinant + exact single-pass forward density estimation and inverse sampling.</li><li class=\"lang-en bullet-en\">Mathematical Formalism: Bijective Affine Coupling Layer &amp; Change-of-Variables Exact Log-Likelihood.</li></ul>\n</section>\n<section class=\"spec-dual-col\">\n<div class=\"cell-kicker\">CLINICAL TRANSLATION &amp; BOUNDARIES // 医学应用与安全边界</div>\n<ul class=\"spec-bullet-list\"><li class=\"lang-zh\">可作为医学图像精确密度估计、生成和可逆重建先验的基础。</li><li class=\"lang-zh\">高 likelihood 不等同于病理异常检测可靠，flow 可能更敏感于低级纹理和扫描域而非疾病语义。</li><li class=\"lang-en bullet-en\">Clinical Translation: Applied to invertible medical image priors, exact-likelihood out-of-distribution detection, and bijective registration.</li><li class=\"lang-en bullet-en\">Evidence &amp; Safety Boundary: Foundational normalizing flow; coupling layers require deep stacking for expressivity and raw pixel likelihoods often mis-score semantic OOD anomalies.</li></ul>\n</section>\n</div>\n<!-- Provenance Footer Bar -->\n<footer class=\"spec-footer-bar\">\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">PRIMARY LITERATURE // 原始文献</span>\n<a class=\"spec-ext-link\" href=\"https://openreview.net/pdf?id=HkpbnH9lx\" rel=\"noreferrer\" target=\"_blank\">\n<span>Density Estimation Using Real NVP</span><svg class=\"ui-icon-xs\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\"><path d=\"M7 17L17 7M9 7h8v8\"></path></svg>\n</a>\n</div>\n<div class=\"spec-footer-cell\">\n<span class=\"footer-kicker\">OFFICIAL IMPLEMENTATION // 开源代码</span>\n<span class=\"spec-muted-val\"><span class=\"lang-zh\">未提供官方实现</span><span class=\"lang-en\">No Official Repository</span></span>\n</div>\n</footer>\n</div>"}
